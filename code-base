        out.matched++;
      } else {
        out.ambiguous++;
        if(out.examples.ambiguous.length < 50) out.examples.ambiguous.push({blst: nm, candidates: cands.slice(0,10)});
        out.matched++;
      }
    }

    // CSV -> BLST unmatched checks (based on variants)
    for(const rec of csvRecs){
      const nm = String(rec.hole||'').trim();
      if(!nm) continue;
      let found = false;
      for(const v of holeKeyVariants(nm)){
        if(blstVarIndex[v] && blstVarIndex[v].length){
          found = true; break;
        }
      }
      if(!found){
        out.csvUnmatchedInBlst++;
        if(out.examples.csvUnmatchedInBlst.length < 50) out.examples.csvUnmatchedInBlst.push(nm);
      }
