  );
  const limit = getLongHoleSiteLimit(selectedSite, diameter);

  return Number.isFinite(diameter) && Number.isFinite(limit) && Number.isFinite(length) && length > limit;
}

function getHoleChargeName(hole){
  if(!hole) return '';

  const isExcludedCharge = (value)=>/\b(?:ntbc|hrdc)\b/i.test(String(value || ''));
  const holeName = String((hole.hole ?? hole.name ?? hole.id ?? '') || '').trim();
  const direct =
    hole['Charge Name'] ??
    hole.ChargeName ??
    hole.chargeName ??
    hole.chargeRuleName ??
    hole.chargeRule;
  const directText = (direct != null) ? String(direct).trim() : '';
  if(isExcludedCharge(directText)) return directText;

  const nodeId = Number(hole.nodeId);
  if(Number.isFinite(nodeId) && window.csvAssignmentByNodeId && window.csvAssignmentByNodeId.has(nodeId)){
    const assigned = window.csvAssignmentByNodeId.get(nodeId);
    const csvCharge = assigned && assigned.rec ? String(assigned.rec.chargeName || '').trim() : '';
    if(isExcludedCharge(csvCharge)) return csvCharge;
  }

  if(holeName && window.csvDet && window.csvDet.canonicalList){
    const canonicalKey = holeKeyVariants(holeName)[0];
    const recs = window.csvDet.canonicalList[canonicalKey] || [];
    for(const rec of recs){
      if(String((rec && rec.hole) || '').trim().toLowerCase() !== holeName.toLowerCase()) continue;
      const csvCharge = String((rec && rec.chargeName) || '').trim();
      if(isExcludedCharge(csvCharge)) return csvCharge;
    }
  }

  if(directText !== '') return directText;

  if(Array.isArray(window.pts)){
    const match = Number.isFinite(nodeId)
      ? window.pts.find(p => Number(p.nodeId) === nodeId)
      : null;
    if(match && match.chargeRule) return String(match.chargeRule);
  }

  return '';
}

function includeExcludedShortHoles(){
  const el = document.getElementById('chkIncludeExcludedShortHoles');
  return !!(el && el.checked);
}

function getShortHoleCheckResult(hole, selectedSite){
  const diameter = parseNumber(
    hole && (hole.diameter_mm ?? hole.diameter ?? hole['Diameter (mm)'] ?? hole.Diameter)
  );
  const length = parseNumber(
    hole && (hole.length_m ?? hole.length ?? hole['Length (m)'] ?? hole.Length)
  );
  const limit = getShortHoleSiteLimit(selectedSite, diameter);
  const comparable = Number.isFinite(diameter) && Number.isFinite(limit) && Number.isFinite(length);
  if(!comparable || !selectedSite){
    return {isShort:false, excludedByCharge:false, diameter, length, limit};
  }

  const underLimit = length < limit;
  if(!underLimit){
    return {isShort:false, excludedByCharge:false, diameter, length, limit};
  }

  const chargeName = getHoleChargeName(hole);
  const excludedByCharge = !includeExcludedShortHoles() && /ntbc|hrdc/i.test(chargeName);
  return {
    isShort: !excludedByCharge,
    excludedByCharge,
    diameter,
    length,
    limit
  };
}

function isShortHoleHighlight(hole, selectedSite){
  return getShortHoleCheckResult(hole, selectedSite).isShort;
}

