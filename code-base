function attachDropBox(dropEl, inputEl, nameEl, extsLabel){
  if(!dropEl || !inputEl || !nameEl){
    console.error(`attachDropBox: Missing elements - dropEl: ${!!dropEl}, inputEl: ${!!inputEl}, nameEl: ${!!nameEl}`);
    return;
  }
  
  console.log(`attachDropBox initialized for ${extsLabel}`, {dropEl, inputEl, nameEl});
  try{ document.getElementById('uploadStatus').textContent = `Upload status: init ${extsLabel}`; }catch(e){}
  
  function setName(f){
    if(!f){ nameEl.textContent = `Drop ${extsLabel} here or click to choose`; return; }
    nameEl.textContent = f.name;
    console.log(`File selected: ${f.name}`);
  }
  
  // Click to open file dialog
  dropEl.addEventListener('click', ()=>{
    console.log(`Click event on dropBox for ${extsLabel}`);
    inputEl.click();
  });
  
  // Keyboard accessible
  dropEl.addEventListener('keydown', (e)=>{
    if(e.key==='Enter' || e.key===' '){
      console.log(`Keyboard event (${e.key}) on dropBox for ${extsLabel}`);
      e.preventDefault();
      inputEl.click();
    }
  });
  
  // File input change (from click or programmatic)
  inputEl.addEventListener('change', ()=>{
    console.log(`Change event on input for ${extsLabel}, files:`, inputEl.files);
    try{ document.getElementById('uploadStatus').textContent = `Upload status: selected ${extsLabel} (${(inputEl.files&&inputEl.files[0]&&inputEl.files[0].name)||'no file'})`; }catch(e){}
    // If the input has files use them; otherwise fall back to any stored fallback file
    let f = (inputEl.files && inputEl.files[0]) || (window.fallbackFiles && window.fallbackFiles[inputEl.id]);
    if(f){
      window.fallbackFiles = window.fallbackFiles || {};
      window.fallbackFiles[inputEl.id] = f;
    }
    if(!f) console.log(`No File in input and no fallback for ${inputEl.id}`);
    setName(f);
    if(inputEl.id==='fileCsv'){ window.csvTimes=null; window.csvTimesMeta=null; }
    disarmSummaryChecks();
  });
  
  // Drag enter/over - show drop zone highlight.
  // Use a counter so child-element dragleave events do not remove the highlight prematurely.
  let dragCounter = 0;
  dropEl.addEventListener('dragenter', (e)=>{
    console.log(`dragenter event on ${extsLabel}`);
    e.preventDefault();
    e.stopPropagation();
    dragCounter += 1;
    dropEl.classList.add('drag');
    try{ document.getElementById('uploadStatus').textContent = `Upload status: dragging over ${extsLabel}`; }catch(e){}
  });
  
  dropEl.addEventListener('dragover', (e)=>{
    console.log(`dragover event on ${extsLabel}`);
    e.preventDefault();
    e.stopPropagation();
    e.dataTransfer.dropEffect = 'copy';
    try{ document.getElementById('uploadStatus').textContent = `Upload status: dragover ${extsLabel}`; }catch(e){}
  });
  
  // Drag leave - only remove highlight once all entered targets have left.
  dropEl.addEventListener('dragleave', (e)=>{
    console.log(`dragleave event on ${extsLabel}`);
    e.preventDefault();
    e.stopPropagation();
    dragCounter -= 1;
    if(dragCounter <= 0){
      dragCounter = 0;
      dropEl.classList.remove('drag');
      try{ document.getElementById('uploadStatus').textContent = `Upload status: drag leave ${extsLabel}`; }catch(e){}
    }
  });
  
  // Drop - handle files
  dropEl.addEventListener('drop', (e)=>{
    console.log(`drop event on ${extsLabel}`);
    e.preventDefault();
    e.stopPropagation();
    dropEl.classList.remove('drag');
    
    const files = e.dataTransfer && e.dataTransfer.files;
    console.log(`Files in dataTransfer:`, files ? files.length : 'none');
    if(!files || !files.length){
      console.warn(`No files in drop event for ${extsLabel}`);
      return;
    }
    
    const f = files[0];
    console.log(`Processing file: ${f.name} (${f.type}, ${f.size} bytes)`);
      try{ document.getElementById('uploadStatus').textContent = `Upload status: dropped ${f.name} into ${extsLabel}`; }catch(e){}
    
    // Use DataTransfer API to properly assign files if available; otherwise fall back to storing reference
    try {
      const dt = new DataTransfer();
      for(let i=0; i<files.length; i++) {
        dt.items.add(files[i]);
      }
      inputEl.files = dt.files;
      console.log(`Successfully assigned files via DataTransfer`);
        try{ document.getElementById('uploadStatus').textContent = `Upload status: assigned files via DataTransfer for ${extsLabel}`; }catch(e){}
    } catch(err) {
      console.warn('DataTransfer assignment failed; using fallbackFiles map', err);
        try{ document.getElementById('uploadStatus').textContent = `Upload status: fallback assigned for ${extsLabel}`; }catch(e){}
      window.fallbackFiles = window.fallbackFiles || {};
      try{
        window.fallbackFiles[inputEl.id] = files[0];
        console.log(`Stored fallback file for ${inputEl.id}:`, files[0] && files[0].name);
      }catch(e){ console.error('Could not store fallbackFiles:', e); }
      // continue — we'll still call setName and dispatch change so UI updates
    }
    
    setName(f);
    // Trigger change event so handlers know files were updated
    console.log(`Dispatching change event for ${extsLabel}`);
    inputEl.dispatchEvent(new Event('change', { bubbles: true }));
    if(inputEl.id==='fileCsv'){ window.csvTimes=null; window.csvTimesMeta=null; }
  });
  
  setName(null);
  console.log(`attachDropBox setup complete for ${extsLabel}`);
}


function parseDetonationCsv(text){
  const aoa = parseCSV(text);
  const out = {
    byHole: {},            // variantKey -> first record
    byVariantList: {},     // variantKey -> [records...]
    canonical: {},         // canonicalKey -> first record
    canonicalList: {},     // canonicalKey -> [records...]
    csvHolesMerged: [],    // one merged record per canonical hole
    variantHoles: {},      // variantKey -> [hole strings...]
    csvHoles: [],          // all records, including duplicates
    duplicates: {
      repeatedHoleRows: [],
      variantCollisions: []
    },
    meta: {rows:0, hasHeader:false, applied:0, missing:0, mode:'', cols:{}}
  };
  if(!aoa || !aoa.length) return out;

  // Detect header: any cell with alpha characters or known header keywords.
  const first = (aoa[0]||[]).map(v=>String(v != null ? v : '').trim());
  const firstLow = first.map(s=>s.toLowerCase());

  const headerKeywords = ['hole','time','deton','firing','easting','northing','diameter','diam','x','y','east','north','branch'];
  const hasAlpha = firstLow.some(s=>/[a-z]/.test(s));
  const hasKey = firstLow.some(s=>headerKeywords.some(k=>s.includes(k)));
  const hasHeader = hasAlpha && hasKey;

  // Normalise header tokens for matching
  const norm = (s)=>String(s != null ? s : '').toLowerCase().trim()
    .replace(/\(.*?\)/g,'')
    .replace(/[^a-z0-9]+/g,'')
    .trim();

  const isDetonationTimeMsHeader = (rawHeader)=>{
    const text = String(rawHeader != null ? rawHeader : '').toLowerCase().replace(/\s+/g, ' ').trim();
    return text.includes('detonation time (ms)');
  };

  let startRow = 0;
  let iHole = 0, iTime = -1, iX = -1, iY = -1, iDia = -1, iLength = -1, iWeight = -1, iAir = -1, iBurden = -1, iSdob = -1, iInclination = -1, iBranch = -1;
  let iTimeCols = [];
  let iChargeName = -1;
  let iSubDrill = -1;
  let iPowderFactor = -1;
  let iElevation = -1, iToeX = -1, iToeY = -1, iToeZ = -1;

  if(hasHeader){
    out.meta.hasHeader = true;
    startRow = 1;
    const hN = first.map(norm);

    const findExact = (arr)=>hN.findIndex(h=>arr.includes(h));
    const findContains = (pred)=>hN.findIndex(pred);

    // Hole id / name
    iHole = findExact(['hole','holeid','hole#','holeno','holename','holenameid','id','name','holenumber']);
    if(iHole < 0){
      iHole = findContains(h=>h.includes('hole') || h==='id' || h==='name');
    }
    if(iHole < 0) iHole = 0;

    // Detonation time (ms)
    iTime = findExact(['detonationtime','detonationtimems','detonations','time','timems','firingtime','firetime','dettime','dettimems']);
    if(iTime < 0){
      iTime = findContains(h=>(h.includes('deton') || h.includes('firing') || h.includes('fire')) && !h.includes('delay'));
    }
    if(iTime < 0){
      iTime = findContains(h=>h==='time' || (h.includes('time') && !h.includes('delay')));
    }
    iTimeCols = first
      .map((raw, idx)=> isDetonationTimeMsHeader(raw) ? idx : -1)
      .filter(idx => idx >= 0);

    // X / Easting
    iX = findExact(['x','easting','east','xcoord','xcoordinate','eastingm']);
    if(iX < 0) iX = findContains(h=>h==='x' || h.includes('easting') || h.endsWith('x'));

    // Y / Northing
    iY = findExact(['y','northing','north','ycoord','ycoordinate','northingm']);
    if(iY < 0) iY = findContains(h=>h==='y' || h.includes('northing') || h.endsWith('y'));

    // Diameter (mm)
    iDia = findExact(['diameter','diametermm','holediameter','dia','diamm','diammm','bitdiameter']);
    if(iDia < 0) iDia = findContains(h=>h.includes('diam'));

    // Hole length (m)
    iLength = findExact(['length','lengthm','holelength','holelengthm']);
    if(iLength < 0) iLength = findContains(h=>h.includes('length') && !h.includes('column'));

    // Charge name / rule name
    iChargeName = findExact(['chargename','chargerule','chargerulename','charge']);
    if(iChargeName < 0){
      iChargeName = findContains(h=>h.includes('charge') && (h.includes('name') || h.includes('rule') || h === 'charge'));
    }

    iWeight = findExact(['explosiveweight','explosive weight','weight','weightkg','weight (kg)','Weight (kg)']);
    if(iWeight < 0) iWeight = findContains(h => h.toLowerCase().includes('weight') && !h.toLowerCase().includes('delay'));
    // If still not found, try column 17 (18th column, 0-indexed)
    if(iWeight < 0 && first.length > 17) iWeight = 17;

    iAir = findExact(['air','airm','airdeck','airdeckm','air deck','air deck (m)','aircolumnlength','airlength']);
    if(iAir < 0) iAir = findContains(h => h.toLowerCase().includes('air') && !h.toLowerCase().includes('repair'));

    iBurden = findExact(['burden','burdenmm','burdenm']);
    if(iBurden < 0) iBurden = findContains(h => h.toLowerCase().includes('burden') && !h.toLowerCase().includes('delay'));

    iInclination = findExact(['inclination','inclinationdeg','inclinationdegrees','inclination°','inclinationdegree','dip','dipdeg','dipdegrees','dipangle']);
    if(iInclination < 0) iInclination = findContains(h => h.toLowerCase().includes('inclination') || h.toLowerCase().includes('incl') || h.toLowerCase().includes('dip'));

    iElevation = findExact(['elevation','elevationm','rl','collarrl','collarelevation']);
    if(iElevation < 0) iElevation = findContains(h => h === 'elevation' || h === 'rl' || h.includes('elevation'));

    iToeX = findExact(['toeeasting','toex','toeeast','toeeastingm']);
    if(iToeX < 0) iToeX = findContains(h => h.includes('toe') && (h.includes('east') || h.endsWith('x')));

    iToeY = findExact(['toenorthing','toey','toenorth','toenorthingm']);
    if(iToeY < 0) iToeY = findContains(h => h.includes('toe') && (h.includes('north') || h.endsWith('y')));

    iToeZ = findExact(['toeelevation','toerl','toeelevationm']);
    if(iToeZ < 0) iToeZ = findContains(h => h.includes('toe') && (h.includes('elevation') || h.endsWith('rl')));

    // SDoB (Standard Deviation of Burden)
    iSdob = findExact(['sdob','standarddeviationofburden','sdoburden','sd burden','sd_burden']);
    if(iSdob < 0) iSdob = findContains(h => h.toLowerCase().includes('sdob') || (h.toLowerCase().includes('sd') && h.toLowerCase().includes('burden')));

    iSubDrill = findExact(['subdrill','sub drill','subdrillm','sub drill (m)','subdrill (m)','subdrilling','sub drilling']);
    if(iSubDrill < 0) iSubDrill = findContains(h => h.toLowerCase().includes('sub') && h.toLowerCase().includes('drill'));

    iPowderFactor = findExact(['powderfactor','powderfactorkgm3','powder factor','powderfactorkgm','powder factor kgm3']);
    if(iPowderFactor < 0) iPowderFactor = findContains(h => h.toLowerCase().includes('powder') && h.toLowerCase().includes('factor'));

    iBranch = findExact(['branch','branchid','branchname']);
    if(iBranch < 0) iBranch = findContains(h => h.toLowerCase().includes('branch'));

    out.meta.mode = 'header';
    out.meta.cols = {hole:iHole, time:iTime, timeColumns:iTimeCols.slice(), x:iX, y:iY, diameter:iDia, length:iLength, chargeName:iChargeName, weight:iWeight, air:iAir, burden:iBurden, sdob:iSdob, inclination:iInclination, subDrill:iSubDrill, powderFactor:iPowderFactor, branch:iBranch, elevation:iElevation, toeX:iToeX, toeY:iToeY, toeZ:iToeZ};
    out.meta.colHeaders = {
      hole: (first[iHole] != null ? first[iHole] : ''),
      time: (iTime>=0 ? (first[iTime] != null ? first[iTime] : '') : ''),
      x: (iX>=0 ? (first[iX] != null ? first[iX] : '') : ''),
      y: (iY>=0 ? (first[iY] != null ? first[iY] : '') : ''),
      diameter: (iDia>=0 ? (first[iDia] != null ? first[iDia] : '') : ''),
      length: (iLength>=0 ? (first[iLength] != null ? first[iLength] : '') : ''),
      chargeName: (iChargeName>=0 ? (first[iChargeName] != null ? first[iChargeName] : '') : ''),
      weight: (iWeight>=0 ? (first[iWeight] != null ? first[iWeight] : '') : ''),
      air: (iAir>=0 ? (first[iAir] != null ? first[iAir] : '') : ''),
      burden: (iBurden>=0 ? (first[iBurden] != null ? first[iBurden] : '') : ''),
      sdob: (iSdob>=0 ? (first[iSdob] != null ? first[iSdob] : '') : ''),
      inclination: (iInclination>=0 ? (first[iInclination] != null ? first[iInclination] : '') : ''),
      subDrill: (iSubDrill>=0 ? (first[iSubDrill] != null ? first[iSubDrill] : '') : ''),
      powderFactor: (iPowderFactor>=0 ? (first[iPowderFactor] != null ? first[iPowderFactor] : '') : ''),
      branch: (iBranch>=0 ? (first[iBranch] != null ? first[iBranch] : '') : ''),
      elevation: (iElevation>=0 ? (first[iElevation] != null ? first[iElevation] : '') : ''),
      toeX: (iToeX>=0 ? (first[iToeX] != null ? first[iToeX] : '') : ''),
      toeY: (iToeY>=0 ? (first[iToeY] != null ? first[iToeY] : '') : ''),
      toeZ: (iToeZ>=0 ? (first[iToeZ] != null ? first[iToeZ] : '') : '')
    };
  } else {
    // No header -> revert to the documented input expectations:
    // Hole # (A), X (B), Y (C), Time (E, ms), Diameter (F, mm)
    out.meta.hasHeader = false;
    startRow = 0;
    iHole = 0;
    iX = 1;
    iY = 2;

    const cols = (aoa[0]||[]).length;
    if(cols < 5){
      out.meta.mode = 'no_header_insufficient_cols';
      out.meta.cols = {hole:iHole, time:-1, x:iX, y:iY, diameter:-1, weight:-1, air:-1, sdob:-1, branch:-1};
      out.meta.colHeaders = null;
      out.meta.error = 'CSV has no header row. Expected at least 5 columns with Time in column E (index 4). Input expectations: Hole#(A), X(B), Y(C), Time(E ms), Diameter(F mm).';
      return out;
    }

    // Column D (index 3) is ignored by design.
    iTime = 4;                  // E
    iTimeCols = [];
    iDia = (cols >= 6) ? 5 : -1; // F (optional if not provided)

    out.meta.mode = 'no_header_expectations';
    out.meta.cols = {hole:iHole, time:iTime, timeColumns:iTimeCols.slice(), x:iX, y:iY, diameter:iDia, length:-1, chargeName:-1, weight:-1, air:-1, branch:-1};
    out.meta.colHeaders = null;
  }

  const byHole = {};
  const canonical = {};
  const byVariantList = {};
  const canonicalList = {};
  const variantHoles = {};

  const seenCanonicalRow = new Map();   // canonicalKey -> firstRowNumber
  const collisionVariants = new Map();  // variant -> Set(hole names)

  const getNum = (row, idx)=>{
    if(idx==null || idx<0 || idx>=row.length) return NaN;
    const v = row[idx];
    if(v==null || v==='') return NaN;
    const n = (typeof v === 'number') ? v : parseFloat(String(v).replace(/,/g,'').trim());
    return isFinite(n) ? n : NaN;
  };

  const addVariantHole = (variant, holeName)=>{
    if(!variantHoles[variant]) variantHoles[variant] = [];
    if(!variantHoles[variant].includes(holeName)) variantHoles[variant].push(holeName);
    if(variantHoles[variant].length > 1){
      collisionVariants.set(variant, new Set(variantHoles[variant]));
    }
  };

  const canonKeyOf = (hole)=> (holeKeyVariants(hole)[0] || String(hole||'').toLowerCase().trim());

  let rowsUsed = 0;

  for(let r=startRow; r<aoa.length; r++){
    const row = aoa[r] || [];
    const holeRaw = row[iHole];
    const hole = String(holeRaw != null ? holeRaw : '').trim();
    if(!hole) continue;

    const timeMsValues = (iTimeCols || [])
      .map(idx => getNum(row, idx))
      .filter(v => Number.isFinite(v))
      .map(v => Math.round(v));
    const timeMsRaw = Number.isFinite(getNum(row, iTime)) ? getNum(row, iTime) : NaN;
    const timeMs = timeMsValues.length ? timeMsValues[0] : (Number.isFinite(timeMsRaw) ? Math.round(timeMsRaw) : NaN);
    const timeMsCount = timeMsValues.length;
    const x = getNum(row, iX);
    const y = getNum(row, iY);
    const diameterMm = getNum(row, iDia);
    const lengthM = getNum(row, iLength);
    const chargeName = (iChargeName >= 0 && iChargeName < row.length)
      ? String(row[iChargeName] != null ? row[iChargeName] : '').trim()
      : '';
    const branch = (iBranch >= 0 && iBranch < row.length)
      ? normalizeBranchValue(row[iBranch])
      : '';

    let explosiveWeight = NaN;
    const weightCols = new Set();
    if(iWeight >= 0) weightCols.add(iWeight);
    for(let idx=0; idx<first.length; idx++){
      if(idx === iWeight) continue;
      const h = String(first[idx] != null ? first[idx] : '').toLowerCase().trim();
      if(h.includes('weight') && !h.includes('delay')){
        weightCols.add(idx);
      }
    }
    for(const idx of weightCols){
      const candidate = getNum(row, idx);
      if(Number.isFinite(candidate)){
        explosiveWeight = candidate;
        break;
      }
    }

    let airM = NaN;
    if(iAir >= 0){
      airM = getNum(row, iAir);
    }

    let burden = NaN;
    if(iBurden >= 0){
      burden = getNum(row, iBurden);
      if(Number.isFinite(burden)){
        const rawHeader = String(first[iBurden] || '').toLowerCase();
        if((rawHeader.includes('(m)') && !rawHeader.includes('mm')) || rawHeader.includes(' metre') || rawHeader.includes(' meter')){
          burden = burden * 1000;
        }
      }
    }

    let sdob = NaN;
    if(iSdob >= 0){
      sdob = getNum(row, iSdob);
    }

    let inclination = NaN;
    if(iInclination >= 0){
      inclination = getNum(row, iInclination);
    }

    const elevation = (iElevation >= 0) ? getNum(row, iElevation) : NaN;
    const toeX = (iToeX >= 0) ? getNum(row, iToeX) : NaN;
    const toeY = (iToeY >= 0) ? getNum(row, iToeY) : NaN;
    const toeZ = (iToeZ >= 0) ? getNum(row, iToeZ) : NaN;

    let explosiveLength = NaN;
    let materialAirLength = NaN;
    for(let idx=0; idx<first.length; idx++){
      const rawHeader = String(first[idx] != null ? first[idx] : '').toLowerCase().trim();
      if(rawHeader !== 'material') continue;
      const material = String(row[idx] != null ? row[idx] : '').trim().toLowerCase();
      if(!material || material === 'stemming') continue;
      for(let j=idx+1; j<Math.min(idx+4, row.length); j++){
        const nextHeader = String(first[j] != null ? first[j] : '').toLowerCase().trim();
        if(!nextHeader.includes('column length')) continue;
        const len = getNum(row, j);
        if(Number.isFinite(len)){
          if(material === 'air'){
            materialAirLength = (Number.isFinite(materialAirLength) ? materialAirLength : 0) + len;
          } else {
            explosiveLength = (Number.isFinite(explosiveLength) ? explosiveLength : 0) + len;
          }
          break;
        }
      }
    }

    if(!Number.isFinite(airM) && Number.isFinite(materialAirLength)){
      airM = materialAirLength;
    }

    let subDrill = NaN;
    if(iSubDrill >= 0){
      subDrill = getNum(row, iSubDrill);
    }

    let powderFactor = NaN;
    if(iPowderFactor >= 0){
      powderFactor = getNum(row, iPowderFactor);
    }

    const rec = {
      hole,
      timeMs,
      timeMsCount,
      x,
      y,
      elevation,
      toeX,
      toeY,
      toeZ,
      diameterMm,
      lengthM,
      chargeName,
      branch,
      explosiveWeight,
      airM,
      explosiveLength,
      burden,
      sdob,
      inclination,
      subDrill,
      powderFactor,
      'Powder Factor (kg/m^3)': powderFactor,
      'Sub Drill (m)': subDrill,
      row: r+1
    };
    out.csvHoles.push(rec);

    const canonKey = canonKeyOf(hole);
    if(!canonicalList[canonKey]) canonicalList[canonKey] = [];
    canonicalList[canonKey].push(rec);

    if(seenCanonicalRow.has(canonKey)){
      out.duplicates.repeatedHoleRows.push({hole, firstRow: seenCanonicalRow.get(canonKey), otherRow: r+1});
    } else {
      seenCanonicalRow.set(canonKey, r+1);
      canonical[canonKey] = rec;
    }

    const variants = holeKeyVariants(hole);
    variants.forEach(k=>{
      addVariantHole(k, hole);

      if(!byVariantList[k]) byVariantList[k] = [];
      byVariantList[k].push(rec);

      if(!byHole[k]){
        byHole[k] = rec; // stable first record for legacy code paths
      }
    });

    rowsUsed++;
  }

  out.duplicates.variantCollisions = Array.from(collisionVariants.entries())
    .map(([variant, set])=>({variant, holes: Array.from(set)}))
    .sort((a,b)=>a.variant.localeCompare(b.variant));

  const mergedByHole = {};
  const mergedByVariantList = {};
  const mergedCanonical = {};
  const mergedCanonicalList = {};
  const mergedCsvHoles = [];

  const firstFinite = (arr, field)=>{
    for(const r of arr){
      const v = Number(r[field]);
      if(Number.isFinite(v)) return v;
    }
    return NaN;
  };
  const sumFinitePositive = (arr, field)=>{
    let s = 0;
    let n = 0;
    for(const r of arr){
      const v = Number(r[field]);
      if(Number.isFinite(v) && v > 0){ s += v; n++; }
    }
    return n > 0 ? s : NaN;
  };
  const allNearlyEqual = (vals)=>{
    if(!vals.length) return false;
    const a0 = vals[0];
    for(let i=1;i<vals.length;i++){
      const a = vals[i];
      if(Math.abs(a - a0) > 1e-6 * Math.max(1, Math.abs(a), Math.abs(a0))) return false;
    }
    return true;
  };

  Object.keys(canonicalList).forEach(ck=>{
    const arr = canonicalList[ck] || [];
    if(!arr.length) return;

    const lens = arr
      .map(r=>Number(r.explosiveLength))
      .filter(v=>Number.isFinite(v) && v > 0);
    let mergedExplLen = NaN;
    if(lens.length){
      mergedExplLen = allNearlyEqual(lens) ? lens[0] : lens.reduce((a,b)=>a+b, 0);
    }

    const airs = arr
      .map(r=>Number(r.airM))
      .filter(v=>Number.isFinite(v) && v >= 0);
    let mergedAirM = NaN;
    if(airs.length){
      mergedAirM = allNearlyEqual(airs) ? airs[0] : airs.reduce((a,b)=>a+b, 0);
    }

    const rec0 = arr[0];
    const merged = {
      hole: rec0.hole,
      timeMs: firstFinite(arr, 'timeMs'),
      timeMsCount: arr.reduce((sum, r)=>{
        const c = Number(r && r.timeMsCount);
        return sum + (Number.isFinite(c) && c > 0 ? c : 0);
      }, 0),
      x: firstFinite(arr, 'x'),
      y: firstFinite(arr, 'y'),
      elevation: firstFinite(arr, 'elevation'),
      toeX: firstFinite(arr, 'toeX'),
      toeY: firstFinite(arr, 'toeY'),
      toeZ: firstFinite(arr, 'toeZ'),
      diameterMm: firstFinite(arr, 'diameterMm'),
      lengthM: firstFinite(arr, 'lengthM'),
      chargeName: (arr.find(r=>String(r.chargeName||'').trim() !== '') || {chargeName:''}).chargeName,
      branch: normalizeBranchValue((arr.find(r=>normalizeBranchValue(r.branch) !== '') || {branch:''}).branch),
      explosiveWeight: firstFinite(arr, 'explosiveWeight'),
      airM: mergedAirM,
      explosiveLength: mergedExplLen,
      burden: firstFinite(arr, 'burden'),
      sdob: firstFinite(arr, 'sdob'),
      inclination: firstFinite(arr, 'inclination'),
      subDrill: firstFinite(arr, 'subDrill'),
      row: rec0.row,
      mergedRows: arr.length,
      sourceRows: arr.map(r=>r.row)
    };

    if(!Number.isFinite(merged.explosiveLength)){
      merged.explosiveLength = sumFinitePositive(arr, 'explosiveLength');
    }

    mergedCanonical[ck] = merged;
    mergedCanonicalList[ck] = [merged];
    mergedCsvHoles.push(merged);

    const variants = holeKeyVariants(merged.hole);
    variants.forEach(k=>{
      if(!mergedByVariantList[k]) mergedByVariantList[k] = [];
      mergedByVariantList[k].push(merged);
      if(!mergedByHole[k]) mergedByHole[k] = merged;
    });
  });

  out.byHole = mergedByHole;
  out.byVariantList = mergedByVariantList;
  out.canonical = mergedCanonical;
  out.canonicalList = mergedCanonicalList;
  out.csvHolesMerged = mergedCsvHoles;
  out.variantHoles = variantHoles;
  out.meta.rows = rowsUsed;
  return out;
}


// Build a one-to-one mapping BLST hole instance (nodeId) -> CSV record.
// Prefer matching within duplicate-name groups using CSV X/Y (if present). Falls back to stable ordering.
function buildCsvAssignmentForBlstHoles(blstHoles, csvDet){
  const res = {
    byNodeId: new Map(), // nodeId -> {rec, method, dist_m, candidates}
    diag: {
      blstHoleCountTotal: 0,
      blstUniqueNameCount: 0,
      blstDuplicateNames: [], // [{name, count, nodeIds:[...]}]
      csvRowCountTotal: 0,
      csvUniqueNameCount: 0,
      assigned: 0,
      unresolved: 0,
      ambiguousGroups: 0,
      examples: {unresolved: [], ambiguous: [], csvOnly: []}
    }
  };

  const canonKeyOf = (name)=> (holeKeyVariants(name)[0] || String(name||'').toLowerCase().trim());
  const nameOf = (h)=> String(h && (h.name || h.hole || h.id) || '').trim();

  const blstByCanon = new Map();
  const blstNameCounts = new Map();
  (blstHoles || []).forEach(h=>{
    const nm = nameOf(h);
    if(!nm) return;
    const ck = canonKeyOf(nm);
    if(!blstByCanon.has(ck)) blstByCanon.set(ck, []);
    blstByCanon.get(ck).push(h);
    blstNameCounts.set(nm, (blstNameCounts.get(nm)||0)+1);
  });

  res.diag.blstHoleCountTotal = (blstHoles || []).length;
  res.diag.blstUniqueNameCount = blstNameCounts.size;
  res.diag.blstDuplicateNames = Array.from(blstNameCounts.entries())
    .filter(([_,cnt])=>cnt>1)
    .map(([nm,cnt])=>({name:nm, count:cnt, nodeIds:(blstHoles||[]).filter(h=>nameOf(h)===nm).map(h=>h.nodeId).filter(x=>Number.isFinite(x))}))
    .sort((a,b)=>b.count-a.count || a.name.localeCompare(b.name));

  // For assignment, use ORIGINAL CSV rows (not merged) so that angle holes get separate records with their own diameter
  const csvRecs = (csvDet && Array.isArray(csvDet.csvHoles) && csvDet.csvHoles.length)
    ? csvDet.csvHoles
    : ((csvDet && Array.isArray(csvDet.csvHolesMerged)) ? csvDet.csvHolesMerged : []);
  res.diag.csvRowCountTotal = csvRecs.length;

  const csvByCanon = new Map();
  const csvNameCounts = new Map();
  csvRecs.forEach(r=>{
    const nm = String(r.hole||'').trim();
    if(!nm) return;
    const ck = canonKeyOf(nm);
    if(!csvByCanon.has(ck)) csvByCanon.set(ck, []);
    csvByCanon.get(ck).push(r);
    csvNameCounts.set(nm, (csvNameCounts.get(nm)||0)+1);
  });
  res.diag.csvUniqueNameCount = csvNameCounts.size;

  // CSV-only holes (no matching canonical key in BLST)
  for(const [ck, arr] of csvByCanon.entries()){
    if(!blstByCanon.has(ck)){
      res.diag.examples.csvOnly.push(arr[0].hole);
    }
  }

  const XY_TOL = 0.5; // metres (tolerant of rounding)
  const XY_TOL_GLOBAL = 1.5; // metres for cross-name fallback matching
  const bo = (window.blstData && window.blstData.blastOrigin) ? window.blstData.blastOrigin : null;
  const csvLocalXY = (r)=>{
    const rx = Number(r && r.x), ry = Number(r && r.y);
    if(!Number.isFinite(rx) || !Number.isFinite(ry)) return {x: NaN, y: NaN};
    if(bo && Number.isFinite(bo.easting) && Number.isFinite(bo.northing)){
      return {x: rx - bo.easting, y: ry - bo.northing};
    }
    return {x: rx, y: ry};
  };
  const dist = (h, r)=>{
    if(!h || !r) return Infinity;
    const hx = Number(h.x), hy = Number(h.y);
    const crd = csvLocalXY(r);
    if(!isFinite(hx) || !isFinite(hy) || !isFinite(crd.x) || !isFinite(crd.y)) return Infinity;
    return Math.hypot(hx - crd.x, hy - crd.y);
  };

  // Assign per canonical group
  for(const [ck, blstArr] of blstByCanon.entries()){
    const csvArr = csvByCanon.get(ck) || [];
    if(!csvArr.length){
      blstArr.forEach(h=>{
        res.diag.unresolved++;
        if(res.diag.examples.unresolved.length<50) res.diag.examples.unresolved.push(`${nameOf(h)} (node ${h.nodeId})`);
      });
      continue;
    }

    // Candidate set for reporting (original hole names present in CSV for this canonical group)
    const candNames = Array.from(new Set(csvArr.map(r=>String(r.hole||'').trim()).filter(Boolean)));

    // If either side has only one entry, assign best match (but keep ambiguity info if multiple CSV rows exist).
    if(blstArr.length === 1){
      const h = blstArr[0];
      let best = null, bestD = Infinity;
      for(const r of csvArr){
        const d = dist(h, r);
        if(d < bestD){ bestD = d; best = r; }
      }
      const chosen = best || csvArr[0];
      const method = (best && isFinite(bestD)) ? ((bestD <= XY_TOL) ? 'xy_nearest' : 'fallback_first') : 'fallback_first';
      if(csvArr.length > 1){
        res.diag.ambiguousGroups++;
        if(res.diag.examples.ambiguous.length<50) res.diag.examples.ambiguous.push({blst: `${nameOf(h)} (node ${h.nodeId})`, candidates: candNames.slice(0,10)});
      }
      res.byNodeId.set(h.nodeId, {rec: chosen, method, dist_m: isFinite(bestD)?bestD:null, candidates: candNames});
      res.diag.assigned++;
      continue;
    }

    // Multi-hole group: attempt one-to-one assignment.
    const unHoles = blstArr.slice();
    const unCsv = csvArr.slice();
    const assignedHole = new Set();
    const assignedCsv = new Set();

    // Pairwise greedy by xy if possible
    const pairs = [];
    for(let i=0;i<unHoles.length;i++){
      for(let j=0;j<unCsv.length;j++){
        const d = dist(unHoles[i], unCsv[j]);
        if(isFinite(d)) pairs.push({i,j,d});
      }
    }
    pairs.sort((a,b)=>a.d-b.d);

    pairs.forEach(p=>{
      if(assignedHole.has(p.i) || assignedCsv.has(p.j)) return;
      if(p.d > XY_TOL) return;
      assignedHole.add(p.i);
      assignedCsv.add(p.j);
      const h = unHoles[p.i];
      const r = unCsv[p.j];
      res.byNodeId.set(h.nodeId, {rec:r, method:'xy_nearest', dist_m:p.d, candidates:candNames});
      res.diag.assigned++;
    });

    // Remaining: stable fallback ordering
    const remHoles = unHoles.map((h,i)=>({h,i})).filter(o=>!assignedHole.has(o.i)).map(o=>o.h);
    const remCsv = unCsv.map((r,j)=>({r,j})).filter(o=>!assignedCsv.has(o.j)).map(o=>o.r);

    if(remHoles.length && remCsv.length){
      // Sort BLST holes by (x,y,nodeId)
      remHoles.sort((a,b)=>{
        const ax = (isFinite(a.x)?a.x:Infinity), bx = (isFinite(b.x)?b.x:Infinity);
        const ay = (isFinite(a.y)?a.y:Infinity), by = (isFinite(b.y)?b.y:Infinity);
        if(ax!==bx) return ax-bx;
        if(ay!==by) return ay-by;
        return (a.nodeId||0)-(b.nodeId||0);
      });
      // Sort CSV by (x,y) if present, else by (time,row)
      const hasAnyXY = remCsv.some(r=>isFinite(r.x)&&isFinite(r.y));
      if(hasAnyXY){
        remCsv.sort((a,b)=>{
          const al = csvLocalXY(a), bl = csvLocalXY(b);
          const ax = (isFinite(al.x)?al.x:Infinity), bx = (isFinite(bl.x)?bl.x:Infinity);
          const ay = (isFinite(al.y)?al.y:Infinity), by = (isFinite(bl.y)?bl.y:Infinity);
          if(ax!==bx) return ax-bx;
          if(ay!==by) return ay-by;
          return (a.row||0)-(b.row||0);
        });
      } else {
        remCsv.sort((a,b)=>{
          const ta = Number.isFinite(a.timeMs)?a.timeMs:Infinity;
          const tb = Number.isFinite(b.timeMs)?b.timeMs:Infinity;
          if(ta!==tb) return ta-tb;
          return (a.row||0)-(b.row||0);
        });
      }

      const n = Math.min(remHoles.length, remCsv.length);
      if(n>0){
        res.diag.ambiguousGroups++;
        if(res.diag.examples.ambiguous.length<50){
          res.diag.examples.ambiguous.push({blst: `${canonKeyOf(nameOf(remHoles[0]))} (group)`, candidates: candNames.slice(0,10)});
        }
      }
      for(let k=0;k<n;k++){
        const h = remHoles[k];
        const r = remCsv[k];
        const d = dist(h,r);
        res.byNodeId.set(h.nodeId, {rec:r, method: hasAnyXY ? 'fallback_order_xy' : 'fallback_order_time', dist_m:isFinite(d)?d:null, candidates:candNames});
        res.diag.assigned++;
      }
      // Any remaining holes unresolved
      for(let k=n;k<remHoles.length;k++){
        const h = remHoles[k];
        res.diag.unresolved++;
        if(res.diag.examples.unresolved.length<50) res.diag.examples.unresolved.push(`${nameOf(h)} (node ${h.nodeId})`);
      }
    } else {
      // Holes remain but no CSV remain
      remHoles.forEach(h=>{
        res.diag.unresolved++;
        if(res.diag.examples.unresolved.length<50) res.diag.examples.unresolved.push(`${nameOf(h)} (node ${h.nodeId})`);
      });
    }
  }

  // Global XY fallback for holes unresolved by name/canonical matching.
  const unresolvedHoles = (blstHoles || []).filter(h=>Number.isFinite(h.nodeId) && !res.byNodeId.has(h.nodeId));
  if(unresolvedHoles.length){
    const usedRows = new Set(Array.from(res.byNodeId.values()).map(v=>v && v.rec && v.rec.row).filter(Number.isFinite));
    const remainingCsv = csvRecs.filter(r=>!(Number.isFinite(r.row) && usedRows.has(r.row)));

    const pairs = [];
    for(let i=0;i<unresolvedHoles.length;i++){
      for(let j=0;j<remainingCsv.length;j++){
        const d = dist(unresolvedHoles[i], remainingCsv[j]);
        if(isFinite(d)) pairs.push({i,j,d});
      }
    }
    pairs.sort((a,b)=>a.d-b.d);

    const usedHole = new Set();
    const usedCsv = new Set();
    for(const p of pairs){
      if(p.d > XY_TOL_GLOBAL) break;
      if(usedHole.has(p.i) || usedCsv.has(p.j)) continue;
      usedHole.add(p.i);
      usedCsv.add(p.j);

      const h = unresolvedHoles[p.i];
      const r = remainingCsv[p.j];
      res.byNodeId.set(h.nodeId, {rec:r, method:'global_xy_nearest', dist_m:p.d, candidates:[String(r.hole||'')]});
      res.diag.assigned++;
      if(res.diag.unresolved > 0) res.diag.unresolved--;
    }
  }

  return res;
}


function applyCsvTimesToBlstAndRows(){
  const timingNoteTop = document.getElementById('timingNoteTop');
  const timingNoteMap = document.getElementById('timingNoteMap');
  const timingNoteAnim = document.getElementById('timingNoteAnim');

  const csvLoaded = !!window.csvLoaded;
  const hasCsv = !!window.csvModeActive;

  const warnMsg = 'Detonation times are approximate only for simulation purposes. Please upload exported Paradigm times (CSV) for accurate PPV.';
  const csvButNoTimesMsg = 'CSV file loaded but no valid detonation times were parsed. Conflict checking is disabled until a valid detonation-time column is detected.';
  if(!hasCsv){
    const msg = csvLoaded ? csvButNoTimesMsg : warnMsg;
    [timingNoteTop, timingNoteMap, timingNoteAnim].forEach(el=>{
      if(!el) return;
      el.classList.remove('good'); el.classList.add('warn');
      el.textContent = msg;
      el.style.display = 'block';
    });
    try{ if(typeof updateExportStatus==='function') updateExportStatus(); }catch(e){}
    return;
  }

  const det = (window.csvDet && window.csvDet.byHole) ? window.csvDet.byHole : null;
  const variantHoles = (window.csvDet && window.csvDet.variantHoles) ? window.csvDet.variantHoles : null;

  // Legacy name-based lookup (single best record). Still used as a fallback when nodeId mapping is not available.
  const lookupByName = (holeName)=>{
    const variants = holeKeyVariants(holeName);
    const cand = new Set();
    let rec = null;

    for(const k of variants){
      if(variantHoles && variantHoles[k]){
        variantHoles[k].forEach(h=>cand.add(h));
      }
      if(!rec && det && det[k]) rec = det[k];
      if(!rec && window.csvTimes && Object.prototype.hasOwnProperty.call(window.csvTimes, k)){
        rec = {hole: String(holeName||''), timeMs: window.csvTimes[k]};
      }
    }
    return {rec, candidates: Array.from(cand)};
  };

  // Build BLST nodeId -> CSV record assignment (handles duplicate hole names correctly).
  let assignment = null;
  if(window.blstData && Array.isArray(window.blstData.holes) && window.blstData.holes.length && window.csvDet){
    assignment = buildCsvAssignmentForBlstHoles(window.blstData.holes, window.csvDet);
    window.csvAssignmentByNodeId = assignment.byNodeId;
    window.csvAssignmentDiag = assignment.diag;
  } else {
    window.csvAssignmentByNodeId = null;
    window.csvAssignmentDiag = null;
  }

  const getAssignedRec = (nodeId, holeName)=>{
    if(nodeId != null && assignment && assignment.byNodeId && assignment.byNodeId.has(nodeId)){
      return assignment.byNodeId.get(nodeId);
    }
    const res = lookupByName(holeName);
    return {rec: res.rec, method:'name_lookup', dist_m:null, candidates: res.candidates || []};
  };

  let applied = 0;
  let missing = 0;
  let appliedBlst = 0;
  let missingBlst = 0;
  let countedFromPoints = false;

  // Apply to in-memory point objects used for playback/conflict checking (if already built)
  if(window.pts && window.pts.length){
    countedFromPoints = true;
    window.pts.forEach(p=>{
      const holeName = (p.hole || p.name || p.id);
      const nodeId = (p.nodeId != null && Number.isFinite(p.nodeId)) ? p.nodeId : null;
      const got = getAssignedRec(nodeId, holeName);
      const rec = got.rec;

      if(p.time_source == null) p.time_source = 'blst';
      if(p.time_blst == null) p.time_blst = Number.isFinite(p.time) ? Math.round(p.time) : NaN;

      if(rec && Number.isFinite(rec.timeMs)){
        p.hasPrimer = true;
        p.time_csv = Math.round(rec.timeMs);
        p.time = p.time_csv;
        p.time_source = 'csv';
        p._csv_assign_method = got.method;
        p._csv_assign_dist_m = got.dist_m;
        applied++;
      } else if(p.hasPrimer){
        p.time = NaN;
        p.time_csv = NaN;
        p.time_source = 'csv_missing';
        p._csv_assign_method = got.method;
        missing++;
      }

      p.csv_match_candidates = got.candidates || [];
      p.csv_match_ambiguous = (p.csv_match_candidates && p.csv_match_candidates.length > 1);

      // Optional geometry overrides if provided in CSV (for CSV-only or conflict-check maps)
      if(rec){
        p._csvRec = rec;
        if(Number.isFinite(rec.elevation)) p.elevation = rec.elevation;
        const bo = (window.blstData && window.blstData.blastOrigin) ? window.blstData.blastOrigin : null;
        if(bo){
          if(Number.isFinite(rec.toeX)) p.toe_x = rec.toeX - bo.easting;
          if(Number.isFinite(rec.toeY)) p.toe_y = rec.toeY - bo.northing;
        } else {
          if(Number.isFinite(rec.toeX)) p.toe_x = rec.toeX;
          if(Number.isFinite(rec.toeY)) p.toe_y = rec.toeY;
        }
        if(Number.isFinite(rec.toeZ)) p.toe_z = rec.toeZ;
        if(Number.isFinite(rec.explosiveLength)) p.explosiveLength = rec.explosiveLength;
        if(Number.isFinite(rec.x)){
          const bo = (window.blstData && window.blstData.blastOrigin) ? window.blstData.blastOrigin : null;
          p.x = bo ? (rec.x - bo.easting) : rec.x;
          if(p.hasOwnProperty('X (B)')) p['X (B)'] = rec.x;
          else if(p.hasOwnProperty('X')) p['X'] = rec.x;
          else p['X (B)'] = rec.x;
        }
        if(Number.isFinite(rec.y)){
          const bo = (window.blstData && window.blstData.blastOrigin) ? window.blstData.blastOrigin : null;
          p.y = bo ? (rec.y - bo.northing) : rec.y;
          if(p.hasOwnProperty('Y (C)')) p['Y (C)'] = rec.y;
          else if(p.hasOwnProperty('Y')) p['Y'] = rec.y;
          else p['Y (C)'] = rec.y;
        }
        if(Number.isFinite(rec.diameterMm)){
          if(p.hasOwnProperty('Diameter (mm)')) p['Diameter (mm)'] = rec.diameterMm;
          else if(p.hasOwnProperty('Diameter')) p['Diameter'] = rec.diameterMm;
          else p['Diameter (mm)'] = rec.diameterMm;
        }
        if(Number.isFinite(rec.burden)){
          if(p.hasOwnProperty('Burden (mm)')) p['Burden (mm)'] = rec.burden;
          else if(p.hasOwnProperty('Burden')) p['Burden'] = rec.burden;
          else p['Burden'] = rec.burden;
        }
      }
    });
  } else if(window.holes && window.holes.length){
    countedFromPoints = true;
    window.holes.forEach(h=>{
      const holeName = (h.name || h.hole || h.id);
      const nodeId = (h.nodeId != null && Number.isFinite(h.nodeId)) ? h.nodeId : null;
      const got = getAssignedRec(nodeId, holeName);
      const rec = got.rec;

      if(h.time_source == null) h.time_source = 'blst';
      if(h.time_blst == null) h.time_blst = Number.isFinite(h.time) ? Math.round(h.time) : NaN;

      if(rec && Number.isFinite(rec.timeMs)){
        h.hasPrimer = true;
        h._detonation_ms_csv = Math.round(rec.timeMs);
        h.detonation_ms = h._detonation_ms_csv;
        h._time_source = 'csv';
        h._csv_assign_method = got.method;
        h._csv_assign_dist_m = got.dist_m;
        appliedBlst++; if(!countedFromPoints) applied++;
      } else if(h.hasPrimer){
        h._detonation_ms_csv = null;
        h.detonation_ms = null;
        h._time_source = 'csv_missing';
        h._csv_assign_method = got.method;
        missingBlst++; if(!countedFromPoints) missing++;
      }

      h._csv_match_candidates = got.candidates || [];
      h._csv_match_ambiguous = (h._csv_match_candidates && h._csv_match_candidates.length > 1);

      if(rec){
        h._csvRec = rec;
        // NOTE: Keep BLST geometry for PPV viewer so receiver locations remain consistent with design.
        if(Number.isFinite(rec.diameterMm)) h.diameter_mm = rec.diameterMm;
        if(Number.isFinite(rec.lengthM) && rec.lengthM > 0) h.length_m = rec.lengthM;
        if(Number.isFinite(rec.elevation)) h.elevation = rec.elevation;
        if(window.blstData && window.blstData.blastOrigin){
          if(Number.isFinite(rec.toeX)) h.toe_x = rec.toeX - window.blstData.blastOrigin.easting;
          if(Number.isFinite(rec.toeY)) h.toe_y = rec.toeY - window.blstData.blastOrigin.northing;
        } else {
          if(Number.isFinite(rec.toeX)) h.toe_x = rec.toeX;
          if(Number.isFinite(rec.toeY)) h.toe_y = rec.toeY;
        }
        if(Number.isFinite(rec.toeZ)) h.toe_z = rec.toeZ;
        if(Number.isFinite(rec.explosiveLength)) h.explosive_length_m = rec.explosiveLength;
      }
    });
  }

  // Apply to BLST hole objects used by vibration PPV/visualiser (detonation_ms field)
  if(window.blstData && window.blstData.holes && window.blstData.holes.length){
    window.blstData.holes.forEach(h=>{
      const holeName = (h.name || h.hole || h.id);
      const nodeId = (h.nodeId != null && Number.isFinite(h.nodeId)) ? h.nodeId : null;
      const got = getAssignedRec(nodeId, holeName);
      const rec = got.rec;

      if(h._detonation_ms_blst == null){
        h._detonation_ms_blst = (h.detonation_ms != null && Number.isFinite(h.detonation_ms)) ? Math.round(h.detonation_ms) : null;
      }

      if(rec && Number.isFinite(rec.timeMs)){
        h.hasPrimer = true;
        h._detonation_ms_csv = Math.round(rec.timeMs);
        h.detonation_ms = h._detonation_ms_csv;
        h._time_source = 'csv';
        h._csv_assign_method = got.method;
        h._csv_assign_dist_m = got.dist_m;
        appliedBlst++; if(!countedFromPoints) applied++;
      } else if(h.hasPrimer){
        h._detonation_ms_csv = null;
        h.detonation_ms = null;
        h._time_source = 'csv_missing';
        h._csv_assign_method = got.method;
        missingBlst++; if(!countedFromPoints) missing++;
      }

      h._csv_match_candidates = got.candidates || [];
      h._csv_match_ambiguous = (h._csv_match_candidates && h._csv_match_candidates.length > 1);

      if(rec){
        h._csvRec = rec;
        // NOTE: Keep BLST geometry for PPV viewer so receiver locations remain consistent with design.
        if(Number.isFinite(rec.diameterMm)) h.diameter_mm = rec.diameterMm;
        if(Number.isFinite(rec.lengthM) && rec.lengthM > 0) h.length_m = rec.lengthM;
      }
    });
  }

  // Apply to rows used by the rest of the tool (for exports and display tables)
  if(window.rows && window.rows.length){
    const getRowTime = (o)=>{
      const keys = ['Detonation Time (ms)','Time (E)','Time','TIME','time'];
      for(const k of keys){
        if(Object.prototype.hasOwnProperty.call(o,k)) return {key:k, val:o[k]};
      }
      return {key:null, val:undefined};
    };

    window.rows.forEach(o=>{
      const holeName = (o['Hole #'] != null ? o['Hole #'] : (o['Hole'] != null ? o['Hole'] : (o['Hole ID'] != null ? o['Hole ID'] : (o['Name'] != null ? o['Name'] : (o['hole'] != null ? o['hole'] : o['hole_id'])))));
      const nodeIdRaw = (o['NodeId'] != null ? o['NodeId'] : (o['nodeId'] != null ? o['nodeId'] : (o['HoleId'] != null ? o['HoleId'] : (o['ID'] != null ? o['ID'] : null))));
      const nodeId = (nodeIdRaw == null || String(nodeIdRaw).trim()==='') ? null : parseInt(String(nodeIdRaw).trim(), 10);

      const got = getAssignedRec(Number.isFinite(nodeId)?nodeId:null, holeName);
      const rec = got.rec;

      if(o._time_blst == null){
        const rt = getRowTime(o);
        const base = roundMs(rt.val);
        o._time_blst = Number.isFinite(base) ? base : NaN;
      }
      if(o._time_source == null) o._time_source = 'blst';

      if(rec && Number.isFinite(rec.timeMs)){
        const t = Math.round(rec.timeMs);
        o._time_csv = t;
        o._time_source = 'csv';
        o._csv_assign_method = got.method;

        if(o.hasOwnProperty('Detonation Time (ms)')) o['Detonation Time (ms)'] = t;
        else if(o.hasOwnProperty('Time (E)')) o['Time (E)'] = t;
        else if(o.hasOwnProperty('Time')) o['Time'] = t;
        else o['Detonation Time (ms)'] = t;

      } else {
        o._time_csv = NaN;
        if(o._time_source === 'csv') o._time_source = 'csv_missing';
      }

      if(rec){
        if(Number.isFinite(rec.x)){
          if(o.hasOwnProperty('X (B)')) o['X (B)'] = rec.x;
          else if(o.hasOwnProperty('X')) o['X'] = rec.x;
          else o['X (B)'] = rec.x;
        }
        if(Number.isFinite(rec.y)){
          if(o.hasOwnProperty('Y (C)')) o['Y (C)'] = rec.y;
          else if(o.hasOwnProperty('Y')) o['Y'] = rec.y;
          else o['Y (C)'] = rec.y;
        }
        if(Number.isFinite(rec.diameterMm)){
          if(o.hasOwnProperty('Diameter (mm)')) o['Diameter (mm)'] = rec.diameterMm;
          else if(o.hasOwnProperty('Diameter')) o['Diameter'] = rec.diameterMm;
          else o['Diameter (mm)'] = rec.diameterMm;
        }
        if(Number.isFinite(rec.lengthM)){
          if(o.hasOwnProperty('Length (m)')) o['Length (m)'] = rec.lengthM;
          else if(o.hasOwnProperty('Length')) o['Length'] = rec.lengthM;
          else o['Length (m)'] = rec.lengthM;
        }
        if(Number.isFinite(rec.burden)){
          if(o.hasOwnProperty('Burden (mm)')) o['Burden (mm)'] = rec.burden;
          else if(o.hasOwnProperty('Burden')) o['Burden'] = rec.burden;
          else o['Burden'] = rec.burden;
        }
      }

      o._csv_match_candidates = got.candidates || [];
