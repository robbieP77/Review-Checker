        } else if(p.hasPrimer){
          mapCallReviewCtx.fillStyle = '#38bdf8';
          mapCallReviewCtx.fill();
        } else {
          mapCallReviewCtx.fillStyle = 'rgba(148,163,184,0.4)';
          mapCallReviewCtx.fill();
        }
      }
    }

