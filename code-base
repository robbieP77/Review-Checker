        // - Some files include a global BlastPosition { id (E,Z,N) } table (absolute coords).
        // - Some design files omit BlastPosition and store hole positions as Translation under translated parent groups.
        let localX = null, localY = null, localZ = null;

        const pos = blastPos[nodeId];
        if(pos){
          // Convert absolute E/N to local plan coords if BlastOrigin is provided.
          localX = blastOrigin ? (pos.E - blastOrigin.easting) : pos.E;
          localY = blastOrigin ? (pos.N - blastOrigin.northing) : pos.N;
