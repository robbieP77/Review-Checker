    // ---------- BLST parser: radial + fixed per-hole timing + primer detection ----------

    function parseBLST(text){
      // BlastOrigin (E, Elev, N) – may be absent
      const boMatch = text.match(/set\s+BlastOrigin\s*\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
      let blastOrigin = null;
      if (boMatch) {
        blastOrigin = {
          x: parseFloat(boMatch[1]),
          y: parseFloat(boMatch[2]),
          z: parseFloat(boMatch[3])
        };
      }

      // BlastPosition (if present)
      const bpMatch = text.match(/set\s+BlastPosition\s*\{([\s\S]*?)\}/);
      const blastPos = {};
      if (bpMatch) {
        const body = bpMatch[1];
        const lines = body.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
        for (let i=0;i<lines.length-1;i+=2){
          const idLine = lines[i];
          const coordLine = lines[i+1];
          if (!/^\d+$/.test(idLine)) continue;
          const m = coordLine.match(/\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
          if (!m) continue;
          blastPos[parseInt(idLine,10)] = {
            easting:   parseFloat(m[1]),
            elevation: parseFloat(m[2]),
            northing:  parseFloat(m[3])
          };
        }
      }

      // ActiveTiming and composite HoleScenarios
      const atMatch = text.match(/set\s+ActiveTiming\s+(\d+)/);
      let activeTimingId = atMatch ? parseInt(atMatch[1],10) : null;

      const holeScenarioMap = {};
      if (activeTimingId != null) {
        const csRegex = new RegExp("select\\s+" + activeTimingId + "\\b([\\s\\S]*?)(?=\\nselect\\s+\\d+|$)");
        const csMatch = text.match(csRegex);
        if (csMatch) {
          const hsMatch = csMatch[0].match(/set\s+HoleScenarios\s*\{([\s\S]*?)\}/);
          if (hsMatch) {
            const lines = hsMatch[1].split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
            for (let i=0;i<lines.length-1;i+=2){
              if (/^\d+$/.test(lines[i]) && /^\d+$/.test(lines[i+1])){
                holeScenarioMap[parseInt(lines[i],10)] = parseInt(lines[i+1],10);
              }
            }
          }
        }
      }

      const grabFloat = (block, re) => {
        const m = block.match(re);
        return m ? parseFloat(m[1]) : null;
      };

      const scenIds = Array.from(new Set(Object.values(holeScenarioMap)));

      const radialParams = {};     // scenarioId -> radial parameters
      const tieInScenarios = {};   // scenarioId -> {startTime, timesByNodeId}

      // Scan scenarios and classify as radial vs fixed per-hole timing
      scenIds.forEach(sid=>{
        const rsRegex = new RegExp("select\\s+" + sid + "\\b([\\s\\S]*?)(?=\\nselect\\s+\\d+|$)");
        const rsMatch = text.match(rsRegex);
        if (!rsMatch) return;
        const block = rsMatch[0];

        // Fixed per-hole timing (TieInTimingScenario with ConnectionPairs / ConnectionDelays)
        if (/set\s+ConnectionPairs\s*\{/.test(block)) {
          const startM = block.match(/set\s+StartTime\s+([-\d.]+)/);
          const startTime = startM ? parseFloat(startM[1]) : 0;

          const cpMatch = block.match(/set\s+ConnectionPairs\s*\{([\s\S]*?)\}/);
          const cdMatch = block.match(/set\s+ConnectionDelays\s*\{([\s\S]*?)\}/);

          const cpNums = [];
          if (cpMatch) {
            cpMatch[1].split(/\r?\n/).forEach(line=>{
              const s = line.trim();
              if (!s) return;
              if (/^-?\d+$/.test(s)) cpNums.push(parseInt(s,10));
            });
          }
          const pairs = [];
          for (let i=0;i+1<cpNums.length;i+=2){
            pairs.push([cpNums[i], cpNums[i+1]]);
          }

          const delays = [];
          if (cdMatch) {
            cdMatch[1].split(/\r?\n/).forEach(line=>{
              const s = line.trim();
              if (!s) return;
              const v = parseFloat(s);
              if (!isNaN(v)) delays.push(v);
            });
          }

          const edges = [];
          for (let i=0;i<pairs.length;i++){
            const [u,v] = pairs[i];
            const d = i<delays.length ? delays[i] : 0;
            edges.push({u,v,delay:d});
          }

          const nodes = new Set();
          edges.forEach(e=>{ nodes.add(e.u); nodes.add(e.v); });

          const indeg = {};
          const adj = {};
          nodes.forEach(n=>{ indeg[n]=0; adj[n]=[]; });
          edges.forEach(e=>{
            if (!indeg.hasOwnProperty(e.v)) indeg[e.v]=0;
            indeg[e.v]+=1;
            adj[e.u].push(e);
          });

          const times = {};
          nodes.forEach(n=>{ times[n] = NaN; });

          const queue = [];
          nodes.forEach(n=>{
            if (!indeg[n]) {
              queue.push(n);
              times[n] = startTime;
            }
          });

          while(queue.length){
            const u = queue.shift();
            const base = Number.isFinite(times[u]) ? times[u] : startTime;
            const outs = adj[u] || [];
            for (const e of outs){
              const v = e.v;
              const cand = base + e.delay;
              if (!Number.isFinite(times[v]) || cand > times[v]){
                times[v] = cand;
              }
              indeg[v] -= 1;
              if (!indeg[v]) queue.push(v);
            }
          }

          tieInScenarios[sid] = { startTime, times };
          return;
        }

        // Radial timing
        if (!/set\s+Origin\s*\(/.test(block)) return;

        const originMatch = block.match(/set\s+Origin\s*\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
        if (!originMatch) return;

        const origin = { x: parseFloat(originMatch[1]), y: parseFloat(originMatch[2]) };
        const bearing    = grabFloat(block, /set\s+Bearing\s+([-\d.]+)/);
        const startTime  = grabFloat(block, /set\s+StartTime\s+([-\d.]+)/);

        const delayA      = grabFloat(block, /set\s+DelayPerLengthA\s+([\-\d.]+)/);
        const delayBValue = grabFloat(block, /set\s+DelayPerLengthB\s+([\-\d.]+)/);
        const delayB      = delayBValue != null ? delayBValue : delayA;
        const delayMinusA = grabFloat(block, /set\s+DelayPerLengthMinusA\s+([\-\d.]+)/);
        const delayMinusBValue = grabFloat(block, /set\s+DelayPerLengthMinusB\s+([\-\d.]+)/);
        const delayMinusB = delayMinusBValue != null ? delayMinusBValue : delayMinusA;

        const offsetDirValue   = grabFloat(block, /set\s+OffsetInDirection\s+([\-\d.]+)/);
        const offsetDir   = offsetDirValue != null ? offsetDirValue : 0;
        const offsetPerpValue  = grabFloat(block, /set\s+OffsetInPerpendicular\s+([\-\d.]+)/);
        const offsetPerp  = offsetPerpValue != null ? offsetPerpValue : 0;

        const splitMatch = block.match(/set\s+SplitAxisDelays\s+([01])/);
        const splitAxisDelays = splitMatch ? parseInt(splitMatch[1],10) : 0;

        const deckDelays = {};
        const ddMatch = block.match(/set\s+DeckDelayTimes\s*\{([\s\S]*?)\}/);
        if (ddMatch) {
          const lines = ddMatch[1].split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
          for (let i=0;i<lines.length-1;i+=2){
            if (!/^\d+$/.test(lines[i])) continue;
            const holeId = parseInt(lines[i],10);
            const dm = lines[i+1].match(/0\s*,\s*([-\d.]+)/);
            if (!dm) continue;
            deckDelays[holeId] = parseFloat(dm[1]);
          }
        }

        radialParams[sid] = {
          origin,
          bearing,
          startTime,
          delayA,
          delayB,
          delayMinusA,
          delayMinusB,
          offsetDir,
          offsetPerp,
          splitAxisDelays,
          deckDelays
        };
      });

      // ChargeRule: presence/absence of Primers
      const chargeRules = {}; // ruleId -> {name, hasPrimers}
      for (const m of text.matchAll(/node\s+ChargeRule\s+(\d+)/g)){
        const rid = parseInt(m[1],10);
        const blockMatch = text.match(new RegExp("select\\s+"+rid+"\\b([\\s\\S]*?)(?=\\nselect\\s+\\d+|$)"));
        if (!blockMatch) continue;
        const block = blockMatch[0];
        const nameM = block.match(/set\s+Name\s+([^\n]+)/);
        const name = nameM ? nameM[1].trim() : "";
        const hasPrimers = /set\s+Primers\s*\{/.test(block);
        chargeRules[rid] = { name, hasPrimers };
      }

      // HoleChargeRules: nodeId -> ruleId
      const holeChargeRuleMap = {};
      const hcrBlocks = text.match(/set\s+HoleChargeRules\s*\{([\s\S]*?)\}/g) || [];
      hcrBlocks.forEach(block=>{
        const inside = block.replace(/^set\s+HoleChargeRules\s*\{/, '').replace(/\}$/, '');
        const nums = inside.match(/\d+/g) || [];
        for(let i=0;i<nums.length-1;i+=2){
          const holeId = parseInt(nums[i],10);
          const ruleId = parseInt(nums[i+1],10);
          holeChargeRuleMap[holeId] = ruleId;
        }
      });

      // BenchBlastHole nodes
      const holes = {}; // nodeId -> {name,x,y,diam,hasPrimer,chargeRuleName,ntbcReason}
      const benchIds = [];
      for (const mh of text.matchAll(/node\s+BenchBlastHole\s+(\d+)/g)){
        benchIds.push(parseInt(mh[1],10));
      }

      benchIds.forEach(nodeId=>{
        const selRe = new RegExp("select\\s+"+nodeId+"\\b([\\s\\S]*?)(?=\\nselect\\s+\\d+|$)");
        const selMatch = text.match(selRe);
        if (!selMatch) return;
        const body = selMatch[0];

        const nm = body.match(/set\s+Name\s+([^\n\r]+)/);
        const dm = body.match(/set\s+Diameter\s+([-\d.]+)/);
        const bm = body.match(/set\s+Branch\s+([^\n\r]+)/i);
        const name = nm ? nm[1].trim() : String(nodeId);
        const diam = dm ? parseFloat(dm[1]) : NaN;
        const branch = bm ? normalizeBranchValue(bm[1]) : '';

        let X = NaN, Y = NaN;
        if (blastPos[nodeId]) {
          X = blastPos[nodeId].easting;
          Y = blastPos[nodeId].northing;
        } else {
          const tm = body.match(/set\s+Translation\s*\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
          if (tm) {
            // Use parent-chain Translation sums when available (BenchBlastHole often lives under a translated group node).
            const tw = resolveTranslationWorld(text, nodeId);
            X = tw.x;
            Y = tw.z;
          }
        }

        const ruleId = holeChargeRuleMap[nodeId];
        let hasPrimer = true;
        let chargeRuleName = "";
        let ntbcReason = "";
        if (ruleId != null && chargeRules[ruleId]) {
          const info = chargeRules[ruleId];
          chargeRuleName = info.name;
          if (!info.hasPrimers) {
            hasPrimer = false;
            ntbcReason = "ChargeRule has no Primers block";
          }
        }

        holes[nodeId] = {
          name,
          x: X, y: Y,
          diam,
          branch,
          hasPrimer,
          chargeRuleName,
          ntbcReason
        };
      });

      // Raw times for radial scenarios
      const rawByScenario = {};
      const holeRaw = {};

      for (const nodeIdStr of Object.keys(holes)) {
        const nodeId = parseInt(nodeIdStr,10);
        const h = holes[nodeId];
        if (!h.hasPrimer) continue;

        const scenId = holeScenarioMap[nodeId];
        if (!scenId) continue;

        const rp = radialParams[scenId];
        if (!rp) continue; // non-radial (fixed tie-in) handled separately

        // Choose coordinates for radial timing
        let xLocal, yLocal;
        if (blastOrigin && blastPos[nodeId]) {
          xLocal = blastPos[nodeId].easting  - blastOrigin.x;
          yLocal = blastPos[nodeId].northing - blastOrigin.z;
        } else {
          xLocal = h.x;
          yLocal = h.y;
        }

        const dx = xLocal - rp.origin.x;
        const dy = yLocal - rp.origin.y;

        const ax = Math.cos(rp.bearing);
        const ay = Math.sin(rp.bearing);
        const bx = -ay;
        const by =  ax;

        const dA = dx*ax + dy*ay;
        const dB = dx*bx + dy*by;

        const lenA = Math.max(0, Math.abs(dA));
        const lenB = Math.max(0, Math.abs(dB));

        const gradA = rp.splitAxisDelays ? (dA>=0 ? rp.delayA : rp.delayMinusA) : rp.delayA;
        const gradB = rp.splitAxisDelays ? (dB>=0 ? rp.delayB : rp.delayMinusB) : rp.delayB;

        const reliefDelay = gradA*lenA + gradB*lenB;

        const axisOffsetMs =
          (dA >= 0 ? rp.offsetDir  : 0) +
          (dB >= 0 ? rp.offsetPerp : 0);

        const deckDelay = rp.deckDelays[nodeId] != null ? rp.deckDelays[nodeId] : 0;

        const raw = reliefDelay + axisOffsetMs + deckDelay;

        if (!rawByScenario[scenId]) rawByScenario[scenId] = [];
        rawByScenario[scenId].push({nodeId, raw});
        holeRaw[nodeId] = raw;
      }

      const minRaw = {};
      for (const sid of Object.keys(rawByScenario)) {
        const arr = rawByScenario[sid];
        let min = Infinity;
        for (const o of arr) if (o.raw < min) min = o.raw;
        minRaw[sid] = isFinite(min) ? min : 0;
      }
      // Build AoA with final times (radial OR fixed per-hole), including primer metadata.
      // IMPORTANT: include NodeId so duplicate hole names remain distinguishable (e.g., joined patterns).
      const aoa = [];
      aoa.push(["NodeId","Hole #","X","Y","Time","Diameter","ChargeRule","HasPrimer","Branch","NTBCReason"]);

      for (const nodeIdStr of Object.keys(holes)) {
        const nodeId = parseInt(nodeIdStr,10);
        const h = holes[nodeId];
        const scenId = holeScenarioMap[nodeId];

        let finalTime = "";

        if (h.hasPrimer && scenId != null) {
          if (radialParams[scenId] && holeRaw[nodeId] != null && minRaw[scenId] != null) {
            const rp = radialParams[scenId];
            finalTime = (holeRaw[nodeId] - minRaw[scenId]) + (rp.startTime || 0);
          } else if (tieInScenarios[scenId] && tieInScenarios[scenId].times[nodeId] != null) {
            const t = tieInScenarios[scenId].times[nodeId];
            if (Number.isFinite(t)) finalTime = t;
          }
        }

        aoa.push([
          nodeId,
          h.name,
          h.x,
          h.y,
          finalTime,
          h.diam,
          h.chargeRuleName || "",
          h.hasPrimer ? "Yes" : "No",
          h.branch || "",
          h.ntbcReason || ""
        ]);
      }

      return aoa;
    }


    // ---------- BLST extended parsing for vibration ----------
    function getSelectBlock(text, id){
      const re = new RegExp("select\\s+" + id + "\\b([\\s\\S]*?)(?=\\nselect\\s+\\d+|$)");
      const m = text.match(re);
      return m ? m[0] : null;
    }


    // Resolve world Translation by summing this node's Translation plus all ancestor Translations (via "parent <id> <idx>").
    // Needed for some BLST exports (e.g., BenchBlastHole) where hole Translation is stored relative to a translated group node.
    function resolveTranslationWorld(text, id){
      const blockCache = resolveTranslationWorld._blockCache || (resolveTranslationWorld._blockCache = new Map());
      const transCache  = resolveTranslationWorld._transCache  || (resolveTranslationWorld._transCache  = new Map());
      const parentCache = resolveTranslationWorld._parentCache || (resolveTranslationWorld._parentCache = new Map());

      function getBlock(sid){
        if(blockCache.has(sid)) return blockCache.get(sid);
        const blk = getSelectBlock(text, sid);
        blockCache.set(sid, blk);
        return blk;
      }

      function getLocalTrans(sid){
        if(transCache.has(sid)) return transCache.get(sid);
        const blk = getBlock(sid);
        if(!blk){ transCache.set(sid, null); return null; }
        const m = blk.match(/set\s+Translation\s*\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
        const t = m ? {x: parseFloat(m[1]), y: parseFloat(m[2]), z: parseFloat(m[3])} : null;
        transCache.set(sid, t);
        return t;
      }

      function getParent(sid){
        if(parentCache.has(sid)) return parentCache.get(sid);
        const blk = getBlock(sid);
        if(!blk){ parentCache.set(sid, null); return null; }
        const m = blk.match(/parent\s+(\d+)\s+\d+/);
        const p = m ? parseInt(m[1],10) : null;
        parentCache.set(sid, p);
        return p;
      }

      let x=0,y=0,z=0;
      let cur = id;
      let guard=0;
      while(cur != null && guard++ < 60){
        const t = getLocalTrans(cur);
        if(t){ x += t.x; y += t.y; z += t.z; }
        cur = getParent(cur);
      }
      return {x,y,z};
    }

    function parseExplosiveTypes(text){
      const explosives = {};
      const re = /node\s+ExplosiveType\s+(\d+)/g;
      let m;
      while((m = re.exec(text)) !== null){
        const id = m[1];
        const block = getSelectBlock(text, id);
        if(!block) continue;
        const nameM = block.match(/set\s+Name\s+([^\n]+)/);
        const densM = block.match(/set\s+Density\s+([0-9.+\-Ee]+)/);
        explosives[id] = {
          id,
          name: nameM ? nameM[1].trim() : id,
          density: densM ? parseFloat(densM[1]) : null
        };
      }
      return explosives;
    }

    function parseChargeRulesAndSections(text){
      const chargeRules = {};
      const sectionRules = {};
      const sectionIds = new Set();

      const crRe = /node\s+ChargeRule\s+(\d+)/g;
      let m;
      while((m = crRe.exec(text)) !== null){
        const id = m[1];
        const block = getSelectBlock(text, id);
        if(!block) continue;
        const nameM = block.match(/set\s+Name\s+([^\n]+)/);
        const secM  = block.match(/set\s+SectionRules\s*\{([\s\S]*?)\}/);
        const hasPrimers = /set\s+Primers\s*\{/.test(block);

        const sections = [];
        if(secM){
          const nums = secM[1].match(/\d+/g) || [];
          nums.forEach(n=>{ sections.push(n); sectionIds.add(n); });
        }

        chargeRules[id] = { id, name: nameM ? nameM[1].trim() : id, sections, hasPrimers };
      }

      // Section rules (with ReferenceSection inheritance)
      sectionIds.forEach(sid=>{
        const block = getSelectBlock(text, sid);
        if(!block) return;
        const get = (re) => {
          const mm = block.match(re);
          return mm ? mm[1] : null;
        };

        sectionRules[sid] = {
          id: sid,
          name: get(/set\s+Name\s+([^\n]+)/),
          type: (get(/set\s+Type\s+(\d+)/) != null) ? parseInt(get(/set\s+Type\s+(\d+)/),10) : null,
          materialType: get(/set\s+Type\s+([^\n]+)/),
          length_mm: (get(/set\s+Length\s+([0-9.+\-Ee]+)/) != null) ? parseFloat(get(/set\s+Length\s+([0-9.+\-Ee]+)/)) : null,
          explosiveType: get(/set\s+ExplosiveType\s+(\d+)/),
          weight_g: (get(/set\s+Weight\s+([0-9.+\-Ee]+)/) != null) ? parseFloat(get(/set\s+Weight\s+([0-9.+\-Ee]+)/)) : null,
          percentage: (get(/set\s+Percentage\s+([0-9.+\-Ee]+)/) != null) ? parseFloat(get(/set\s+Percentage\s+([0-9.+\-Ee]+)/)) : null,
          referenceSection: get(/set\s+ReferenceSection\s+(\d+)/)
        };
      });

      let changed = true;
      while(changed){
        changed = false;
        Object.values(sectionRules).forEach(s=>{
          const ref = s.referenceSection;
          if(!ref || !sectionRules[ref]) return;
          const base = sectionRules[ref];
          ["name","type","materialType","length_mm","explosiveType","weight_g","percentage"].forEach(k=>{
            if((s[k] === null || s[k] === undefined) && base[k] !== null && base[k] !== undefined){
              s[k] = base[k];
              changed = true;
            }
          });
        });
      }

      return {chargeRules, sectionRules};
    }

    function parseHoleChargeRules(text, chargeRules){
      const map = {};
      const re = /set\s+HoleChargeRules\s*\{([\s\S]*?)\}/g;
      let m;
      while((m = re.exec(text)) !== null){
        const nums = m[1].match(/\d+/g) || [];
        for(let i=0;i+1<nums.length;i+=2){
          const holeId = parseInt(nums[i],10);
          const ruleId = nums[i+1];
          if(chargeRules[ruleId]) map[holeId] = ruleId;
        }
      }
      return map;
    }

    
    function parseRioChargeSettings(text){
      // Returns {minChargeLength_m, minStemLength_m, chargeIncrement_kg?} if present. Units in BLST are typically mm for lengths.
      // If multiple nodes exist, returns the first encountered.
      const re = /select\s+(\d+)\b([\s\S]*?)(?=\nselect\s+\d+|$)/g;
      let m;
      while((m = re.exec(text)) !== null){
        const block = m[0];
        // Heuristic: Rio charge settings blocks include MinChargeLength/MinStemLength/ChargeIncrement
        if(!/set\s+MinChargeLength\s+/.test(block) && !/set\s+MinStemLength\s+/.test(block)) continue;
        const minC = block.match(/set\s+MinChargeLength\s+([-\d.]+)/);
        const minS = block.match(/set\s+MinStemLength\s+([-\d.]+)/);
        const inc  = block.match(/set\s+ChargeIncrement\s+([-\d.]+)/);
        const out = {};
        if(minC) out.minChargeLength_m = parseFloat(minC[1]) / 1000.0;
        if(minS) out.minStemLength_m = parseFloat(minS[1]) / 1000.0;
        if(inc)  out.chargeIncrement = parseFloat(inc[1]); // unit not guaranteed
        return out;
      }
      return {};
    }

    function parseBenchBlastHolesWithLength(text){
      function rotateVecByQuat(v, q){
        if(!Array.isArray(v) || v.length < 3) return [0,0,0];
        if(!Array.isArray(q) || q.length < 4) return [v[0], v[1], v[2]];

        let qx = Number(q[0]), qy = Number(q[1]), qz = Number(q[2]), qw = Number(q[3]);
        if(!Number.isFinite(qx) || !Number.isFinite(qy) || !Number.isFinite(qz) || !Number.isFinite(qw)){
          return [v[0], v[1], v[2]];
        }

        const qn = Math.sqrt(qx*qx + qy*qy + qz*qz + qw*qw);
        if(!(qn > 0)) return [v[0], v[1], v[2]];
        qx /= qn; qy /= qn; qz /= qn; qw /= qn;

        const vx = Number(v[0]) || 0;
        const vy = Number(v[1]) || 0;
        const vz = Number(v[2]) || 0;

        const ux = qx, uy = qy, uz = qz;
        const dotUV = ux*vx + uy*vy + uz*vz;
        const dotUU = ux*ux + uy*uy + uz*uz;
        const cx = uy*vz - uz*vy;
        const cy = uz*vx - ux*vz;
        const cz = ux*vy - uy*vx;

        return [
          2*dotUV*ux + (qw*qw - dotUU)*vx + 2*qw*cx,
          2*dotUV*uy + (qw*qw - dotUU)*vy + 2*qw*cy,
          2*dotUV*uz + (qw*qw - dotUU)*vz + 2*qw*cz
        ];
      }

      const holes = {};
      const re = /node\s+BenchBlastHole\s+(\d+)/g;
      let m;
      while((m = re.exec(text)) !== null){
        const nodeId = parseInt(m[1],10);
        const block = getSelectBlock(text, nodeId);
        if(!block) continue;

        const nameM = block.match(/set\s+Name\s+([^\n]+)/);
        const diamM = block.match(/set\s+Diameter\s+([0-9.+\-Ee]+)/);
        const branchM = block.match(/set\s+Branch\s+([^\n\r]+)/i);
        const bearingM = block.match(/set\s+Bearing\s+([0-9.+\-Ee]+)/);
        const rotM = block.match(/set\s+Rotation\s*\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
        const ptsM  = block.match(/set\s+points\s*\{\s*([\s\S]*?)\}/);

        let length = 0;
        let lastPoint = null;
        if(ptsM){
          const inner = ptsM[1];
          const ptRe = /\(\s*([\-0-9.]+)\s*,\s*([\-0-9.]+)\s*,\s*([\-0-9.]+)\s*\)/g;
          let pm;
          let prev = [0,0,0]; // IMPORTANT: include segment from origin to first point (matches Blast Parser logic)
          while((pm = ptRe.exec(inner)) !== null){
            const x = parseFloat(pm[1]);
            const y = parseFloat(pm[2]);
            const z = parseFloat(pm[3]);
            const dx = x - prev[0];
            const dy = y - prev[1];
            const dz = z - prev[2];
            length += Math.sqrt(dx*dx + dy*dy + dz*dz);
            lastPoint = [x,y,z];
            prev = [x,y,z];
          }
        }

        const toeOffsetLocal = lastPoint || [0,0,0];
        const q = rotM ? [parseFloat(rotM[1]), parseFloat(rotM[2]), parseFloat(rotM[3]), parseFloat(rotM[4])] : null;
        const toeOffset = rotateVecByQuat(toeOffsetLocal, q);

        let bearingDeg = bearingM ? parseFloat(bearingM[1]) : NaN;
        if(!Number.isFinite(bearingDeg)){
          const dx = toeOffset[0];
          const dy = toeOffset[2];
          const horiz = Math.sqrt(dx*dx + dy*dy);
          if(horiz > 1e-9){
            bearingDeg = Math.atan2(dx, dy) * 180 / Math.PI;
            if(bearingDeg < 0) bearingDeg += 360;
          }
        }

        holes[nodeId] = {
          nodeId,
          name: nameM ? nameM[1].trim() : String(nodeId),
          branch: branchM ? normalizeBranchValue(branchM[1]) : '',
          diameter_mm: diamM ? parseFloat(diamM[1]) : NaN,
          length_m: length,
          bearing_deg: bearingDeg,
          toe_offset_x: toeOffset[0],
          toe_offset_y: toeOffset[1],
          toe_offset_z: toeOffset[2]
        };
      }
      return holes;
    }

    function computeChargeForHole(holeGeom, nodeId, holeChargeRules, chargeRules, sectionRules, explosives){
      const crId = holeChargeRules[nodeId];
      if(!crId) return {mass:0, ruleName:"", hasPrimer:true};
      const cr = chargeRules[crId];
      const L = holeGeom.length_m;
      const d_mm = holeGeom.diameter_mm;
      if(!isFinite(L) || !isFinite(d_mm)) return {mass:0, ruleName:cr.name || "", hasPrimer: cr.hasPrimers !== false};

      const d = d_mm / 1000;
      const area = Math.PI * d * d / 4;

      const secs = cr.sections.map(id => sectionRules[id]).filter(Boolean);
      const hasWeight = secs.some(s => s.weight_g != null);

      if(hasWeight){
        let mass = 0;
        secs.forEach(s => {
          if(s.weight_g != null) mass += s.weight_g / 1000.0;
        });
        return {mass, ruleName:cr.name || "", hasPrimer: cr.hasPrimers !== false};
      }

      let fixedInertLen = 0;
      let fixedExplLen = 0;
      let percInert = 0;
      let percExpl = 0;
      let mass = 0;
      const varExplSections = [];

      secs.forEach(s => {
        const e = s.explosiveType;
        const len_m = s.length_mm != null ? s.length_mm / 1000.0 : 0;
        const pct = s.percentage != null ? s.percentage : null;
        const isExplosive = isExplosiveSection(s, explosives);

        if(isExplosive && e){
          const ex = explosives[e];
          const rho = ex && ex.density != null ? ex.density : 0;
          if(pct != null){
            mass += rho * area * (L * pct);
            percExpl += pct;
          } else if(len_m > 0){
            mass += rho * area * len_m;
            fixedExplLen += len_m;
          } else {
            varExplSections.push(s);
          }
        } else {
          if(pct != null){
            percInert += pct;
          } else if(len_m > 0){
            fixedInertLen += len_m;
          }
        }
      });

      let remaining = L * Math.max(0, 1 - percInert - percExpl) - fixedInertLen - fixedExplLen;
      if(remaining < 0) remaining = 0;

      varExplSections.forEach(s => {
        const ex = explosives[s.explosiveType];
        if(!ex || ex.density == null) return;
        const rho = ex.density;
        mass += rho * area * remaining;
      });

      return {mass, ruleName:cr.name || "", hasPrimer: cr.hasPrimers !== false};
    }

    function isNonExplosiveMaterial(name){
      const s = String(name != null ? name : '').trim().toLowerCase();
      return /\b(?:stemming|air)\b/i.test(s);
    }

    function normalizeSectionMaterialKind(value){
      const text = String(value != null ? value : '').trim().toLowerCase();
      if(!text) return '';
      if(text === '0') return 'explosive';
      if(text === '1') return 'air';
      if(text === '3') return 'stemming';
      if(/\bair\b/.test(text)) return 'air';
      if(/\bstemming\b/.test(text)) return 'stemming';
      if(/\bexplosives?\b/.test(text)) return 'explosive';
      return text;
    }

    function getSectionMaterialKind(section, explosives){
      if(!section) return '';

      const normalizedType = normalizeSectionMaterialKind(section.type != null ? section.type : section.materialType);
      if(normalizedType) return normalizedType;

      const sectionName = String(section.name != null ? section.name : '').trim();
      if(sectionName && isNonExplosiveMaterial(sectionName)){
        return /\bair\b/i.test(sectionName) ? 'air' : 'stemming';
      }

      const explosiveId = section.explosiveType != null ? String(section.explosiveType) : '';
      const explosive = explosiveId && explosives ? explosives[explosiveId] : null;
      const explosiveName = String((explosive && explosive.name) || '').trim();
      if(explosiveName) return explosiveName;

      return sectionName;
    }

    function isInertSection(section, explosives){
      const kind = getSectionMaterialKind(section, explosives);
      return kind === 'air' || kind === 'stemming';
    }

    function isExplosiveSection(section, explosives){
      return !isInertSection(section, explosives);
    }

    function computeExplosiveLengthForHole(holeGeom, nodeId, holeChargeRules, chargeRules, sectionRules){
      const crId = holeChargeRules[nodeId];
      if(!crId) return {explosiveLength_m: 0};
      const cr = chargeRules[crId];
      if(!cr) return {explosiveLength_m: 0};

      const L = Number(holeGeom && holeGeom.length_m);
      if(!Number.isFinite(L) || L <= 0) return {explosiveLength_m: 0};

      const secs = (cr.sections || []).map(id => sectionRules[id]).filter(Boolean);
      if(!secs.length) return {explosiveLength_m: 0};

      let fixedExplLen = 0;
      let fixedInertLen = 0;
      let pctExpl = 0;
      let pctInert = 0;
      let varExpl = 0;
      let varInert = 0;

      secs.forEach(s=>{
        const len_m = Number.isFinite(s.length_mm) ? (s.length_mm / 1000.0) : 0;
        const pct = Number.isFinite(s.percentage) ? s.percentage : null;
        const isExplosive = isExplosiveSection(s, null);

        if(pct != null){
          if(isExplosive) pctExpl += pct;
          else pctInert += pct;
          return;
        }

        if(len_m > 0){
          if(isExplosive) fixedExplLen += len_m;
          else fixedInertLen += len_m;
          return;
        }

        if(isExplosive) varExpl += 1;
        else varInert += 1;
      });

      let remaining = L - fixedExplLen - fixedInertLen - (L * pctExpl) - (L * pctInert);
      if(remaining < 0) remaining = 0;

      let explosiveLength_m = fixedExplLen + (L * Math.max(0, pctExpl));
      if(varExpl > 0){
        if(varInert === 0) explosiveLength_m += remaining;
        else explosiveLength_m += remaining * (varExpl / (varExpl + varInert));
      }

      if(explosiveLength_m < 0) explosiveLength_m = 0;
      if(explosiveLength_m > L) explosiveLength_m = L;
      return {explosiveLength_m};
    }



    function parseVibrationSettingsNodes(text){
      const out = [];
      const re = /select\s+(\d+)\b([\s\S]*?)(?=\nselect\s+\d+|$)/g;
      let m;
      while((m = re.exec(text)) !== null){
        const id = parseInt(m[1],10);
        const block = m[0];
        if(!/set\s+Algorithm\s+/.test(block)) continue;
        if(!/set\s+WindowingConstant\s+/.test(block)) continue;
        if(!/set\s+InitialPulseWidth\s+/.test(block)) continue;
        const nameM = block.match(/set\s+Name\s+([^\n]+)/);
        const K = block.match(/set\s+K\s+([-\d.]+)/);
        const n = block.match(/set\s+n\s+([-\d.]+)/);
        const alg = block.match(/set\s+Algorithm\s+([-\d.]+)/);
        const T0 = block.match(/set\s+InitialPulseWidth\s+([-\d.]+)/);
        const alpha = block.match(/set\s+PulseBroadeningRate\s+([-\d.]+)/);
        const Cw = block.match(/set\s+WindowingConstant\s+([-\d.]+)/);
        const screen = block.match(/set\s+ScreenCoef\s+([-\d.]+)/);
        const conf = block.match(/set\s+Confidence\s+([-\d.]+)/);
        const se = block.match(/set\s+StdErr\s+([-\d.]+)/);

        if(!K || !n) continue;

        out.push({
          id,
          name: nameM ? nameM[1].trim() : String(id),
          algorithmCode: alg ? parseInt(parseFloat(alg[1]),10) : null,
          K: parseFloat(K[1]),
          n: parseFloat(n[1]),
          T0: T0 ? parseFloat(T0[1]) : 10,
          alpha: alpha ? parseFloat(alpha[1]) : 0,
          Cw: Cw ? parseFloat(Cw[1]) : 21.5,
          screen: screen ? parseFloat(screen[1]) : 1,
          confidence: conf ? parseFloat(conf[1]) : null,
          stdErr: se ? parseFloat(se[1]) : null
        });
      }
      return out;
    }

    function parseMonitoringPoints(text, blastOrigin){
  // Returns a unified list of "receiver-like" points:
  // - Receiver nodes (PPV limits / monitor locations)
  // - POIs (e.g., sensitive sites) represented as LineGeometryNode + PolyShapeNode polygons
  //
  // Coordinates are returned in the same XY plane used everywhere else in this tool:
  //   X = Translation.x (or point.x)
  //   Y = Translation.z (or point.z)
  //
  // If blastOrigin exists and the rest of the tool is operating in "local" coordinates,
  // we shift points by subtracting BlastOrigin (X=easting, Y=northing).
  const points = [];

  // Build node type map from "node <Type> <Id>" lines.
  const typeById = {};
  const nodeRe = /^node\s+([A-Za-z0-9_]+)\s+(\d+)\s*$/gm;
  let nm;
  while((nm = nodeRe.exec(text)) !== null){
    typeById[parseInt(nm[2],10)] = nm[1];
  }

  // Parse select blocks once; cache key fields for parent/translation/items, and gather poly centroids.
  const parentById = {};
  const trById = {};
  const nameById = {};
  const colourById = {};
  const visibleById = {};
  const itemTypeById = {};
  const notesById = {};
  const ppvMaxById = {};
  const polysById = {};      // LineGeometryNode -> [polyIds]
  const polyCentroid = {};   // PolyShapeNode -> {x,z}

  const re = /select\s+(\d+)\b([\s\S]*?)(?=\nselect\s+\d+|$)/g;
  let m;
  while((m = re.exec(text)) !== null){
    const id = parseInt(m[1],10);
    const block = m[0];

    // parent
    const pM = block.match(/parent\s+(\d+)\s+\d+/);
    if(pM) parentById[id] = parseInt(pM[1],10);

    // name
    const nM = block.match(/set\s+Name\s+([^\n\r]+)/);
    if(nM) nameById[id] = nM[1].trim();

    // translation
    const tM = block.match(/set\s+Translation\s*\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
    if(tM){
      trById[id] = {x: parseFloat(tM[1]), y: parseFloat(tM[2]), z: parseFloat(tM[3])};
    }

    // colour
    const cM = block.match(/set\s+Colour\s*\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)/);
    if(cM) colourById[id] = [parseInt(cM[1],10), parseInt(cM[2],10), parseInt(cM[3],10)];

    // visible
    const vM = block.match(/set\s+Visible\s+([01])/);
    if(vM) visibleById[id] = (vM[1] === "1");

    // item type
    const itM = block.match(/set\s+_rt__ItemType\s+(\d+)/);
    if(itM) itemTypeById[id] = parseInt(itM[1],10);

    // notes
    const noM = block.match(/set\s+Notes\s+([^\n\r]+)/);
    if(noM) notesById[id] = noM[1].trim();

    // ppv limit (m/s)
    const ppvM = block.match(/set\s+_ppvMax\s+([-\d.]+)/);
    if(ppvM) ppvMaxById[id] = parseFloat(ppvM[1]);

    // LineGeometry polys
    if(/\bset\s+Polys\s*\{/.test(block)){
      const polyIds = [];
      const polySection = block.match(/set\s+Polys\s*\{([\s\S]*?)\}/);
      if(polySection){
        const ids = polySection[1].match(/\b\d+\b/g);
        if(ids){
          ids.forEach(s=>polyIds.push(parseInt(s,10)));
        }
      }
      if(polyIds.length) polysById[id] = polyIds;
    }

    // PolyShapeNode centroid
    const typ = typeById[id] || "";
    if(typ === "PolyShapeNode" && /\bset\s+Points\s*\{/.test(block)){
      const ptsSection = block.match(/set\s+Points\s*\{([\s\S]*?)\}/);
      if(ptsSection){
        const pts = [];
        const ptRe = /\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/g;
        let pm;
        while((pm = ptRe.exec(ptsSection[1])) !== null){
          pts.push({x: parseFloat(pm[1]), y: parseFloat(pm[2]), z: parseFloat(pm[3])});
        }
        if(pts.length){
          let sx=0, sz=0;
          pts.forEach(p=>{sx+=p.x; sz+=p.z;});
          polyCentroid[id] = {x: sx/pts.length, z: sz/pts.length};
        }
      }
    }
  }

  function resolveTranslationWorld(id){
    // Sum translations up the parent chain (if present).
    // If an ancestor lacks Translation, it contributes (0,0,0).
    let x=0, y=0, z=0;
    let cur=id;
    let guard=0;
    while(cur != null && guard < 50){
      const t = trById[cur];
      if(t){ x += t.x; y += t.y; z += t.z; }
      cur = parentById[cur];
      guard++;
    }
    return {x,y,z};
  }

  function applyBlastOriginShift(x, z){
    // Coordinate systems vary between BLST exports. This tool uses the same XY frame as parsed holes.
    // All receiver / POI coordinates are already resolved via the parent-chain Translation sums.
    return {X: x, Y: z};
  }
    // 1) Receiver nodes: include even if "not ticked", because their enabled/visible styles vary by design.
  Object.keys(ppvMaxById).forEach(k=>{
    const id = parseInt(k,10);
    const typ = typeById[id] || "";
    if(typ !== "Receiver" && !/set\s+_ppvMax\s+/.test("set _ppvMax " + ppvMaxById[id])) {
      // ppvMaxById implies _ppvMax was present; keep this only for clarity.
    }

    const nm = nameById[id] || ("Receiver " + id);
    const col = colourById[id] || null;
    const vis = (id in visibleById) ? visibleById[id] : null;
    const ppvMax = ppvMaxById[id];

    // Use world translation (parent chain) when available.
    const tw = resolveTranslationWorld(id);
    const xy = applyBlastOriginShift(tw.x, tw.z);

    // Enabled heuristic:
    // - Receivers are treated as enabled by default (designs vary in colour/visible flags).
    // - Keep the existing "green-dominant" / visible cues as additional indicators.
    let enabled = true;
    if(vis === true) enabled = true;
    if(col && col[1] >= 200 && col[1] >= col[0] && col[1] >= col[2]) enabled = true;

    points.push({
      id,
