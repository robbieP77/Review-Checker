// --- Match diagnostics modal ---
function formatMatchDiag(d){
  if(!d) return 'No diagnostics available. Load a BLST and a timing CSV, then Run check.';
  const lines = [];
  const dupCount = (d.blstDuplicateNames && d.blstDuplicateNames.length) ? d.blstDuplicateNames.length : 0;

  // Newer (nodeId-aware) fields
  if(d.csvRowCount != null || d.unresolvedAssignments != null){
    lines.push(`BLST holes (instances): ${d.blstHoleCount}`);
    lines.push(`BLST unique names: ${d.blstUniqueNameCount}` + (dupCount ? `; duplicate names: ${dupCount}` : ''));
    lines.push(`CSV rows: ${d.csvRowCount}`);
    lines.push(`CSV unique names: ${d.csvUniqueNameCount}`);
    lines.push(`Assigned: ${d.matched}`);
    lines.push(`Ambiguous groups: ${d.ambiguous}`);
    lines.push(`Unresolved assignments: ${d.unresolvedAssignments}`);
    lines.push(`CSV rows not found in BLST (examples): ${d.csvUnmatchedInBlst}`);
    lines.push('');
    if(d.blstDuplicateNames && d.blstDuplicateNames.length){
      lines.push('BLST duplicate names (first 50):');
      d.blstDuplicateNames.slice(0,50).forEach(x=>lines.push(`  - ${x.name}: ${x.count}`));
      if(d.blstDuplicateNames.length>50) lines.push(`  ... (+${d.blstDuplicateNames.length-50} more)`);
      lines.push('');
    }
    if(d.examples){
      if(d.examples.unresolved && d.examples.unresolved.length){
        lines.push('Examples - unresolved hole instances (first 50):');
        d.examples.unresolved.slice(0,50).forEach(x=>lines.push('  - ' + x));
        lines.push('');
      }
      if(d.examples.ambiguous && d.examples.ambiguous.length){
        lines.push('Examples - ambiguous groups (first 50):');
        d.examples.ambiguous.slice(0,50).forEach(x=>{
          if(typeof x === 'string') lines.push('  - ' + x);
          else lines.push(`  - ${x.blst}  ->  ${x.candidates.join(', ')}`);
        });
        lines.push('');
      }
      if(d.examples.csvUnmatchedInBlst && d.examples.csvUnmatchedInBlst.length){
        lines.push('Examples - CSV not found in BLST (first 50):');
        d.examples.csvUnmatchedInBlst.slice(0,50).forEach(x=>lines.push('  - ' + x));
        lines.push('');
      }
    }
  } else {
    // Legacy fields
    lines.push(`BLST holes: ${d.blstHoleCount}`);
    lines.push(`CSV holes (unique): ${d.csvHoleCount}`);
    lines.push(`Matched (at least one candidate): ${d.matched}`);
    lines.push(`Ambiguous matches (multiple CSV candidates): ${d.ambiguous}`);
    lines.push(`Missing in CSV: ${d.missingInCsv}`);
    lines.push(`CSV holes not found in BLST: ${d.csvUnmatchedInBlst}`);
    lines.push('');
    if(d.examples){
      if(d.examples.missingInCsv && d.examples.missingInCsv.length){
        lines.push('Examples - missing in CSV (first 50):');
        d.examples.missingInCsv.forEach(x=>lines.push('  - ' + x));
        lines.push('');
      }
      if(d.examples.ambiguous && d.examples.ambiguous.length){
        lines.push('Examples - ambiguous (first 50):');
        d.examples.ambiguous.forEach(x=>lines.push(`  - ${x.blst}  ->  ${x.candidates.join(', ')}`));
        lines.push('');
      }
      if(d.examples.csvUnmatchedInBlst && d.examples.csvUnmatchedInBlst.length){
        lines.push('Examples - CSV not found in BLST (first 50):');
        d.examples.csvUnmatchedInBlst.forEach(x=>lines.push('  - ' + x));
        lines.push('');
      }
    }
  }

  if(d.csvDuplicates){
    const dup = d.csvDuplicates;
    if(dup.repeatedHoleRows && dup.repeatedHoleRows.length){
      lines.push(`CSV repeated hole rows: ${dup.repeatedHoleRows.length}`);
      dup.repeatedHoleRows.slice(0,50).forEach(x=>lines.push(`  - ${x.hole}: first row ${x.firstRow}, other row ${x.otherRow}`));
      if(dup.repeatedHoleRows.length>50) lines.push(`  ... (+${dup.repeatedHoleRows.length-50} more)`);
      lines.push('');
    }
    if(dup.variantCollisions && dup.variantCollisions.length){
      lines.push(`CSV variant collisions: ${dup.variantCollisions.length}`);
      dup.variantCollisions.slice(0,50).forEach(x=>lines.push(`  - ${x.variant}: ${x.holes.join(', ')}`));
      if(dup.variantCollisions.length>50) lines.push(`  ... (+${dup.variantCollisions.length-50} more)`);
      lines.push('');
    }
  }

  return lines.join('\n');
}

