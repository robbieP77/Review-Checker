        return total + (lines.length * sectionTextLineH) + sectionRowGap;
      }, 0);
      const summaryCardH = 12 + summaryTitleH + (summaryItems.length * summaryRowH) + 12;
      const sectionContentH = sectionRuleHeadingRows.length ? sectionRowsHeight : sectionTextLineH;
      const sectionCardH = 12 + sectionTitleH + sectionContentH + 12;
      const columnsH = Math.max(summaryCardH, sectionCardH);
