    function exportBLSTConflictsRemoved(){
      const hasCsv = !!(window.csvTimes && Object.keys(window.csvTimes).length);
      if(!hasCsv){
        alert('Upload a detonation-time CSV first. BLST export uses CSV detonation times.');
        return;
      }
      if(!(window.blstTextOriginal && window.blstExportInfo)){
        alert('BLST design not loaded.');
        return;
      }
      if(!window.blstExportInfo.ok){
        alert('BLST export preflight failed: ' + (window.blstExportInfo.reason || 'unknown reason'));
        return;
      }

      const adjustedAny = !!(window.pts && window.pts.some(p=>p && p.hasPrimer && Number.isFinite(p.adj)));
      if(!adjustedAny){
        alert('No adjusted times were set. BLST export only applies adjusted times (it does not auto-edit timing without adjustments).');
        return;
      }

      // Warn if matching diagnostics show ambiguity
      if(window.csvMatchDiag && ((window.csvMatchDiag.ambiguous > 0) || (window.csvMatchDiag.unresolvedAssignments > 0))){
        const msg = 'Warning: some BLST holes match multiple CSV hole names (ambiguous matching). Review "match details" before exporting.\n\nContinue anyway?';
        if(!confirm(msg)) return;
      }

      const info = window.blstExportInfo;

      // Copy scenario deck maps so repeated exports are deterministic
      const scenarioDeck = new Map();
      for(const [sid, deck] of info.scenarioDeck.entries()){
        scenarioDeck.set(sid, { hasBlock: deck.hasBlock, order: deck.order.slice(), map: new Map(deck.map) });
      }

      const modifiedScenarioIds = new Set();
      const missing = [];
      const skipped = [];

      // Apply deltas for any hole with an adjusted time.
      for(const p of (window.pts || [])){
        if(!p || !p.hasPrimer) continue;
        if(!Number.isFinite(p.time) || !Number.isFinite(p.adj)) continue;
        const delta = Number(p.adj) - Number(p.time);
        if(!Number.isFinite(delta) || Math.abs(delta) < 1e-9) continue;

        const holeName = String(p.hole || '').trim();
        if(!holeName){ skipped.push('(blank hole name)'); continue; }

        // Prefer NodeId from BLST rows (supports duplicate hole names).
        let holeId = (p.nodeId != null && Number.isFinite(p.nodeId)) ? p.nodeId : null;

        // Fallback: only allow name-based lookup when the name is unique in the BLST.
        if(holeId == null){
          if(info.holeIdsByName && info.holeIdsByName.has(holeName)){
            const ids = info.holeIdsByName.get(holeName) || [];
            if(ids.length === 1) holeId = ids[0];
            else { missing.push(holeName + ' (ambiguous name)'); continue; }
          } else {
            const tmp = info.holeIdByName && info.holeIdByName.get(holeName);
            if(tmp != null) holeId = tmp;
          }
        }

        if(holeId == null){ missing.push(holeName); continue; }

        const scenarioId = info.holeScenario.get(holeId);
        if(scenarioId == null){ missing.push(holeName); continue; }

        const deck = scenarioDeck.get(scenarioId) || { hasBlock:false, order:[], map:new Map() };
        const current = deck.map.has(holeId) ? Number(deck.map.get(holeId)) : 0;
        const next = current + delta;
        if(!deck.map.has(holeId)) deck.order.push(holeId);
        deck.map.set(holeId, next);
        scenarioDeck.set(scenarioId, deck);
        modifiedScenarioIds.add(scenarioId);
      }

      if(skipped.length){
        alert('Some adjusted entries were skipped:\n' + skipped.slice(0,50).join(', ') + (skipped.length>50?` ... (+${skipped.length-50} more)`:''));
      }
      if(missing.length){
        alert('Some adjusted holes were not found in the BLST (skipped):\n' + missing.slice(0,50).join(', ') + (missing.length>50?` ... (+${missing.length-50} more)`:''));
      }
      if(!modifiedScenarioIds.size){
        alert('No BLST changes were applied. (No adjusted hole times differed from the displayed times.)');
        return;
      }

      // Rewrite the BLST text scenario-by-scenario.
      let updatedText = window.blstTextOriginal;
  let idx = indexSelectBlocks(updatedText);
  for(const scenarioId of modifiedScenarioIds){
        const oldBlock = getSelectBlockById(updatedText, idx, scenarioId);
        if(!oldBlock) continue;
        const deck = scenarioDeck.get(scenarioId);
        const newBlock = upsertDeckDelayInScenarioBlock(oldBlock, deck);
        updatedText = updatedText.replace(oldBlock, newBlock);
    // Re-index after modifying text to keep select-block ranges valid
    idx = indexSelectBlocks(updatedText);
      }

      const base = (window.blstFilename || 'blast.blst').replace(/\.[^.]+$/, '');
      const outName = base + '_Pairs_Removed.blst';
      const exportedText = preserveSensitivityFlagsInExportedText(window.blstTextOriginal, updatedText);
      const blob = new Blob([exportedText], {type:'text/plain;charset=utf-8'});
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = outName;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(a.href);
    }

