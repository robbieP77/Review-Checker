const timedOnly = pts.filter(p=>Number.isFinite(currentTimeConflict(p)));
      for (let idx=0; idx<pts.length; idx++){
        const p = pts[idx];
        if (p.hasPrimer) continue;

        let nearest = null;
        let nearestDist = Infinity;
        for (const q of timedOnly){
          const d = distance(p,q);
          if (d < nearestDist){
            nearestDist = d;
            nearest = q;
          }
        }
        ntbc.push({
          hole: p.hole + (p.nodeId!=null ? (' ['+p.nodeId+']') : ''),
          chargeRule:p.chargeRule,
          hasPrimer:p.hasPrimer,
          reason: p.ntbcReason || (p.chargeRule ? "No primer in charge rule" : "No charge info"),
          nearestHole: nearest ? nearest.hole : "",
          nearestDist: nearest && isFinite(nearestDist) ? +nearestDist.toFixed(3) : "",
          idx
        });
      }

      window.conflicts = conflicts;
      window.ntbcHoles = ntbc;
      conflictNodes = new Set();
      for (const c of conflicts){
        conflictNodes.add(c.i);
        conflictNodes.add(c.j);
      }
    }

