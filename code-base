    function formatSectionRuleBlock(rule, explosives){
      const lines = [];
      if(!rule) return lines;
      if(rule.name) lines.push(`set Name ${rule.name}`);
      if(rule.length_mm !== null && rule.length_mm !== undefined) lines.push(`set Length ${rule.length_mm / 1000}`);
      if(rule.explosiveType !== null && rule.explosiveType !== undefined){
        const ex = explosives ? explosives[String(rule.explosiveType)] : null;
        if(ex){
          const exLines = [`set ExplosiveType ${rule.explosiveType} (select ${ex.id}`];
          exLines.push(` set Name ${ex.name}`);
          if(ex.density !== null && ex.density !== undefined) exLines.push(` set Density ${(ex.density / 1000).toFixed(2)}`);
          exLines.push(')');
          lines.push(exLines.join('\n'));
        } else {
          lines.push(`set ExplosiveType ${rule.explosiveType}`);
        }
      }
      if(rule.weight_g !== null && rule.weight_g !== undefined) lines.push(`set Weight ${(rule.weight_g / 1000).toFixed(1)}`);
      if(rule.percentage !== null && rule.percentage !== undefined) lines.push(`set Percentage ${rule.percentage}`);
      if(rule.referenceSection) lines.push(`set ReferenceSection ${rule.referenceSection}`);
      return lines;
    }

    function getChargeRuleExplosiveDescriptorTokens(chargeRuleName){
      const tokens = String(chargeRuleName || '').match(/[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*/g) || [];
      const ignore = new Set([
        'set','name','fixed','len','length','variable','var','stem','stemming','airdeck','air',
        'wall','control','branch','check','checks','timing','pairs','pair','design','deck','hole',
        'ntbc','hrdc','sdob'
      ]);
      const descriptors = [];
      for(const token of tokens){
        const t = String(token || '').trim();
        if(!t) continue;

        // Numeric-only/measurement tokens are treated as the start of metadata (e.g. 2.3m).
        if(/^\d+(?:\.\d+)?(?:m|kg|ms)?$/i.test(t)) break;

        const lower = t.toLowerCase();
        if(ignore.has(lower)) continue;

        // Preserve alphanumeric explosive grades (e.g. S11, S12, V10) as exact tokens.
        if(/[A-Za-z]/.test(t) && /\d/.test(t)){
          descriptors.push(t);
          continue;
        }

        // Keep alphabetic descriptors (e.g. ANFO, Emulsion).
        if(/^[A-Za-z]+$/.test(t) && t.length >= 2){
          descriptors.push(t);
        }
      }
      return descriptors;
    }

    function getChargeRuleExplosiveMismatchMap(chargeRuleName, sections, explosives){
      const map = {};
      const descriptors = getChargeRuleExplosiveDescriptorTokens(chargeRuleName);
      if(!descriptors.length) return map;

      const explosiveTokens = new Set();
      const explosiveNamesNormalized = [];
      (Array.isArray(sections) ? sections : []).forEach(section => {
        if(!isExplosiveSection(section, explosives)) return;
        const ex = (section.explosiveType !== null && section.explosiveType !== undefined)
          ? explosives[String(section.explosiveType)]
          : null;
        if(!ex || !ex.name) return;
        const exName = String(ex.name);
        getHighlightTokens(exName).forEach(t => explosiveTokens.add(String(t).toLowerCase()));
        getExplosiveNameAliasTokens(exName).forEach(t => explosiveTokens.add(String(t).toLowerCase()));
        explosiveNamesNormalized.push(exName.toLowerCase().replace(/[^a-z0-9]+/g, ''));
      });

      if(!explosiveTokens.size && !explosiveNamesNormalized.length) return map;

      descriptors.forEach(token => {
        const lower = String(token).toLowerCase();
        const norm = lower.replace(/[^a-z0-9]+/g, '');
        const matchedByToken = explosiveTokens.has(lower);
        const matchedByName = !!norm && explosiveNamesNormalized.some(n => n.includes(norm) || norm.includes(n));
        if(!matchedByToken && !matchedByName){
          map[token] = 'review-blue';
        }
      });
      return map;
    }

    function evaluateChargeRuleHeadingMatch(rule, sectionRules, explosives){
      const sections = (rule && Array.isArray(rule.sections))
        ? rule.sections.map(id => sectionRules.find(section => String(section.id) === String(id))).filter(Boolean)
        : [];
      const header = rule && rule.name ? String(rule.name) : `ChargeRule ${rule ? rule.id : ''}`;
      const headerMap = {};
      sections.forEach(section => {
        Object.assign(headerMap, getSharedHighlightMap(header, section.name || '', 'good'));
        if(isExplosiveSection(section, explosives)){
          const ex = section.explosiveType !== null && section.explosiveType !== undefined ? explosives[String(section.explosiveType)] : null;
          if(ex){
            Object.assign(headerMap, getSharedHighlightMap(header, ex.name || '', 'good'));
            Object.assign(headerMap, getExplosiveAliasHighlightMap(header, ex.name || '', 'good'));
          }
        }
      });
      const chargeLength = getLengthTokenInfo(header);
      if(chargeLength){
        const lengthMatches = sections.some(section => {
          const sectionLength = section.length_mm !== null && section.length_mm !== undefined ? (section.length_mm / 1000) : null;
          return Number.isFinite(sectionLength) && Math.abs(chargeLength.value - sectionLength) < 0.001;
        });
        headerMap[chargeLength.raw] = lengthMatches ? 'good' : 'bad';
      }

      const chargeWeight = getWeightTokenInfo(header);
      if(chargeWeight){
        const weightMatches = sections.some(section => {
          const sectionWeight = section.weight_g !== null && section.weight_g !== undefined ? (section.weight_g / 1000) : null;
          return Number.isFinite(sectionWeight) && Math.abs(chargeWeight.value - sectionWeight) < 0.05;
        });
        headerMap[chargeWeight.raw] = weightMatches ? 'good' : 'bad';
      }

      const explosiveMismatchMap = getChargeRuleExplosiveMismatchMap(header, sections, explosives);
      Object.keys(explosiveMismatchMap).forEach(token => {
        if(!headerMap[token]) headerMap[token] = explosiveMismatchMap[token];
      });

      const classes = Object.values(headerMap);
      const hasBad = classes.includes('bad');
      const hasGood = classes.includes('good');
      const statusClass = hasBad ? 'bad' : (hasGood ? 'good' : 'bad');
      return { header, headerMap, sections, statusClass };
    }

    function getNtbcHrdcSetNameStatus(rule, chargeRuleName, setNameValue, explosives){
      const contextName = String(chargeRuleName || '');
      const isNtbc = /\bntbc\b/i.test(contextName);
      const isHrdc = /\bhrdc\b/i.test(contextName);
      if(!isNtbc && !isHrdc) return null;

      const explosiveId = (rule && rule.explosiveType != null) ? String(rule.explosiveType) : '';
      const explosive = explosiveId ? explosives[explosiveId] : null;
      const explosiveName = String((explosive && explosive.name) || '').trim();
      const inertNameRe = /\b(?:air|stemming)\b/i;
      const ruleName = String((rule && rule.name) || '');
      const setName = String(setNameValue || '');
      const nameSuggestsInert = inertNameRe.test(setName) || inertNameRe.test(ruleName) || inertNameRe.test(explosiveName);
      const hasExplosive = !!explosiveId && (explosiveName ? !isNonExplosiveMaterial(explosiveName) : !nameSuggestsInert);
      const explosiveWeightKg = Number.isFinite(rule && rule.weight_g) ? (rule.weight_g / 1000) : NaN;

      if(isHrdc){
        return hasExplosive
          ? { cls: 'bad', label: 'check' }
          : { cls: 'good', label: 'match' };
      }

      if(!hasExplosive) return { cls: 'good', label: 'match' };
      if(Number.isFinite(explosiveWeightKg) && explosiveWeightKg < 1.1) return { cls: 'good', label: 'match' };
      return { cls: 'bad', label: 'check' };
    }

    function getChargeRuleNtbcHrdcStatus(chargeRule, sections, explosives){
      const statuses = (Array.isArray(sections) ? sections : [])
        .map(section => getNtbcHrdcSetNameStatus(section, chargeRule && chargeRule.name, section && section.name, explosives))
        .filter(Boolean);

      if(!statuses.length) return null;
      return statuses.some(status => status.cls === 'bad') ? 'bad' : 'good';
    }

    function updateSectionRulesList(){
      const card = document.getElementById('sectionRulesCard');
      const body = document.getElementById('sectionRulesBody');
      if(!card || !body) return;

      const chargeRules = (window.blstData && window.blstData.chargeRules) ? Object.values(window.blstData.chargeRules) : [];
      const sectionRules = (window.blstData && window.blstData.sectionRules) ? Object.values(window.blstData.sectionRules) : [];
      const explosives = (window.blstData && window.blstData.explosives) ? window.blstData.explosives : {};

      const renderSectionRule = (rule, chargeRuleName) => {
        const title = rule.name ? String(rule.name) : `Section ${rule.id}`;
        const sectionIsExplosive = isExplosiveSection(rule, explosives);
        const sectionExplosive = (rule.explosiveType !== null && rule.explosiveType !== undefined)
          ? explosives[String(rule.explosiveType)]
          : null;
        const lines = sectionIsExplosive
          ? formatSectionRuleBlock(rule, explosives).flatMap(line => String(line).split('\n'))
          : [
              ...(rule.name ? [`set Name ${rule.name}`] : []),
              ...(rule.length_mm !== null && rule.length_mm !== undefined ? [`set Length ${rule.length_mm / 1000}`] : [])
            ];
        const nameMap = {};
        if(chargeRuleName){
          Object.assign(nameMap, getSharedHighlightMap(chargeRuleName, rule.name || '', 'good'));
          if(sectionExplosive && sectionIsExplosive){
            Object.assign(nameMap, getSharedHighlightMap(chargeRuleName, sectionExplosive.name || '', 'good'));
            Object.assign(nameMap, getExplosiveAliasHighlightMap(rule.name || '', sectionExplosive.name || '', 'good'));
          }
        }

        const renderedLines = lines.map(line => {
          const rawLine = String(line);
          const indent = rawLine.match(/^\s*/)?.[0] || '';
          const content = rawLine.slice(indent.length);

          if(/^set Name\s+/.test(content)){
            const value = content.replace(/^set Name\s+/, '');
            const highlighted = highlightExactPhrases(value, nameMap);
            const status = getNtbcHrdcSetNameStatus(rule, chargeRuleName, value, explosives);
            const statusTag = status
              ? ` <span class="${status.cls}" style="font-weight:700">${status.label}</span>`
              : '';
            return `${indent}set Name ${highlighted}${statusTag}`;
          }

          if(/^set Length\s+/.test(content) && chargeRuleName){
            const value = content.replace(/^set Length\s+/, '');
            const chargeLength = getLengthTokenInfo(chargeRuleName);
            const sectionLength = rule.length_mm !== null && rule.length_mm !== undefined ? (rule.length_mm / 1000) : null;
            const matches = chargeLength && Number.isFinite(sectionLength)
              ? Math.abs(chargeLength.value - sectionLength) < 0.001
              : false;
            return `${indent}set Length <span class="${matches ? 'good' : 'bad'}">${escapeHTML(value)}</span>`;
          }

          if(/^set Weight\s+/.test(content) && chargeRuleName){
            const value = content.replace(/^set Weight\s+/, '');
            const chargeWeight = getWeightTokenInfo(chargeRuleName);
            const sectionWeight = rule.weight_g !== null && rule.weight_g !== undefined ? (rule.weight_g / 1000) : null;
            const matches = chargeWeight && Number.isFinite(sectionWeight)
              ? Math.abs(chargeWeight.value - sectionWeight) < 0.05
              : false;
            return `${indent}set Weight <span class="${matches ? 'good' : 'bad'}">${escapeHTML(value)}</span>`;
          }

          return escapeHTML(rawLine);
        });

        return `
          <div style="padding:10px 0 0 18px">
            <div style="font-weight:700;margin-bottom:6px">${escapeHTML(title)}</div>
            <pre style="margin:0;white-space:pre-wrap;word-break:break-word;background:rgba(148,163,184,0.08);padding:10px 12px;border-radius:8px;overflow:auto">${renderedLines.join('\n')}</pre>
          </div>
        `;
      };

      const renderChargeRule = (rule) => {
        const evalResult = evaluateChargeRuleHeadingMatch(rule, sectionRules, explosives);
        const sections = evalResult.sections;
        const header = evalResult.header;
        const headerMap = evalResult.headerMap;
        const headerHtml = highlightExactPhrases(header, headerMap);
        const sectionHtml = sections.length
          ? sections.map(section => renderSectionRule(section, header)).join('')
          : '<div class="small muted" style="padding:10px 0 0 18px">No SectionRules found for this ChargeRule.</div>';
        return `
          <div style="padding:12px 0;border-top:1px solid rgba(148,163,184,0.2)">
            <div style="font-weight:700">set Name ${headerHtml}</div>
            ${sectionHtml}
          </div>
        `;
      };

      const chargeRuleList = chargeRules
        .filter(Boolean)
        .sort((a, b) => String(a.name || a.id || '').localeCompare(String(b.name || b.id || '')));

      if(chargeRuleList.length){
        body.innerHTML = chargeRuleList.map(renderChargeRule).join('');
        return;
      }

      const sorted = sectionRules
        .filter(Boolean)
        .sort((a, b) => {
          const aId = Number(a.id);
          const bId = Number(b.id);
          if(Number.isFinite(aId) && Number.isFinite(bId) && aId !== bId) return aId - bId;
          return String(a.name || a.id || '').localeCompare(String(b.name || b.id || ''));
        });

      if(!sorted.length){
        body.innerHTML = '<div class="small muted">Load a BLST file to view SectionRules.</div>';
        return;
      }

      body.innerHTML = sorted.map(section => renderSectionRule(section, '')).join('');
    }

    function getHolePowderFactorKgM3(rec, point){
      const hole = rec || point || {};

      const recordedPf = Number(hole['Powder Factor (kg/m^3)'] ?? hole.powderFactor);
      return Number.isFinite(recordedPf) && recordedPf > 0 ? recordedPf : NaN;
    }

    function normalizeChargeRuleName(value){
      return String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function chargeRuleNameMatches(chargeValue, needle){
      const candidate = normalizeChargeRuleName(chargeValue);
      const target = normalizeChargeRuleName(needle);
      if(!candidate || !target) return false;
      if(candidate === target) return true;
      if(candidate.includes(target) || target.includes(candidate)) return true;

      const aTokens = candidate.split(' ').filter(Boolean);
      const bTokens = target.split(' ').filter(Boolean);
      if(!aTokens.length || !bTokens.length) return false;

      const overlap = aTokens.filter(token => bTokens.includes(token));
      return overlap.length >= Math.min(aTokens.length, bTokens.length) * 0.5;
    }

    function getChargeRulePowderFactorSummary(chargeRuleName){
      const needle = String(chargeRuleName || '').trim();
      if(!needle) return { positiveAvg: NaN, nonPositiveAvg: NaN };

      const records = [];
      const addRecord = (rec, point) => {
        const chargeValue = String(
          (rec && (rec.chargeName || rec.chargeRule || rec.chargeRuleName || rec['Charge Name'] || rec['Charge Rule'])) ||
          (point && (point.chargeRule || point.chargeRuleName || point.chargeName || point['Charge Name'] || point['Charge Rule'])) ||
          ''
        ).trim();

        const matches = chargeValue && normalizeChargeRuleName(chargeValue) === normalizeChargeRuleName(needle);
        if(!matches) return;

        const pf = getHolePowderFactorKgM3(rec, point);
        if(!Number.isFinite(pf)) return;

        const subDrill = Number(
          (rec && (rec.subDrill ?? rec.subDrillM ?? rec['Sub Drill (m)'] ?? rec['Subdrill length (m)'])) ??
          (point && point.subDrill)
        );
        if(!Number.isFinite(subDrill)) return;

        records.push({ subDrill, pf });
      };

      if(Array.isArray(window.pts)){
        window.pts.forEach(point => {
          const rec = point && point._csvRec ? point._csvRec : point;
          addRecord(rec, point);
        });
      }

      if(!records.length && window.csvDet){
        const csvRecords = [];
        if(Array.isArray(window.csvDet.csvHoles)) csvRecords.push(...window.csvDet.csvHoles);
        if(Array.isArray(window.csvDet.csvHolesMerged)) csvRecords.push(...window.csvDet.csvHolesMerged);
        if(Array.isArray(window.rows)) csvRecords.push(...window.rows.map(r => ({ ...r, chargeName: r['Charge Name'] || r.ChargeName || r.chargeName || r.chargeRuleName || r.chargeRule })));
        csvRecords.forEach(rec => addRecord(rec, null));
      }

      if(!records.length && Array.isArray(window.rows)){
        window.rows.forEach(row => {
          const pf = getHolePowderFactorKgM3(row, null);
          if(!Number.isFinite(pf)) return;
          const subDrill = Number(row['Sub Drill (m)'] ?? row['Subdrill length (m)'] ?? row.subDrill ?? row.subdrill);
          if(!Number.isFinite(subDrill)) return;
          records.push({ subDrill, pf });
        });
      }

      if(!records.length) return { positiveAvg: NaN, nonPositiveAvg: NaN };

      const positive = records.filter(r => r.subDrill > 0).map(r => r.pf);
      const nonPositive = records.filter(r => r.subDrill <= 0).map(r => r.pf);

      return {
        positiveAvg: positive.length ? (positive.reduce((sum, value) => sum + value, 0) / positive.length) : NaN,
        nonPositiveAvg: nonPositive.length ? (nonPositive.reduce((sum, value) => sum + value, 0) / nonPositive.length) : NaN
      };
    }

