            const m2 = coord.match(/^\(\s*([\-0-9.]+)\s*,\s*([\-0-9.]+)\s*,\s*([\-0-9.]+)\s*\)\s*$/);
            if(m2){
              blastPos[parseInt(line,10)] = {E:parseFloat(m2[1]), Z:parseFloat(m2[2]), N:parseFloat(m2[3])};
