    let conflictNodes = new Set();
    let bounds = null, view = null, showLinks = true, showHoleLabels = true;

    let dragging = false, dragStart = null, viewStart = null;
    let animRunning = false, animT = 0, animMin = 0, animMax = 0, lastRAF = 0;

// ---------- Vibration visualiser state (BLST-only) ----------

let vibPlanCanvas = null, vibPlanCtx = null, vibWaveCanvas = null, vibWaveCtx = null;
let myMapCanvas = null, myMapCtx = null;
let vibBounds = null, vibView = null;
let vibDragging = false, vibDragStart = null, vibViewStart = null;
let vibModel = null; // {receiver, holes[], timeSeries[], tStart, tEnd, maxPPV, ppvSD, dominantHole, Q_total}
let vibPlaying = false, vibCurrentT = 0, vibLastRAF = 0;

function vibComputeBounds(){
  if(!vibModel || !vibModel.holes || !vibModel.holes.length){ vibBounds=null; return; }
  let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
  for(const h of vibModel.holes){
    if(!isFinite(h.x)||!isFinite(h.y)) continue;
    if(h.x<minX)minX=h.x;
    if(h.x>maxX)maxX=h.x;
    if(h.y<minY)minY=h.y;
    if(h.y>maxY)maxY=h.y;
  }
  const r = vibModel.receiver;
  if(r && isFinite(r.x) && isFinite(r.y)){
    minX=Math.min(minX,r.x); maxX=Math.max(maxX,r.x);
    minY=Math.min(minY,r.y); maxY=Math.max(maxY,r.y);
  }
  if(!isFinite(minX)){ vibBounds=null; return; }
  const marginX=(maxX-minX)||1;
  const marginY=(maxY-minY)||1;
  minX-=marginX*0.08; maxX+=marginX*0.08;
  minY-=marginY*0.08; maxY+=marginY*0.08;
  vibBounds={minX,maxX,minY,maxY};
}

function vibFitView(){
  if(!vibBounds){ vibView=null; return; }
  vibView={...vibBounds};
  vibResizeCanvases();
}

function vibResizeCanvases(){
  if(!vibPlanCanvas || !vibWaveCanvas) return;

  const aspect = (((vibView && vibView.maxX != null) ? vibView.maxX : 1) - ((vibView && vibView.minX != null) ? vibView.minX : 0)) / ((((vibView && vibView.maxY != null) ? vibView.maxY : 1) - ((vibView && vibView.minY != null) ? vibView.minY : 0)) || 1);
  // Plan view uses a similar size/aspect approach as other blast canvases.
  resizeCanvasTo('vibPlanWrap', vibPlanCanvas, aspect || 2.5);
  // Wave plot: fixed aspect (w/h) ~ 3.0
  resizeCanvasTo('vibWaveWrap', vibWaveCanvas, 3.0);
}

function vibWorldToScreen(x,y,canvas){
  if(!vibView) return [0,0];
  const {minX,maxX,minY,maxY}=vibView;
  const w = canvas.width / (window.devicePixelRatio||1);
  const h = canvas.height / (window.devicePixelRatio||1);
  const sx = (x-minX)/(maxX-minX||1)*w;
  const sy = h - (y-minY)/(maxY-minY||1)*h;
  return [sx,sy];
}

function vibScreenToWorld(sx,sy,canvas){
  if(!vibView) return [0,0];
  const {minX,maxX,minY,maxY}=vibView;
  const w = canvas.width / (window.devicePixelRatio||1);
  const h = canvas.height / (window.devicePixelRatio||1);
  const x = minX + (sx/w)*(maxX-minX);
  const y = minY + ((h-sy)/h)*(maxY-minY);
  return [x,y];
}

function vibDrawGrid(ctx,canvas){
  if(!vibView) return;
  const {minX,maxX,minY,maxY}=vibView;
  const w = canvas.width / (window.devicePixelRatio||1);
  const h = canvas.height / (window.devicePixelRatio||1);
  ctx.save();
  ctx.beginPath();
  const step = Math.pow(10, Math.floor(Math.log10((maxX-minX)/8 || 1)));
  for(let gx=Math.ceil(minX/step)*step; gx<=maxX; gx+=step){
    const [sx1,sy1] = vibWorldToScreen(gx,minY,canvas);
    const [sx2,sy2] = vibWorldToScreen(gx,maxY,canvas);
    ctx.moveTo(sx1,sy1); ctx.lineTo(sx2,sy2);
  }
  for(let gy=Math.ceil(minY/step)*step; gy<=maxY; gy+=step){
    const [sx1,sy1] = vibWorldToScreen(minX,gy,canvas);
    const [sx2,sy2] = vibWorldToScreen(maxX,gy,canvas);
    ctx.moveTo(sx1,sy1); ctx.lineTo(sx2,sy2);
  }
  ctx.strokeStyle='rgba(148,163,184,0.15)';
  ctx.lineWidth=1;
  ctx.stroke();
  ctx.restore();
}

function vibUpdateTimeReadout(){
  const el = document.getElementById('vibTimeReadout');
  if(el) el.textContent = `t = ${vibCurrentT.toFixed(3)} s`;
}

function vibUpdateSlider(){
  const slider = document.getElementById('vibTimeSlider');
  if(!slider || !vibModel) return;
  slider.min = vibModel.tStart;
  slider.max = vibModel.tEnd;
  slider.value = vibCurrentT;
  vibUpdateTimeReadout();
}

function vibDrawPlan(){
  if(!vibPlanCtx || !vibPlanCanvas){
    return;
  }
  const ctx = vibPlanCtx;
  const canvas = vibPlanCanvas;

  const w = canvas.width / (window.devicePixelRatio||1);
  const h = canvas.height / (window.devicePixelRatio||1);
  ctx.clearRect(0,0,w,h);

  if(!vibModel || !vibView){
    ctx.fillStyle = '#94a3b8';
    ctx.font = '12px system-ui';
    ctx.fillText('Select a monitor to view vibration visualisation.', 16, 24);
    return;
  }

  vibDrawGrid(ctx,canvas);

  const r = vibModel.receiver;
  const vp = vibModel.vp_mps;

  // Highlight holes as they detonate (flash window ~ initial pulse width)
  const vibT0El = document.getElementById('vibT0');
  const t0_ms_for_flash = parseFloat(vibT0El ? vibT0El.value : '') || 10;
  const flashSpan_s = Math.max(0.02, t0_ms_for_flash / 1000.0);
  const firingNow = []


  // Hole wavefronts + points
  ctx.lineWidth = 1;
  for(const hh of vibModel.holes){
    const [sx,sy] = vibWorldToScreen(hh.x,hh.y,canvas);

    // Wavefront radius from detonation time, shown travelling at vp
    const tSinceFire = vibCurrentT - hh.fire_s;
    if(tSinceFire > 0 && isFinite(vp) && vp > 0){
      const radius_m = vp * tSinceFire;
      const [sx2,sy2] = vibWorldToScreen(hh.x + radius_m, hh.y, canvas);
      const radius_px = Math.abs(sx2 - sx);
      if(radius_px > 0.5){
        ctx.beginPath();
        ctx.arc(sx,sy,radius_px,0,Math.PI*2);
        ctx.strokeStyle = 'rgba(59,130,246,0.35)';
        ctx.stroke();
      }
    }

    const isDom = vibModel.dominantHole && vibModel.dominantHole.name === hh.name;
    const isFiring = (vibCurrentT >= hh.fire_s) && (vibCurrentT <= (hh.fire_s + flashSpan_s));
    if(isFiring) firingNow.push(hh.name);

    // Hole marker (highlight when firing)
    // Hole marker: outline-only (blue) until it fires; turns solid red while firing
    ctx.beginPath();
    const rpx = isFiring ? (isDom ? 8 : 7) : (isDom ? 5 : 4);
    ctx.arc(sx,sy,rpx,0,Math.PI*2);

    if(!isFiring){
      // Outline-only marker (blue)
      ctx.save();
      ctx.lineWidth = isDom ? 2 : 1.5;
      ctx.strokeStyle = 'rgba(56,189,248,0.95)';
      ctx.stroke();
      ctx.restore();
    }

    if(isFiring){
      // Solid firing marker
      ctx.fillStyle = '#ef4444';
      ctx.fill();
      ctx.save();
      ctx.lineWidth = 2;
      ctx.strokeStyle = 'rgba(239,68,68,0.95)';
      ctx.stroke();
      ctx.restore();

      // Show the initial pulse as a thin expanding band for the duration of T0
      const rOuter_m = (isFinite(vp) && vp>0) ? (vp * tSinceFire) : 0;
      const rInner_m = (isFinite(vp) && vp>0) ? (vp * Math.max(0, tSinceFire - flashSpan_s)) : 0;
      if(rOuter_m > 0){
        const [sxO, _syO] = vibWorldToScreen(hh.x + rOuter_m, hh.y, canvas);
        const [sxI, _syI] = vibWorldToScreen(hh.x + rInner_m, hh.y, canvas);
        const rOuter_px = Math.abs(sxO - sx);
        const rInner_px = Math.abs(sxI - sx);
        if(rOuter_px > rInner_px + 0.75){
          ctx.save();
          ctx.beginPath();
          ctx.arc(sx,sy,rOuter_px,0,Math.PI*2,false);
          ctx.arc(sx,sy,rInner_px,0,Math.PI*2,true);
          ctx.fillStyle = 'rgba(239,68,68,0.10)';
          ctx.fill();
          ctx.restore();
        }
      }
      // Label the firing hole (limited visual clutter is handled by using a short flash window)
      ctx.save();
      ctx.font = '11px ui-monospace, Menlo, Consolas, monospace';
      ctx.textAlign='left';
      ctx.textBaseline='middle';
      ctx.fillStyle = '#fee2e2';
      ctx.fillText(hh.name, sx+10, sy);
      ctx.restore();
    }
}

  // Firing holes readout
  if(firingNow.length){
    const shown = firingNow.slice(0, 8);
    let msg = 'Firing: ' + shown.join(', ');
    if(firingNow.length > shown.length) msg += ` +${firingNow.length - shown.length}`;
    ctx.save();
    ctx.font = '12px ui-monospace, Menlo, Consolas, monospace';
    ctx.textAlign='right';
    ctx.textBaseline='top';
    ctx.fillStyle = getThemeCssVar('--map-overlay-text', '#e2e8f0');
    ctx.fillText(msg, w-10, 10);
    ctx.restore();
  }

  // Receiver marker
  if(r && isFinite(r.x) && isFinite(r.y)){
    const [rx,ry] = vibWorldToScreen(r.x,r.y,canvas);
    ctx.beginPath();
    ctx.arc(rx,ry,6,0,Math.PI*2);
    ctx.fillStyle = '#22c55e';
    ctx.fill();
    ctx.font = '12px ui-monospace, Menlo, Consolas, monospace';
    ctx.textAlign='left';
    ctx.textBaseline='bottom';
    ctx.fillStyle = getThemeCssVar('--map-overlay-text', '#e2e8f0');
    ctx.fillText(r.name || 'Receiver', rx+8, ry-6);
  }

  // Time label
  ctx.textAlign='left';
  ctx.textBaseline='top';
  ctx.font = '12px ui-monospace, Menlo, Consolas, monospace';
  ctx.fillStyle = '#94a3b8';
  ctx.fillText(`t = ${vibCurrentT.toFixed(3)} s`, 10, 10);
}

function vibDrawWave(){
  if(!vibWaveCtx || !vibWaveCanvas){
    return;
  }
  const ctx = vibWaveCtx;
  const canvas = vibWaveCanvas;
  const w = canvas.width / (window.devicePixelRatio||1);
  const h = canvas.height / (window.devicePixelRatio||1);
  ctx.clearRect(0,0,w,h);

  if(!vibModel || !vibModel.timeSeries || !vibModel.timeSeries.length){
    ctx.fillStyle = '#94a3b8';
    ctx.font = '12px system-ui';
    ctx.fillText('No PPV(t) time series available.', 16, 24);
    return;
  }

  // --------- Auto-fit window to "active" PPV data ----------
  // Use a small fraction of peak to find the time span that contains most energy.
  // This is a visualisation convenience only.
  const series = vibModel.timeSeries;
  const peak = (typeof vibModel.maxPPV === 'number' && isFinite(vibModel.maxPPV) && vibModel.maxPPV>0)
    ? vibModel.maxPPV
    : Math.max(1e-9, ...series.map(p=>p.v||0));

  const overallStart = vibModel.tStart;
  const overallEnd = vibModel.tEnd;

  const thr = peak * 0.01; // 1% of peak
  let i0 = -1, i1 = -1;
  for(let i=0;i<series.length;i++){
    if((series[i].v||0) >= thr){ i0 = i; break; }
  }
  for(let i=series.length-1;i>=0;i--){
    if((series[i].v||0) >= thr){ i1 = i; break; }
  }

  let tStart = overallStart;
  let tEnd = overallEnd;
  if(i0>=0 && i1>=0 && i1>i0){
    tStart = series[i0].t;
    tEnd = series[i1].t;
    // Add small margin so peaks are not clipped visually
    const span = (tEnd - tStart) || 1;
    const pad = span * 0.05;
    tStart = Math.max(overallStart, tStart - pad);
    tEnd = Math.min(overallEnd, tEnd + pad);
    // If the fitted window is almost the full window, just use full window
    if((overallEnd-overallStart) > 0 && ((tEnd-tStart)/(overallEnd-overallStart)) > 0.95){
      tStart = overallStart;
      tEnd = overallEnd;
    }
  }

  // Determine y-range from the plotted window
  let yMax = 0;
  for(const p of series){
    if(p.t < tStart || p.t > tEnd) continue;
    const v = (p.v||0);
    if(v > yMax) yMax = v;
  }
  if(!(yMax>0)) yMax = peak;

  // Nice tick helper
  function niceStep(range, targetTicks){
    const rough = range / Math.max(1, targetTicks);
    const pow10 = Math.pow(10, Math.floor(Math.log10(Math.max(rough, 1e-12))));
    const n = rough / pow10;
    let mult = 1;
    if(n <= 1) mult = 1;
    else if(n <= 2) mult = 2;
    else if(n <= 5) mult = 5;
    else mult = 10;
    return mult * pow10;
  }

  const paddingLeft = 56;
  const paddingRight = 12;
  const paddingTop = 16;
  const paddingBottom = 30;

  const xScale = (w - paddingLeft - paddingRight) / ((tEnd - tStart) || 1);
  const yScale = (h - paddingTop - paddingBottom) / ((yMax * 1.08) || 1);

  // Axes
  ctx.strokeStyle='rgba(148,163,184,0.8)';
  ctx.lineWidth=1;
  ctx.beginPath();
  ctx.moveTo(paddingLeft, h - paddingBottom);
  ctx.lineTo(w - paddingRight, h - paddingBottom);
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(paddingLeft, paddingTop);
  ctx.lineTo(paddingLeft, h - paddingBottom);
  ctx.stroke();

  // Y ticks (nice)
  ctx.fillStyle = '#94a3b8';
  ctx.font='11px system-ui';
  const yStep = niceStep(yMax, 4);
  const yTop = Math.ceil((yMax * 1.08) / yStep) * yStep;
  for(let val=0; val<=yTop + 0.5*yStep; val += yStep){
    const y = h - paddingBottom - val*yScale;
    if(y < paddingTop-1) continue;
    ctx.beginPath();
    ctx.moveTo(paddingLeft-4,y);
    ctx.lineTo(w-paddingRight,y);
    ctx.strokeStyle = val===0 ? 'rgba(148,163,184,0.8)' : 'rgba(148,163,184,0.15)';
    ctx.stroke();
    ctx.fillText((val>=10 ? val.toFixed(0) : val.toFixed(2)), 8, y+3);
  }

  // X ticks (nice)
  const xRange = (tEnd - tStart) || 1;
  const xStep = niceStep(xRange, 6);
  const xFirst = Math.ceil(tStart / xStep) * xStep;
  ctx.textAlign='center';
  for(let tVal=xFirst; tVal<=tEnd + 1e-9; tVal += xStep){
    const x = paddingLeft + (tVal - tStart)*xScale;
    ctx.beginPath();
    ctx.moveTo(x, h - paddingBottom);
    ctx.lineTo(x, h - paddingBottom + 4);
    ctx.strokeStyle='rgba(148,163,184,0.8)';
    ctx.stroke();
    ctx.fillStyle='#94a3b8';
    const fmt = (xRange >= 10) ? tVal.toFixed(1) : tVal.toFixed(2);
    ctx.fillText(fmt, x, h-10);
  }
  ctx.textAlign='left';

  // Line
  ctx.beginPath();
  let started = false;
  for(let i=0;i<series.length;i++){
    const p=series[i];
    if(p.t < tStart || p.t > tEnd) continue;
    const x = paddingLeft + (p.t - tStart)*xScale;
    const y = h - paddingBottom - (p.v||0)*yScale;
    if(!started){ ctx.moveTo(x,y); started=true; }
    else ctx.lineTo(x,y);
  }
  ctx.strokeStyle='#e2e8f0';
  ctx.lineWidth=1.5;
  ctx.stroke();

  // Cursor
  const cursorX = paddingLeft + (vibCurrentT - tStart)*xScale;
  if(cursorX >= paddingLeft && cursorX <= w - paddingRight){
    ctx.beginPath();
    ctx.moveTo(cursorX, paddingTop);
    ctx.lineTo(cursorX, h - paddingBottom);
    ctx.strokeStyle='rgba(239,68,68,0.9)';
    ctx.lineWidth=1;
    ctx.setLineDash([4,3]);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // Title
  ctx.fillStyle='#94a3b8';
  ctx.font='11px system-ui';
  ctx.fillText('PPV (mm/s)', paddingLeft, paddingTop-4);
  ctx.textAlign='right';
  ctx.fillText(`Peak = ${Number.isFinite(vibModel.ppv) ? vibModel.ppv.toFixed(3) : peak.toFixed(3)} mm/s`, w - paddingRight, paddingTop-4);
  ctx.textAlign='left';
}

function vibDrawAll(){
  vibDrawPlan();
  vibDrawWave();
}

function vibOnWheel(e){
  if(!vibView) return;
  e.preventDefault();
  const canvas = e.target;
  const rect = canvas.getBoundingClientRect();
  const px = (e.clientX - rect.left) * (canvas.width/rect.width);
  const py = (e.clientY - rect.top) * (canvas.height/rect.height);
  const [wx,wy] = screenToWorld(px,py,canvas);
  const scale = Math.exp(-e.deltaY * 0.0015);
  const newW = (vibView.maxX-vibView.minX)/scale;
  const newH = (vibView.maxY-vibView.minY)/scale;
  const rx = (wx-vibView.minX)/(vibView.maxX-vibView.minX);
  const ry = (wy-vibView.minY)/(vibView.maxY-vibView.minY);
  const minX = wx - rx*newW;
  const maxX = minX + newW;
  const minY = wy - ry*newH;
  const maxY = minY + newH;
  vibView = {minX,maxX,minY,maxY};
  vibDrawAll();
}

function vibOnPointerDown(e){
  if(!vibView) return;
  vibDragging = true;
  const canvas = e.target;
  if(canvas && typeof canvas.setPointerCapture === 'function'){
    canvas.setPointerCapture(e.pointerId);
  }
  vibDragStart = {x:e.clientX,y:e.clientY,canvas};
  vibViewStart = {...vibView};
}

function vibOnPointerMove(e){
  if(!vibDragging || !vibView) return;
  const canvas = vibDragStart.canvas;
  const rect = canvas.getBoundingClientRect();
  const dx = e.clientX - vibDragStart.x;
  const dy = e.clientY - vibDragStart.y;
  const worldW = vibViewStart.maxX-vibViewStart.minX;
  const worldH = vibViewStart.maxY-vibViewStart.minY;
  const sx = dx/rect.width*worldW;
  const sy = -dy/rect.height*worldH;
  vibView = {
    minX:vibViewStart.minX - sx,
    maxX:vibViewStart.maxX - sx,
    minY:vibViewStart.minY - sy,
    maxY:vibViewStart.maxY - sy
  };
  vibDrawAll();
}

function vibOnPointerUp(){
  vibDragging=false;
}

function vibTick(ts){
  if(!vibPlaying || !vibModel) return;
  if(!vibLastRAF) vibLastRAF = ts;
  const dtSec = (ts - vibLastRAF)/1000;
  vibLastRAF = ts;
  const speed = parseFloat(document.getElementById('vibSpeed').value) || 1;
  vibCurrentT += dtSec * speed;

  if(vibCurrentT > vibModel.tEnd){
    vibCurrentT = vibModel.tEnd;
    vibPlaying = false;
  }
  vibUpdateSlider();
  vibDrawAll();
  if(vibPlaying) requestAnimationFrame(vibTick);
}

function buildVibModelForReceiver(receiver, holes, overrides){
  if(!receiver) return null;

  const alg = overrides.algorithm || 'consider_timing';
  const K = overrides.K;
  const n = overrides.n;
  const vp = overrides.vp;
  const T0 = overrides.T0;
  const alpha = overrides.alpha;
  const Cw = overrides.Cw;

  const T0_s = (Number.isFinite(T0) ? T0 : 10) / 1000.0;
  const alpha_s_per_m = (Number.isFinite(alpha) ? alpha : 0) / 1000.0;

  // Draw ALL holes (so the vibration viewer matches the hole map), even if charge is missing.
  const holesDraw = holes.filter(h => Number.isFinite(h.x) && Number.isFinite(h.y));

  // Precompute per-hole receiver-relative parameters.
  for(const h of holesDraw){
    const dx = h.x - receiver.x, dy = h.y - receiver.y;
    const R = Math.hypot(dx,dy);

    const fire_s = (h.detonation_ms != null && Number.isFinite(h.detonation_ms)) ? (h.detonation_ms/1000.0) : NaN;
    const arrive_s = (Number.isFinite(fire_s) && Number.isFinite(vp) && vp>0) ? (fire_s + (R/vp)) : NaN;

    const pulseWidth_s = Math.max(T0_s + alpha_s_per_m * R, 1e-4);
    const sigma_s = pulseWidth_s / 2.0;

    const Q = (h.charge_kg != null && Number.isFinite(h.charge_kg) && h.charge_kg > 0) ? h.charge_kg : NaN;
    const sd = (Number.isFinite(Q) && Q>0) ? (R/Math.sqrt(Q)) : NaN;
    const ppvSingle = (Number.isFinite(sd) && sd>0) ? (K * Math.pow(sd, -n)) : 0;

    h._vib = {R,Q,sd,ppvSingle,fire_s,arrive_s,pulseWidth_s,sigma_s};
  }

  const timed = holesDraw.filter(h => h.hasPrimer && Number.isFinite(h._vib.fire_s));
  const eligibleCalc = timed.filter(h => Number.isFinite(h._vib.Q));

  // Default time range for visualisation even if PPV can't be computed.
  let tStart = 0, tEnd = 1;
  {
    const arr = timed.map(h=>h._vib.arrive_s).filter(Number.isFinite);
    if(arr.length){
      tStart = Math.min(...arr) - 0.05;
      tEnd   = Math.max(...arr) + 0.25;
      if(!Number.isFinite(tStart) || !Number.isFinite(tEnd) || tEnd<=tStart){
        tStart = 0; tEnd = 1;
      }
    }
  }

  let dominant = null;
  let Q_total = NaN, Q_dom = NaN, R_dom = NaN, ppvSD = NaN, weightRatio = NaN;
  let timeSeries = [];

  if(eligibleCalc.length){
    // Dominant hole = min scaled distance.
    dominant = eligibleCalc.reduce((best,h)=> (best==null || h._vib.sd < best._vib.sd) ? h : best, null);

    R_dom = dominant._vib.R;
    Q_dom = dominant._vib.Q;

    // Total contributing charge weight using an LLM-derived Gaussian time weighting approximation:
    // weight = exp(-Cw*(Δt/T_dom)^2), with 2% significance threshold relative to dominant Q.
    const minQ = 0.02 * Q_dom;
    const tDom = dominant._vib.arrive_s;
    const TDom = Math.max(dominant._vib.pulseWidth_s, 1e-6);

    let sumWQ = 0;
    for(const h of eligibleCalc){
      if(h._vib.Q < minQ) continue;
      const dt = Math.abs(h._vib.arrive_s - tDom);
      const w = Math.exp(-Cw * Math.pow(dt/TDom, 2));
      sumWQ += w * h._vib.Q;
    }

    Q_total = Math.max(sumWQ, Q_dom);

    // Core scaled-distance PPV using dominant distance and total contributing charge.
    const sdEff = R_dom / Math.sqrt(Math.max(Q_total, 1e-9));
    ppvSD = K * Math.pow(sdEff, -n);
    weightRatio = Q_total / Q_dom;

    // Build a PPV(t) visualisation by summing Gaussian pulses (scaled to match ppvSD peak).
    let tMin = Infinity, tMax = -Infinity;
    for(const h of eligibleCalc){
      const a = h._vib.arrive_s, s = h._vib.sigma_s;
      if(!Number.isFinite(a) || !Number.isFinite(s) || s<=0) continue;
      tMin = Math.min(tMin, a - 4*s);
      tMax = Math.max(tMax, a + 4*s);
    }
    if(Number.isFinite(tMin) && Number.isFinite(tMax) && tMax>tMin){
      tStart = tMin; tEnd = tMax;
      const N = 600;
      const dt = (tMax - tMin) / N;
      const series = [];
      let maxRaw = 0;

      for(let i=0;i<=N;i++){
        const t = tMin + i*dt;
        let vRaw = 0;
        for(const h of eligibleCalc){
          const a = h._vib.arrive_s, s = h._vib.sigma_s;
          if(!Number.isFinite(a) || !Number.isFinite(s) || s<=0) continue;
          const tau = (t - a) / s;
          vRaw += h._vib.ppvSingle * Math.exp(-0.5 * tau * tau);
        }
        series.push({t, vRaw});
        if(Math.abs(vRaw) > maxRaw) maxRaw = Math.abs(vRaw);
      }

      const scale = (maxRaw > 0 && Number.isFinite(ppvSD)) ? (ppvSD / maxRaw) : 0;
      timeSeries = series.map(p=>({t:p.t, v:p.vRaw*scale}));
    }
  }

  // Note: vibModel.holes is used for drawing; keep all holes so the viewer matches the map.
  return {
    receiver: {name: receiver.name, x: receiver.x, y: receiver.y},
    vp_mps: vp,
    holes: holesDraw.map(h=>({
      name: h.name,
      x: h.x, y: h.y,
      fire_s: h._vib.fire_s,
      arrive_s: h._vib.arrive_s,
      sigma_s: h._vib.sigma_s,
      ppvSingle: h._vib.ppvSingle,
      isDominant: (dominant && dominant === h),
      isTimed: Number.isFinite(h._vib.fire_s),
      isCharged: Number.isFinite(h._vib.Q)
    })),
    timeSeries,
    tStart: tStart,
    tEnd: tEnd,
    ppv: ppvSD,
    ppvSD: ppvSD,
    weightRatio: weightRatio,
    Q_total: Q_total,
    Q_dom: Q_dom,
    R_dom: R_dom
  };
}

