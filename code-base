    function buildMapCallDistanceReview(){
      if(!Array.isArray(window.pts) || !window.pts.length){
        window.mapCallDistancePairs = [];
        return;
      }
      const multiplier = parseNumber(document.getElementById('mapCallMultiplier').value);
      const pairs = [];
      const EPS = 1e-9;

      function _dist3(a,b){
        const dx = (a.x||0) - (b.x||0);
        const dy = (a.y||0) - (b.y||0);
        const dz = (a.z||0) - (b.z||0);
        return Math.sqrt(dx*dx + dy*dy + dz*dz);
      }

      function _segSegDist3(a0,a1,b0,b1){
        const ux = a1.x - a0.x, uy = a1.y - a0.y, uz = a1.z - a0.z;
        const vx = b1.x - b0.x, vy = b1.y - b0.y, vz = b1.z - b0.z;
        const wx = a0.x - b0.x, wy = a0.y - b0.y, wz = a0.z - b0.z;

        const A = ux*ux + uy*uy + uz*uz;
        const B = ux*vx + uy*vy + uz*vz;
        const C = vx*vx + vy*vy + vz*vz;
        const D = ux*wx + uy*wy + uz*wz;
        const E = vx*wx + vy*wy + vz*wz;
        const den = A*C - B*B;

        let sN, sD = den;
        let tN, tD = den;

        if(den < EPS){
          sN = 0;
          sD = 1;
          tN = E;
          tD = C;
        } else {
          sN = (B*E - C*D);
          tN = (A*E - B*D);
          if(sN < 0){
            sN = 0;
            tN = E;
            tD = C;
          } else if(sN > sD){
            sN = sD;
            tN = E + B;
            tD = C;
          }
        }

        if(tN < 0){
          tN = 0;
          if(-D < 0) sN = 0;
          else if(-D > A) sN = sD;
          else { sN = -D; sD = A; }
        } else if(tN > tD){
          tN = tD;
          if((-D + B) < 0) sN = 0;
          else if((-D + B) > A) sN = sD;
          else { sN = (-D + B); sD = A; }
        }

        const sc = (Math.abs(sN) < EPS ? 0 : sN / sD);
        const tc = (Math.abs(tN) < EPS ? 0 : tN / tD);

        const dx = wx + (sc * ux) - (tc * vx);
        const dy = wy + (sc * uy) - (tc * vy);
        const dz = wz + (sc * uz) - (tc * vz);
        return Math.sqrt(dx*dx + dy*dy + dz*dz);
      }

      function _getCsvRec(p){
        if(p && p._csvRec) return p._csvRec;
        if(!window.csvDet) return null;
        const variants = holeKeyVariants(p.hole || p.name || p.nodeId);
        for(const v of variants){
          if(window.csvDet.byHole && window.csvDet.byHole[v]) return window.csvDet.byHole[v];
          if(window.csvDet.byVariantList && window.csvDet.byVariantList[v] && window.csvDet.byVariantList[v].length){
            return window.csvDet.byVariantList[v][0];
          }
        }

        // Last-resort: nearest CSV hole by XY in local blast coordinates.
        const px = Number(p && p.x), py = Number(p && p.y);
        const rows = (window.csvDet && Array.isArray(window.csvDet.csvHolesMerged) && window.csvDet.csvHolesMerged.length)
          ? window.csvDet.csvHolesMerged
          : ((window.csvDet && Array.isArray(window.csvDet.csvHoles)) ? window.csvDet.csvHoles : []);
        const bo = (window.blstData && window.blstData.blastOrigin) ? window.blstData.blastOrigin : null;
        if(Number.isFinite(px) && Number.isFinite(py) && rows.length){
          let best = null;
          let bestD = Infinity;
          for(const r of rows){
            let rx = Number(r && r.x), ry = Number(r && r.y);
            if(!Number.isFinite(rx) || !Number.isFinite(ry)) continue;
            if(bo && Number.isFinite(bo.easting) && Number.isFinite(bo.northing)){
              rx -= bo.easting;
              ry -= bo.northing;
            }
            const d = Math.hypot(px - rx, py - ry);
            if(d < bestD){ bestD = d; best = r; }
          }
          if(best && bestD <= 1.5) return best;
        }
        return null;
      }

      function _getExplosiveWeight(p){
        const rec = _getCsvRec(p);
        if(rec){
          const w = Number(rec.explosiveWeight);
          if(Number.isFinite(w)) return w;
        }
        // Fallback: estimate from BLST explosive length if available
        const explLen = Number(p && p.explosiveLength);
        if(Number.isFinite(explLen) && explLen > 0){
          // Very rough estimate: 1m of typical explosive ~80-100 kg/m density, assume ~30mm diameter hole
          // For <1.1kg, if explosive_length < 0.02m (~20mm), likely trivial charge
          if(explLen < 0.02) return 0.5;
        }
        return NaN;
      }

      function _getInclinationDeg(p){
        const rec = _getCsvRec(p);
        if(!rec) return NaN;
        const inc = Number(rec.inclination);
        return Number.isFinite(inc) ? inc : NaN;
      }

      function _getExplosiveColumnSegment(p){
        const cx = Number(p.x), cy = Number(p.y), cz = Number(p.elevation);
        if(!Number.isFinite(cx) || !Number.isFinite(cy) || !Number.isFinite(cz)) return null;

        function _toeFromIncBearing(){
          const L = Number(p.length);
          const incDeg = _getInclinationDeg(p);
          const bearingDeg = Number(p.bearing_deg);
          if(!(Number.isFinite(L) && L > 0 && Number.isFinite(incDeg) && Number.isFinite(bearingDeg))) return null;

          const inc = incDeg * Math.PI / 180;
          const br = bearingDeg * Math.PI / 180;
          const horiz = L * Math.sin(inc);
          const dz = L * Math.cos(inc);
          return {
            x: cx + horiz * Math.sin(br),
            y: cy + horiz * Math.cos(br),
            z: cz - dz
          };
        }

        let toe = null;
        if(Number.isFinite(Number(p.toe_x)) && Number.isFinite(Number(p.toe_y)) && Number.isFinite(Number(p.toe_z))){
          toe = { x: Number(p.toe_x), y: Number(p.toe_y), z: Number(p.toe_z) };
        }

        if(!toe){
          toe = _toeFromIncBearing();
        }

        if(!toe) return null;

        const collar = { x: cx, y: cy, z: cz };
        const fullLen = _dist3(toe, collar);
        if(!Number.isFinite(fullLen) || fullLen <= EPS){
          const altToe = _toeFromIncBearing();
          if(!altToe) return null;
          toe = altToe;
        }

        const fullLen2 = _dist3(toe, collar);
        if(!Number.isFinite(fullLen2) || fullLen2 <= EPS) return null;

        let explLen = Number(p.explosiveLength);
        if(!Number.isFinite(explLen) || explLen <= 0) explLen = fullLen2;
        if(explLen > fullLen2) explLen = fullLen2;

        const t = explLen / fullLen2;
        const end = {
          x: toe.x + (collar.x - toe.x) * t,
          y: toe.y + (collar.y - toe.y) * t,
          z: toe.z + (collar.z - toe.z) * t
        };

        return { start: toe, end };
      }

      for(let ai=0; ai<window.pts.length; ai++){
        const a = window.pts[ai];
        // Skip holes known to contain < 1.1 kg explosive OR where weight cannot be determined
        const aW = _getExplosiveWeight(a);
        if(!Number.isFinite(aW) || aW < 1.1) continue;
        const aRec = _getCsvRec(a);
        const aDiaMm = getEffectiveDiameterMm(aRec, a);
        const aRadiusM = Number.isFinite(aDiaMm) ? (aDiaMm / 2000) : 0;
        const aLimit = Number.isFinite(aDiaMm) ? (aDiaMm / 1000 * multiplier) : NaN;
        for(let bi=ai+1; bi<window.pts.length; bi++){
          const b = window.pts[bi];
          const bW = _getExplosiveWeight(b);
          if(!Number.isFinite(bW) || bW < 1.1) continue;
          const bRec = _getCsvRec(b);
          const bDiaMm = getEffectiveDiameterMm(bRec, b);
          const bRadiusM = Number.isFinite(bDiaMm) ? (bDiaMm / 2000) : 0;
          const bLimit = Number.isFinite(bDiaMm) ? (bDiaMm / 1000 * multiplier) : NaN;
          let centerDist = NaN;
          const segA = _getExplosiveColumnSegment(a);
          const segB = _getExplosiveColumnSegment(b);
          if(segA && segB) centerDist = _segSegDist3(segA.start, segA.end, segB.start, segB.end);
          else centerDist = distance(a,b);
          if(!Number.isFinite(aLimit) && !Number.isFinite(bLimit)) continue;

          const diameterOffsetM = aRadiusM + bRadiusM;
          const edgeDist = centerDist - diameterOffsetM;

          const limitRaw = Math.max(Number.isFinite(aLimit) ? aLimit : 0, Number.isFinite(bLimit) ? bLimit : 0);
          const edgeRounded2 = Math.round(edgeDist * 100) / 100;
          const centerRounded2 = Math.round(centerDist * 100) / 100;
          const diameterOffsetRounded3 = Math.round(diameterOffsetM * 1000) / 1000;
          const limitRounded2 = Math.round(limitRaw * 100) / 100;

          // Check threshold using center distance (display still shows edge distance).
          if(centerRounded2 === limitRounded2) continue;
          const withinA = Number.isFinite(aLimit) && centerDist <= aLimit;
          const withinB = Number.isFinite(bLimit) && centerDist <= bLimit;
          if(!withinA && !withinB) continue;
          pairs.push({
            base_hole: a.hole + (a.nodeId!=null ? (' ['+a.nodeId+']') : ''),
            other_hole: b.hole + (b.nodeId!=null ? (' ['+b.nodeId+']') : ''),
            dist:edgeRounded2,
            center_dist:centerRounded2,
            diameter_offset:diameterOffsetRounded3,
            limit:limitRounded2,
            diameter_i:+(Number.isFinite(aDiaMm) ? aDiaMm : 0).toFixed(1),
            diameter_j:+(Number.isFinite(bDiaMm) ? bDiaMm : 0).toFixed(1),
            i:ai,
            j:bi
          });
        }
      }
      pairs.sort((x,y)=>x.dist - y.dist);
      window.mapCallDistancePairs = pairs;
    }


