    function currentTimeConflict(p){
      const useAdjusted = document.getElementById('useAdjusted').checked;
      if(useAdjusted && Number.isFinite(p.adj)) return p.adj;
      // Prefer the currently displayed time value, which is CSV-backed when available and BLST-backed otherwise.
      return Number.isFinite(p.time)
        ? p.time
        : (Number.isFinite(p.time_csv) ? p.time_csv : (Number.isFinite(p.time_blst) ? p.time_blst : NaN));
