function detectMineSiteFromBlastText(text){
  const source = String(text || '');
  if(!source) return '';

  const candidates = [];
  const seen = new Set();

  const collectMatches = (re) => {
    let match;
    while((match = re.exec(source)) !== null){
      const value = String(match[1] || '').trim();
      if(!value || seen.has(value)) continue;
      seen.add(value);
      candidates.push(value);
    }
  };

  collectMatches(/^\s*set\s+_rt__blast_name\s+([^\r\n]+)/gim);
  collectMatches(/^\s*set\s+Name\s+([^\r\n]+)/gim);

  for(const value of candidates){
    for(const matcher of MINE_SITE_MATCHERS){
      if(matcher.codes.some(code => value.includes(code))) return matcher.site;
    }
  }

  return '';
}

function syncMineSiteFromBlastText(text){
  const mineSiteSelect = document.getElementById('mineSite');
  if(!mineSiteSelect) return '';

  const nextSite = detectMineSiteFromBlastText(text);
  if(mineSiteSelect.value !== nextSite){
    mineSiteSelect.value = nextSite;
    mineSiteSelect.dispatchEvent(new Event('change', { bubbles: true }));
  }
  return nextSite;
}

