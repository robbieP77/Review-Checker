  if(h&&b&&a){a.classList.add('rotated');b.style.display='none';h.addEventListener('click',()=>{const sh=b.style.display!=='block';b.style.display=sh?'block':'none';a.classList.toggle('rotated',!sh);s.textContent=sh?'open':'collapsed';});}
  const d=document.getElementById('util-drop'),f=document.getElementById('util-file'),st=document.getElementById('util-status'),jb=document.getElementById('util-jobs');
  const bc=document.getElementById('util-btnClear'),bu=document.getElementById('util-btnUse'),bd=document.getElementById('util-btnDownload');
  const set=(m,k='')=>{st.textContent=m;st.className='util-status'+(k?' '+k:'');};
  function split(l,del){const o=[];let c='',q=false;for(let i=0;i<l.length;i++){const ch=l[i];if(q){if(ch==='"'){if(i+1<l.length&&l[i+1]==='"'){c+='"';i++;}else q=false;}else c+=ch;}else{if(ch==='"')q=true;else if(ch===del){o.push(c);c='';}else c+=ch;}}o.push(c);return o;}
  function det(l){const cs=[',',';','\t'];let b=',',n=-1;for(const d of cs){const c=split(l,d).length;if(c>n){n=c;b=d;}}return b;}
  function parse(t){t=String(t||'').replace(/\r\n/g,'\n').replace(/\r/g,'\n');const ls=t.split('\n').filter(x=>x.length);if(!ls.length)throw Error('CSV is empty');const d=det(ls[0]);return{h:split(ls[0],d),r:ls.slice(1).map(x=>split(x,d))};}
  function add01(v){const s=String(v != null ? v : '').trim();if(!/^[-+]?((\d+(\.\d*)?)|(\.\d+))$/.test(s))return v;const neg=s[0]==='-';const t=(s[0]==='-'||s[0]==='+')?s.slice(1):s;const parts=t.split('.');const A=parts[0]||'0';const B=parts[1]||'';const d=Math.max(B.length,2);let sc=1n;for(let i=0;i<d;i++)sc*=10n;const ip=A.replace(/^0+(?=\d)/,'')||'0';let am=BigInt(ip+(B+'0'.repeat(d)).slice(0,d));am=neg?-am:am;const res=am+(neg?-1n:1n)*(sc/100n);let z=(res<0n?-res:res).toString();if(z.length<=d)z='0'.repeat(d+1-z.length)+z;let o=z.slice(0,z.length-d)+'.'+z.slice(z.length-d);return(res<0n?'-':'')+o.replace(/(\.\d*?)0+$/,'$1').replace(/\.$/,'');}
  function esc(v){const s=String(v==null?'':v);
  return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;
  }
  function build(n,h,r){if(h.length<7)throw Error('Input needs ≥ 7 columns');const oh=[h[0],h[1],h[2],h[3],h[5],h[6]],or=[];for(const x of r){const y=x.slice();while(y.length<7)y.push('');or.push([y[0],y[1],y[2],y[3],y[5],y[6]]);}for(const x of r){const y=x.slice();while(y.length<7)y.push('');let d=[y[0],y[1],y[2],y[3],y[4],y[6]];if(String(d[0]||'').trim()&&String(d[0]).slice(-1).toUpperCase()!=='A')d[0]=d[0]+'A';d[2]=add01(d[2]);or.push(d);}const f=or.filter(x=>String(x[4] != null ? x[4] : '').trim()!=='');const ls=[oh.map(esc).join(',')];for(const x of f)ls.push(x.map(esc).join(','));return{t:ls.join('\r\n')+'\r\n',o:String(n||'decks').replace(/\.[^.]+$/,'')+'_transformed.csv',c:f.length,inName:n};}
  function dl(t,n){const b=new Blob([t],{type:'text/csv'}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=n;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2e3);} 
  async function hFiles(fs){const arr=Array.from(fs||[]).filter(x=>x&&x.name);if(!arr.length)return;for(const f0 of arr){try{set('Processing '+f0.name+'…');const p=parse(await f0.text());const o=build(f0.name,p.h,p.r);jb.innerHTML='<tr><td>'+f0.name+'</td><td>'+o.o+'</td><td>'+o.c+'</td><td><span class="small muted">ready</span></td></tr>';window.decksCsvTransform_latest=o;bu.disabled=false;bd.disabled=false;set('Ready: '+f0.name,'good');s.textContent='last: '+f0.name;}catch(e){console.error(e);set('Error: '+(e.message||e),'bad');}}}
  if(d&&f){d.addEventListener('click',()=>f.click());d.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();f.click();}});f.addEventListener('change',()=>hFiles(f.files));['dragenter','dragover'].forEach(ev=>d.addEventListener(ev,e=>{e.preventDefault();e.stopPropagation();d.classList.add('drag');}));['dragleave','drop'].forEach(ev=>d.addEventListener(ev,e=>{e.preventDefault();e.stopPropagation();d.classList.remove('drag');}));d.addEventListener('drop',e=>{const dt=e.dataTransfer; if(dt&&dt.files)hFiles(dt.files);});}
  if(bc) bc.addEventListener('click',()=>{if(f)f.value='';jb.innerHTML='<tr><td colspan="4" class="small">No file processed yet.</td></tr>';window.decksCsvTransform_latest=null;bu.disabled=true;bd.disabled=true;set('Waiting for a CSV…');s.textContent='—';});
  if(bd) bd.addEventListener('click',()=>{const l=window.decksCsvTransform_latest;if(l)dl(l.t,l.o);});
  if(bu) bu.addEventListener('click',()=>{const l=window.decksCsvTransform_latest;if(!l)return;const file=new File([l.t],l.o,{type:'text/csv'});const t=document.getElementById('fileCsv'),n=document.getElementById('csvName');if(!t){set('Pairs Checker CSV input (#fileCsv) not found','bad');return;}try{const dt=new DataTransfer();dt.items.add(file);t.files=dt.files;if(n)n.textContent=file.name;t.dispatchEvent(new Event('change',{bubbles:true}));set('Transformed CSV loaded into Pairs Checker','good');}catch(err){console.error(err);set('Could not set CSV input automatically — use Download then upload manually','bad');}});
  set('Waiting for a CSV…');
})();
</script>

