      const columnsY = pagePad + headerBlockH + 22;
      const summaryX = topCardX + 12;
      const summaryY = columnsY;
      const summaryH = columnsH;
      ctx.fillStyle = themeSurface2;
      drawRoundedRect(ctx, summaryX, summaryY, leftCardW, summaryH, 10);
