    function calcPPVAtReceiver(receiver, holes, settings, overrides){
      const alg = overrides.algorithm || 'consider_timing';
      const K = overrides.K;
      const n = overrides.n;
      const vp = overrides.vp;
      const T0 = overrides.T0;
      const alpha = overrides.alpha;
      const Cw = overrides.Cw;

      const eligible = holes.filter(h =>
        h.hasPrimer &&
        h.detonation_ms != null &&
        Number.isFinite(h.detonation_ms) &&
        h.charge_kg != null &&
        h.charge_kg > 0 &&
        Number.isFinite(h.x) && Number.isFinite(h.y)
      );

      if(!eligible.length) return null;

      // Per-hole distance, scaled distance and arrival time
      eligible.forEach(h=>{
        const dx = h.x - receiver.x;
        const dy = h.y - receiver.y;
        const R = Math.sqrt(dx*dx + dy*dy);
        h._R = R;
        h._sd = R / Math.sqrt(h.charge_kg);
        h._tarr = h.detonation_ms + (R / vp) * 1000.0; // ms
      });

      // Dominant hole = minimum scaled distance (Paradigm manual behaviour)
      const dominant = eligible.reduce((best,h)=> (best==null || h._sd < best._sd) ? h : best, null);
      if(!dominant) return null;

      const R_dom = dominant._R;
      const Q_dom = dominant.charge_kg;
      const t_dom = dominant._tarr;

      let Q_total = Q_dom;

      if(alg === 'consider_timing'){
        const T_dom = T0 + alpha * R_dom;
        const minQ = 0.02 * Q_dom; // 2% threshold (Paradigm manual)
        Q_total = 0;

        eligible.forEach(h=>{
          if(h.charge_kg < minQ) return;
          const dt = h._tarr - t_dom;
          // LLM-derived approximation of Paradigm/Yang&Scovira time weighting:
          // weight = exp(-Cw * (dt / T_dom)^2)
          const denom = (T_dom > 0 ? T_dom : 1e-9);
          const w = Math.exp(-Cw * Math.pow(dt / denom, 2));
          Q_total += w * h.charge_kg;
        });

        // Guard against numerical underflow
        if(!(Q_total > 0)) Q_total = Q_dom;
      }

      const ppv = K * Math.pow(R_dom / Math.sqrt(Q_total), -n);

      return {
        receiverName: receiver.name,
        enabled: receiver.enabled,
        ppv_mm_s: ppv,
        dominantHole: dominant,
        R_dom_m: R_dom,
        Q_dom_kg: Q_dom,
        Q_total_kg: Q_total,
        ratio: Q_total / Q_dom,
        ppvLimit_mm_s: receiver.ppvMax_mps != null ? receiver.ppvMax_mps * 1000.0 : null
      };
    }

