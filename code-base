          const b = pts[j];
          const tb = currentTimeConflict(b);
          const dt = Math.abs(ta - tb);
          if (dt > tol) continue;
          const dist = distance(a,b);
          const within =
            (Number.isFinite(a.glimit) && dist <= a.glimit) ||
            (Number.isFinite(b.glimit) && dist <= b.glimit);
          if (!within) continue;
