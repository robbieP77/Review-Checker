function csvEscape(v){
  const s = String(v==null?'':v);
  return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;
}

function buildCsvMetaLines(exportType){
  const ts = new Date().toISOString();
  const tol = Math.round(parseNumber((document.getElementById('tol') && document.getElementById('tol').value) || ''));
  const mult = parseNumber((document.getElementById('multiplier') && document.getElementById('multiplier').value) || '');
  const useAdj = !!(document.getElementById('useAdjusted') && document.getElementById('useAdjusted').checked);
  const autoAdj = !!(document.getElementById('autoSuggestAdj') && document.getElementById('autoSuggestAdj').checked);

  const blstName = window.blstFilename || '';
  const csvNameEl = document.getElementById('csvName');
  const csvName = csvNameEl ? (csvNameEl.textContent || '') : '';

  const lines = [];
  lines.push(`# export_type=${exportType}`);
  lines.push(`# generated_utc=${ts}`);
  if(blstName) lines.push(`# blst_file=${blstName}`);
  if(csvName && !/drop\s+\.csv/i.test(csvName)) lines.push(`# csv_file=${csvName}`);
  lines.push(`# tol_ms=${Number.isFinite(tol)?tol:''}`);
  lines.push(`# distance_multiplier=${Number.isFinite(mult)?mult:''}`);
  lines.push(`# use_adjusted=${useAdj ? 'true' : 'false'}`);
  lines.push(`# auto_suggest_adjusted=${autoAdj ? 'true' : 'false'}`);
  lines.push(`# csv_mode_active=${window.csvModeActive ? 'true' : 'false'}`);
  if(window.csvDet && window.csvDet.meta){
    const m = window.csvDet.meta;
    lines.push(`# csv_has_header=${m.hasHeader ? 'true' : 'false'}`);
    if(m.cols){
      const c = m.cols;
      const colNum = (i)=> (i==null || i<0) ? '' : String(i+1);
      lines.push(`# csv_col_hole=${colNum(c.hole)}`);
      lines.push(`# csv_col_x=${colNum(c.x)}`);
      lines.push(`# csv_col_y=${colNum(c.y)}`);
      lines.push(`# csv_col_time=${colNum(c.time)}`);
      lines.push(`# csv_col_diameter=${colNum(c.diameter)}`);
    }
  }
  return lines;
}

