    function hasInhibitedProductSelected(){
      const chargeRules = (window.blstData && window.blstData.chargeRules)
        ? Object.values(window.blstData.chargeRules)
        : [];
      const sectionRules = (window.blstData && window.blstData.sectionRules)
        ? window.blstData.sectionRules
        : {};
      const explosives = (window.blstData && window.blstData.explosives)
        ? window.blstData.explosives
        : {};
      const inhibitedExplosives = new Set([
        'APEX 2320 (1.0)',
        'APEX 2330 (1.1)',
        'APEX 2335 (1.2)',
        'APEX 2370 (1.1)',
        'APEX 2370 (1.2)'
      ].map(value => value.toLowerCase().replace(/[^a-z0-9]+/g, '')));
      const inhibitedNames = new Set([
        'Inh A10',
        'Inh A11',
        'Inh A12',
        'Inh A11G',
        'Inh A12G'
      ].map(value => value.toLowerCase().replace(/[^a-z0-9]+/g, '')));
      const normalize = value => String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, '');

      return chargeRules.some(chargeRule => {
        if(inhibitedNames.has(normalize(chargeRule && chargeRule.name))) return true;

        return (Array.isArray(chargeRule && chargeRule.sections) ? chargeRule.sections : []).some(sectionId => {
          const section = sectionRules[String(sectionId)] || sectionRules[sectionId];
          if(!section) return false;
          if(inhibitedNames.has(normalize(section.name))) return true;

          const explosiveId = section.explosiveType != null ? String(section.explosiveType) : '';
          const explosive = explosiveId ? explosives[explosiveId] : null;
          return inhibitedExplosives.has(normalize(explosive && explosive.name));
        });
      });
    }

