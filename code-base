        elevation: parseFloat(boMatch[2]),
        northing: parseFloat(boMatch[3])
      } : null;

      
      // Build maps from the parseBLST output (time + charge rule + primer) by NodeId.
      // Using NodeId avoids "last write wins" bugs when multiple holes share the same name (e.g., joined patterns).
      const header = aoa[0] || [];
      const iId   = header.indexOf("NodeId");
      const iName = header.indexOf("Hole #");
      const iTime = header.indexOf("Time");
      const iCR   = header.indexOf("ChargeRule");
      const iPrim = header.indexOf("HasPrimer");
      const iBranch = header.indexOf("Branch");

      const byNodeId = {};
      for(let i=1;i<aoa.length;i++){
        const row = aoa[i];
        const idRaw = (iId >= 0) ? row[iId] : null;
        const nodeId = (idRaw == null || idRaw === '') ? NaN : parseInt(String(idRaw).trim(), 10);
        if(!Number.isFinite(nodeId)) continue;

        const nm = String((iName >= 0 ? row[iName] : '') != null ? (iName >= 0 ? row[iName] : '') : '').trim();
        const t = (iTime >= 0 ? row[iTime] : null);

        byNodeId[nodeId] = {
          name: nm,
          detonation_ms: (t === "" || t == null || !isFinite(parseFloat(t))) ? null : parseFloat(t),
          chargeRuleName: (iCR >= 0 ? ((row[iCR] != null) ? row[iCR] : "") : ""),
          hasPrimer: String((iPrim >= 0 ? row[iPrim] : "") != null ? (iPrim >= 0 ? row[iPrim] : "") : "").toLowerCase().startsWith("y"),
          branch: (iBranch >= 0 && row[iBranch] != null) ? normalizeBranchValue(row[iBranch]) : ''
        };
      }

      // Parse hole geometry + charge from BLST

      const explosives = parseExplosiveTypes(text);
      const {chargeRules, sectionRules} = parseChargeRulesAndSections(text);
      const holeChargeRules = parseHoleChargeRules(text, chargeRules);
      const rioCharge = parseRioChargeSettings(text);

      // Blast positions (absolute) then convert to local
      const blastPos = {};
      const bpMatch = text.match(/set\s+BlastPosition\s*\{([\s\S]*?)\}/);
      if(bpMatch){
        const body = bpMatch[1];
        const lines = body.split(/\r?\n/).map(s=>String(s||'').trim()).filter(s=>s.length);
        for(let i=0;i<lines.length;i++){
          const line = lines[i];

          // Format B: "id (E, Z, N)" on a single line
          let m = line.match(/^(\d+)\s*\(\s*([\-0-9.]+)\s*,\s*([\-0-9.]+)\s*,\s*([\-0-9.]+)\s*\)\s*$/);
          if(m){
            blastPos[parseInt(m[1],10)] = {E:parseFloat(m[2]), Z:parseFloat(m[3]), N:parseFloat(m[4])};
