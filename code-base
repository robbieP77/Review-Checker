    }
  }

  const detailsLink = `<a href="javascript:void(0)" class="matchDiagOpen small muted" style="text-decoration:underline">match details</a>`;
  const noteHtml = `${esc(baseMsg)}<br><span class="small muted">${esc(diagMsg)} ${detailsLink}</span>` +
    (mapHtml ? `<br><span class="small muted">${mapHtml}</span>` : '');

  [timingNoteTop, timingNoteMap, timingNoteAnim].forEach(el=>{
