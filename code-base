    function getSdobHoleLengthMeters(p, csvRec){
  let length = Number(csvRec && csvRec.length);

  if(!Number.isFinite(length)){
    const x = Number(csvRec && csvRec.x);
    const y = Number(csvRec && csvRec.y);
    const z = Number(csvRec && csvRec.elevation);
    const toeX = Number(csvRec && csvRec.toeX);
    const toeY = Number(csvRec && csvRec.toeY);
    const toeZ = Number(csvRec && csvRec.toeZ);
    if(Number.isFinite(x) && Number.isFinite(y) && Number.isFinite(z) && Number.isFinite(toeX) && Number.isFinite(toeY) && Number.isFinite(toeZ)){
      const dx = toeX - x;
      const dy = toeY - y;
      const dz = toeZ - z;
      length = Math.sqrt(dx*dx + dy*dy + dz*dz);
    }
  }

  if(!Number.isFinite(length)){
    length = parseNumber(p && (p.length_m ?? p.length ?? p['Length (m)'] ?? p.Length));
  }

  if(!Number.isFinite(length)){
    const z = Number(p && p.elevation);
    const toeZ = Number(p && p.toe_z);
    if(Number.isFinite(z) && Number.isFinite(toeZ)){
      length = Math.abs(toeZ - z);
    }
  }

  return Number.isFinite(length) ? length : NaN;
}

