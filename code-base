  const parts = [];

  if(!hasCsv){
    parts.push('Exports requiring timing (pairs / adjusted / BLST) need a detonation-time CSV.');
  } else {
    parts.push('CSV timing loaded.');
  }

  if(!hasBlst){
    parts.push('BLST not loaded (BLST export disabled).');
  } else if(!preflightOk){
    parts.push('BLST export preflight failed: ' + (window.blstExportInfo.reason || 'unknown reason') + '.');
  } else {
    parts.push('BLST export preflight OK.');
  }

  if(!adjustedAny){
