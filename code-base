      ctx.strokeStyle = themeBorder;
      ctx.stroke();

      const sectionX = summaryX + leftCardW + colGap;
      const sectionYBase = columnsY;
      drawRoundedRect(ctx, sectionX, sectionYBase, rightCardW, summaryH, 10);
      ctx.fillStyle = themeSurface;
      ctx.fill();
      ctx.strokeStyle = themeBorder;
      ctx.stroke();

      ctx.fillStyle = themeAccent;
      ctx.fillRect(summaryX, summaryY, 4, summaryH);
      ctx.fillRect(sectionX, sectionYBase, 4, summaryH);

      ctx.fillStyle = themeTitleText;
      ctx.font = '700 13px system-ui, -apple-system, Segoe UI, Roboto, sans-serif';
      ctx.textBaseline = 'top';
      ctx.textAlign = 'left';
      ctx.fillText('Summary', summaryX + 12, summaryY + 10);

      ctx.font = '12px system-ui, -apple-system, Segoe UI, Roboto, sans-serif';
      ctx.textBaseline = 'middle';
      const statusColW = Math.max(170, Math.min(260, Math.floor(leftCardW * 0.42)));
      const statusX = summaryX + leftCardW - 12 - statusColW;
      summaryItems.forEach((item, index)=>{
        const rowY = summaryY + 12 + summaryTitleH + (index * summaryRowH) + (summaryRowH / 2);
        if(index > 0){
          ctx.strokeStyle = themeDivider;
          ctx.beginPath();
          ctx.moveTo(summaryX + 12, rowY - (summaryRowH / 2) - 2);
          ctx.lineTo(summaryX + leftCardW - 12, rowY - (summaryRowH / 2) - 2);
          ctx.stroke();
        }
        ctx.fillStyle = themeMutedText;
        ctx.textAlign = 'left';
        ctx.fillText(item.label + ':', summaryX + 12, rowY);

        const statusKind = item.status || (item.warn ? 'warn' : 'passed');
        const statusText = item.statusLabel || (statusKind === 'warn' ? 'Requires review' : (statusKind === 'confirm' ? 'Confirm ok' : (statusKind === 'bad' ? 'Pattern is marked NOT sensitive' : 'Passed')));
        const detailText = item.detail ? ` - ${item.detail}` : '';

        ctx.fillStyle = statusKind === 'warn' ? '#f97316' : (statusKind === 'confirm' ? '#3b82f6' : (statusKind === 'bad' ? '#ef4444' : '#16a34a'));
        ctx.textAlign = 'left';
        ctx.fillText(statusText, statusX, rowY);

        if(detailText){
          const statusWidth = ctx.measureText(statusText).width;
          ctx.fillStyle = themeMutedText;
          ctx.fillText(detailText, statusX + statusWidth + 6, rowY);
        }
      });

      let sectionY = sectionYBase + 10;
      ctx.fillStyle = themeTitleText;
      ctx.font = '700 12px system-ui, -apple-system, Segoe UI, Roboto, sans-serif';
      ctx.textBaseline = 'top';
      ctx.textAlign = 'left';
      ctx.fillText('SectionRules headings', sectionX + 12, sectionY);
