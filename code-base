          isolatedHighDiff.add(i);
          const p = pts[i];
          const ti = times[i];
          failureRows.push({
            check: '300 ms difference',
            hole: String(p.hole != null ? p.hole : ''),
            timingMs: ti
          });
        }
      }

      for(let i=0;i<pts.length;i++){
        const p = pts[i];
        const [sx,sy] = worldToScreen(p.x,p.y,firingSequenceCanvas);
        firingSequenceCtx.beginPath();
        firingSequenceCtx.arc(sx,sy,4,0,Math.PI*2);
        if(isolatedHighDiff.has(i)){
          firingSequenceCtx.fillStyle = '#ff4fb3';
        } else if(Number.isFinite(times[i]) && times[i] < 0){
          firingSequenceCtx.fillStyle = '#22c55e';
        } else if(Number.isFinite(times[i])){
          firingSequenceCtx.fillStyle = '#38bdf8';
        } else {
          firingSequenceCtx.fillStyle = 'rgba(148,163,184,0.4)';
        }
        firingSequenceCtx.fill();
        if(showHoleLabels){
          firingSequenceCtx.fillStyle=getThemeCssVar('--map-label-text', '#cbd5e1');
          firingSequenceCtx.fillText(p.hole,sx,sy-6);
        }
      }

      if(listBody){
        if(failureRows.length){
          failureRows.sort((a,b)=>String(a.hole).localeCompare(String(b.hole), undefined, {numeric:true, sensitivity:'base'}));
          listBody.innerHTML = failureRows
            .map(r=>`<tr><td>${escapeHTML(r.check)}</td><td>${escapeHTML(r.hole)}</td><td>${escapeHTML(Number(r.timingMs).toFixed(0))}</td></tr>`)
            .join('');
        } else {
          listBody.innerHTML = '<tr><td colspan="3" class="muted">No Firing Sequence check failures found.</td></tr>';
        }
      }
    }

    // Animation

    function prepareAnim(){
      const times = pts
        .filter(p=>p.hasPrimer)
        .map(p=>currentTime(p))
        .filter(Number.isFinite);
      if(times.length){
        animMin = Math.min(...times);
        animMax = Math.max(...times);
        animT = animMin;
      } else {
        animMin = 0;
        animMax = 0;
        animT = 0;
      }
      updateTimeReadout();
      drawAnim();
    }

    function updateTimeReadout(){
      document.getElementById('timeReadout').textContent = `t = ${Math.round(animT)} ms`;
    }

    function drawAnim(){
      if(!view || !pts.length){
        animCtx.clearRect(0,0,animCanvas.width,animCanvas.height);
        return;
      }
      const w = animCanvas.width / (window.devicePixelRatio||1);
      const h = animCanvas.height / (window.devicePixelRatio||1);
      animCtx.clearRect(0,0,w,h);
      drawGrid(animCtx,animCanvas);

      animCtx.font = '12px ui-monospace, Menlo, Consolas, monospace';
      animCtx.textAlign='center';
      animCtx.textBaseline='bottom';

      for(const p of pts){
        if(!p.hasPrimer){
          const [sx,sy]=worldToScreen(p.x,p.y,animCanvas);
          animCtx.beginPath();
          animCtx.arc(sx,sy,4,0,Math.PI*2);
          animCtx.fillStyle='rgba(148,163,184,0.4)';
          animCtx.fill();
        }
      }

      const timedPts = pts.filter(p => p.hasPrimer).sort((a,b) => (currentTime(a) || 0) - (currentTime(b) || 0));

      for(const p of timedPts){
        const [sx,sy]=worldToScreen(p.x,p.y,animCanvas);
        const t = currentTime(p);
        const fired = Number.isFinite(t) && t <= animT;
        animCtx.beginPath();
        animCtx.arc(sx,sy,4,0,Math.PI*2);
        animCtx.fillStyle = fired ? '#ef4444' : '#38bdf8';
        animCtx.fill();
        if(fired && showHoleLabels){
          animCtx.fillStyle=getThemeCssVar('--map-label-text', '#cbd5e1');
          animCtx.fillText(p.hole,sx,sy-6);
        }
      }
    }

    function tick(ts){
      if(!animRunning) return;
      if(!lastRAF) lastRAF = ts;
      const dtSec = (ts - lastRAF)/1000;
      lastRAF = ts;
      const speed = parseNumber(document.getElementById('speed').value) || 1;
      animT += dtSec * 1000 * speed;
      if(animT > animMax){
        animT = animMax;
        animRunning = false;
        document.getElementById('btnPlay').textContent='Play';
      }
      updateTimeReadout();
      drawAnim();
      if(animRunning) requestAnimationFrame(tick);
    }

    // Pointer / wheel

    function onWheel(e){
      if(!view) return;
      e.preventDefault();
      const canvas = e.target;
      const rect = canvas.getBoundingClientRect();
      const px = (e.clientX - rect.left) * (canvas.width/rect.width);
      const py = (e.clientY - rect.top) * (canvas.height/rect.height);
      const [wx,wy] = screenToWorld(px,py,canvas);
      const scale = Math.exp(-e.deltaY * 0.0015);
      const newW = (view.maxX-view.minX)/scale;
      const newH = (view.maxY-view.minY)/scale;
      const rx = (wx-view.minX)/(view.maxX-view.minX);
      const ry = (wy-view.minY)/(view.maxY-view.minY);
      const minX = wx - rx*newW;
      const maxX = minX + newW;
      const minY = wy - ry*newH;
      const maxY = minY + newH;
      view = {minX,maxX,minY,maxY};
      drawMap();
      drawMyMap();
      drawShortHoleMap();
      drawAnim();
      drawExplosiveWeightMap();
      drawColumnLengthMap();
      drawSdoBMap();
      drawMapCallReviewMap();
      drawFiringSequenceMap();
    }

    function onPointerDown(e){
      if(!view) return;
      dragging = true;
      const canvas = e.target;
      if(canvas && typeof canvas.setPointerCapture === 'function'){
        canvas.setPointerCapture(e.pointerId);
      }
      dragStart = {x:e.clientX,y:e.clientY,canvas};
      viewStart = {...view};
    }

    function onPointerMove(e){
      if(!dragging || !view) return;
      const canvas = dragStart.canvas;
      const rect = canvas.getBoundingClientRect();
      const dx = e.clientX - dragStart.x;
      const dy = e.clientY - dragStart.y;
      const worldW = viewStart.maxX-viewStart.minX;
      const worldH = viewStart.maxY-viewStart.minY;
      const sx = dx/rect.width*worldW;
      const sy = -dy/rect.height*worldH;
      view = {
        minX:viewStart.minX - sx,
        maxX:viewStart.maxX - sx,
        minY:viewStart.minY - sy,
        maxY:viewStart.maxY - sy
      };
      drawMap();
      drawMyMap();
      drawShortHoleMap();
      drawAnim();
      drawExplosiveWeightMap();
      drawColumnLengthMap();
      drawSdoBMap();
      drawMapCallReviewMap();
      drawFiringSequenceMap();
    }

    function onPointerUp(){
      dragging=false;
    }

