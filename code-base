    function getSectionRulesNameForPoint(point){
      const blstHoles = (window.blstData && Array.isArray(window.blstData.holes)) ? window.blstData.holes : [];
      const chargeRules = (window.blstData && window.blstData.chargeRules) ? Object.values(window.blstData.chargeRules) : [];
      const sectionRulesById = (window.blstData && window.blstData.sectionRules) ? window.blstData.sectionRules : {};
      if(!point || !chargeRules.length) return '';

      const csvRecord = getCsvRecordForPoint(point);
      let chargeRuleName = String(
        (csvRecord && (csvRecord.chargeName || csvRecord['Charge Name'] || csvRecord.chargeRule || csvRecord.chargeRuleName)) ||
        point.chargeRuleName || point.chargeRule || ''
      ).trim();
      if(!chargeRuleName && blstHoles.length){
        const pointVariants = holeKeyVariants(point.hole || point.name || point.id || point.nodeId);
        const blstHole = blstHoles.find(hole => {
          if(Number.isFinite(Number(point.nodeId)) && Number.isFinite(Number(hole && hole.nodeId)) && Number(point.nodeId) === Number(hole.nodeId)) return true;
          const holeVariants = holeKeyVariants(hole && (hole.name || hole.id || hole.nodeId));
          return holeVariants.some(value => pointVariants.includes(value));
        });
        chargeRuleName = String(blstHole && blstHole.chargeRuleName || '').trim();
      }
      if(!chargeRuleName) return '';

      const chargeRuleKey = normalizeChargeRuleName(chargeRuleName);
      const chargeRule = chargeRules.find(rule => normalizeChargeRuleName(rule && rule.name) === chargeRuleKey);
      if(!chargeRule || !Array.isArray(chargeRule.sections)) return '';

      return chargeRule.sections
        .map(sectionId => sectionRulesById[String(sectionId)] || sectionRulesById[sectionId])
        .map(section => String(section && section.name || '').trim())
        .filter(Boolean)
        .map(name => `set Name ${name}`)
        .join(', ');
    }

    function getWeightMapReviewRows(){
      if(!Array.isArray(pts) || !pts.length) return [];

      const weightRows = [];
      for(const p of pts){
        if(!p || !Number.isFinite(p.x) || !Number.isFinite(p.y)) continue;
        const csvRec = getCsvRecordForPoint(p);
        const weight = Number(csvRec && csvRec.explosiveWeight);
        const diameterMm = getEffectiveDiameterMm(csvRec, p);
        const airM = getEffectiveAirM(csvRec, p);
        if(!isWeightMapReviewIssue(weight, diameterMm, airM)) continue;

        weightRows.push({
          hole: String(p.hole != null ? p.hole : ''),
          weight,
          airM,
          diameter: Number(csvRec && csvRec.diameterMm),
          explosiveLength: Number(csvRec && csvRec.explosiveLength),
          fallbackDiameter: Number(p && p.diameter),
          fallbackExplosiveLength: Number(p && p.explosiveLength),
          sectionRulesName: getSectionRulesNameForPoint(p)
        });
      }

      weightRows.sort((a,b)=>String(a.hole).localeCompare(String(b.hole), undefined, {numeric:true, sensitivity:'base'}));
      return weightRows;
    }

    function getLowWeightNonExcludedChargeRuleHoles(){
      const chargeRules = (window.blstData && window.blstData.chargeRules) ? Object.values(window.blstData.chargeRules) : [];
      const sectionRulesById = (window.blstData && window.blstData.sectionRules) ? window.blstData.sectionRules : {};
      const explosivesById = (window.blstData && window.blstData.explosives) ? window.blstData.explosives : {};
      const blstHoles = (window.blstData && Array.isArray(window.blstData.holes)) ? window.blstData.holes : [];
      const excludedRe = /\b(?:ntbc|hrdc)\b/i;
      const inertNameRe = /\b(?:air|stemming)\b/i;
      const affectedHoles = new Set();

      const assignedChargeRuleNames = new Set(
        blstHoles
          .map(hole => String((hole && hole.chargeRuleName) || '').trim().toLowerCase())
          .filter(Boolean)
      );

      const isExplosiveSection = (section) => {
        if(!section) return false;

        const sectionName = String(section.name || '');
        if(inertNameRe.test(sectionName) || isNonExplosiveMaterial(sectionName)) return false;

        const explosiveId = section.explosiveType;
        if(explosiveId == null) return false;

        const explosive = explosivesById[String(explosiveId)] || explosivesById[explosiveId];
        const explosiveName = String((explosive && explosive.name) || '');
        if(inertNameRe.test(explosiveName) || isNonExplosiveMaterial(explosiveName)) return false;

        return true;
      };

      for(const chargeRule of chargeRules){
        if(!chargeRule || !Array.isArray(chargeRule.sections) || !chargeRule.sections.length) continue;

        const chargeRuleName = String(chargeRule.name || '').trim();
        const chargeRuleKey = chargeRuleName.toLowerCase();
        if(!assignedChargeRuleNames.has(chargeRuleKey)) continue;

        const sections = chargeRule.sections
          .map(sectionId => sectionRulesById[String(sectionId)] || sectionRulesById[sectionId])
          .filter(Boolean);

        const hasExcludedName = excludedRe.test(chargeRuleName) || sections.some(section => {
          const sectionName = String((section && section.name) || '');
          return excludedRe.test(sectionName);
        });
        if(hasExcludedName) continue;

        const explosiveSections = sections.filter(section => isExplosiveSection(section));
        const hasLowFixedExplosiveSection = explosiveSections.some(section => {
          const sectionWeightKg = Number(section && section.weight_g != null ? section.weight_g : NaN) / 1000;
          return Number.isFinite(sectionWeightKg) && sectionWeightKg < 1;
        });
        const hasVariableExplosiveSection = explosiveSections.some(section => {
          const sectionWeightKg = Number(section && section.weight_g != null ? section.weight_g : NaN) / 1000;
          return !Number.isFinite(sectionWeightKg);
        });
        if(!hasLowFixedExplosiveSection && !hasVariableExplosiveSection) continue;

        blstHoles.forEach(hole => {
          const holeChargeRuleName = String((hole && hole.chargeRuleName) || '').trim().toLowerCase();
          if(holeChargeRuleName === chargeRuleKey){
            if(hole && hole.hasPrimer === false) return;
            const holeVariants = holeKeyVariants(hole && (hole.name || hole.id || hole.nodeId));
            const point = Array.isArray(pts) ? pts.find(candidate => {
              if(Number.isFinite(Number(candidate && candidate.nodeId)) && Number.isFinite(Number(hole && hole.nodeId)) && Number(candidate.nodeId) === Number(hole.nodeId)) return true;
              const pointVariants = holeKeyVariants(candidate && (candidate.hole || candidate.name || candidate.id || candidate.nodeId));
              return pointVariants.some(value => holeVariants.includes(value));
            }) : null;
            const directCsvRecord = getCsvRecordForHoleValue(hole && (hole.name || hole.id || hole.nodeId));
            const csvRecord = directCsvRecord || (point ? getCsvRecordForPoint(point) : null);
            const csvChargeName = String(
              (csvRecord && (csvRecord.chargeName || csvRecord['Charge Name'] || csvRecord.chargeRule || csvRecord.chargeRuleName)) ||
              ''
            );
            if(excludedRe.test(csvChargeName)) return;
            if(!hasLowFixedExplosiveSection && hasVariableExplosiveSection){
              const csvWeightKg = Number(csvRecord && csvRecord.explosiveWeight);
              if(Number.isFinite(csvWeightKg) && csvWeightKg >= 1) return;
            }
            affectedHoles.add(String(hole.name != null ? hole.name : ''));
          }
        });
      }

      return Array.from(affectedHoles).filter(Boolean).sort((a,b)=>String(a).localeCompare(String(b), undefined, {numeric:true, sensitivity:'base'}));
    }

    function getWeightMapTableRows(){
      const weightRows = getWeightMapReviewRows();
      const seenHoles = new Set(weightRows.map(row => normHoleKey(row.hole)));
      const lowWeightHoles = getLowWeightNonExcludedChargeRuleHoles();

      lowWeightHoles.forEach(holeName => {
        const lowHoleVariants = holeKeyVariants(holeName);
        const point = Array.isArray(pts) ? pts.find(candidate => {
          const pointVariants = holeKeyVariants(candidate && (candidate.hole || candidate.name || candidate.id || candidate.nodeId));
          return pointVariants.some(value => lowHoleVariants.includes(value));
        }) : null;
        if(!point) return;

        const csvRec = getCsvRecordForPoint(point);
        const hole = String(point.hole != null ? point.hole : holeName);
        const holeKey = normHoleKey(hole);
        if(seenHoles.has(holeKey)) return;
        seenHoles.add(holeKey);
        weightRows.push({
          hole,
          weight: Number(csvRec && csvRec.explosiveWeight),
          airM: getEffectiveAirM(csvRec, point),
          diameter: Number(csvRec && csvRec.diameterMm),
          explosiveLength: Number(csvRec && csvRec.explosiveLength),
          fallbackDiameter: Number(point && point.diameter),
          fallbackExplosiveLength: Number(point && point.explosiveLength),
          sectionRulesName: getSectionRulesNameForPoint(point)
        });
      });

      const flaggedRows = weightRows.filter(row => {
        const diameter = Number.isFinite(row.diameter) ? row.diameter : row.fallbackDiameter;
        return getWeightMapHoleColor(row.weight, diameter, row.airM) !== '#38bdf8';
      });
      flaggedRows.sort((a,b)=>String(a.hole).localeCompare(String(b.hole), undefined, {numeric:true, sensitivity:'base'}));
      return flaggedRows;
    }

    function isNegativeTimingIssue(p){
      const timing = currentTimeConflict(p);
      return Number.isFinite(timing) && timing < 0;
    }

    function isFiringSequenceIsolatedIssue(pointIndex, times){
      if(!Array.isArray(window.pts) || !window.pts.length) return false;
      if(!Number.isInteger(pointIndex) || pointIndex < 0 || pointIndex >= window.pts.length) return false;

      const ptsList = window.pts;
      const timeValues = Array.isArray(times) && times.length === ptsList.length
        ? times
        : ptsList.map(p => currentTimeConflict(p));

      const p = ptsList[pointIndex];
      const ti = timeValues[pointIndex];
      if(!Number.isFinite(ti)) return false;

      const isolatedDiffThresholdMs = 300;
      const isolatedRangeMultiplier = 55;
      const diamMm = Number(p.diameter);
      if(!Number.isFinite(diamMm) || diamMm <= 0) return false;

      const limit = (diamMm / 1000) * isolatedRangeMultiplier;
      if(!Number.isFinite(limit) || limit <= 0) return false;

      let nearCount = 0;
      for(let j=0;j<ptsList.length;j++){
        if(pointIndex === j) continue;
        const tj = timeValues[j];
        if(!Number.isFinite(tj)) continue;
        if(distance(p, ptsList[j]) > limit) continue;

        nearCount++;
        if(Math.abs(ti - tj) <= isolatedDiffThresholdMs){
          return false;
        }
      }

      return nearCount > 0;
    }

    function getFiringSequenceSummaryStatus(){
      const ptsList = Array.isArray(window.pts) ? window.pts : [];
      if(!ptsList.length){
        return {
          state: 'passed',
          text: 'Passed'
        };
      }

      const times = ptsList.map(p => currentTimeConflict(p));
      const hasNegativeTiming = ptsList.some(p => isNegativeTimingIssue(p));
      const hasIsolatedIssue = ptsList.some((_, index) => isFiringSequenceIsolatedIssue(index, times));

      if(hasNegativeTiming && hasIsolatedIssue){
        return {
          state: 'warn',
          text: 'Requires review, Negative timing; 300 ms different from all timed holes within 55D'
        };
      }

      if(hasNegativeTiming){
        return {
          state: 'warn',
          text: 'Requires review, Negative timing'
        };
      }

      if(hasIsolatedIssue){
        return {
          state: 'warn',
          text: 'Requires review, 300 ms different from all timed holes within 55D'
        };
      }

      return {
        state: 'passed',
        text: 'Passed'
      };
    }

    function getWeightMapHoleColor(weightKg, diameterMm, airM){
      if(!Number.isFinite(weightKg) || weightKg <= 0) return '#94a3b8';
      if(isIgnoredWeightKg(weightKg)) return '#94a3b8';
      if(Number.isFinite(airM) && airM < 0.6) return '#22c55e';
      return isWeightReviewIssue(weightKg, diameterMm) ? '#ef4444' : '#38bdf8';
    }

    function getCsvRecordForPoint(p){
      if(p && p._csvRec) return p._csvRec;
      if(!window.csvDet) return null;
      const variants = holeKeyVariants((p && (p.hole || p.name || p.id || p.nodeId)) || '');
      for(const v of variants){
        if(window.csvDet.byHole && window.csvDet.byHole[v]) return window.csvDet.byHole[v];
        if(window.csvDet.byVariantList && window.csvDet.byVariantList[v] && window.csvDet.byVariantList[v].length){
          return window.csvDet.byVariantList[v][0];
        }
      }
      return null;
    }

    function getCsvRecordForHoleValue(value){
      if(!window.csvDet) return null;
      const variants = holeKeyVariants(value);
      for(const v of variants){
        if(window.csvDet.byHole && window.csvDet.byHole[v]) return window.csvDet.byHole[v];
        if(window.csvDet.byVariantList && window.csvDet.byVariantList[v] && window.csvDet.byVariantList[v].length){
          return window.csvDet.byVariantList[v][0];
        }
      }

      const records = Array.isArray(window.csvDet.csvHoles) ? window.csvDet.csvHoles : [];
      return records.find(record => {
        const recordValue = record && (record.hole || record.holeId || record['Hole #'] || record.Hole);
        const recordVariants = holeKeyVariants(recordValue);
        return recordVariants.some(key => variants.includes(key));
      }) || null;
    }

    function getSdobReviewStatus(rec){
      const weight = Number(rec && rec.explosiveWeight);
      const sdobVal = Number(rec && rec.sdob);
      const inclinationVal = Number(rec && rec.inclination);
      const subDrillVal = Number(rec && rec.subDrill);
      const inclinationMag = Number.isFinite(inclinationVal) ? Math.abs(inclinationVal) : NaN;

      if(!Number.isFinite(weight) || weight === 0) return {issue:false, color:'#94a3b8'};
      if(isIgnoredWeightKg(weight)) return {issue:false, color:'#94a3b8'};
      if(!Number.isFinite(sdobVal)) return {issue:false, color:'#94a3b8'};

      if(Number.isFinite(subDrillVal) && subDrillVal <= 0 && sdobVal > 1.4){
        return {issue:true, color:'#7f1d1d'};
      }

      // Match SDoB map behavior: inclined holes with |inclination| > 2 and sdob > 1.2 are shown as blue (not review).
      if(Number.isFinite(inclinationMag) && inclinationMag > 2 && sdobVal > 1.2) return {issue:false, color:'#38bdf8'};

      if(sdobVal < 0.82) return {issue:true, color:'#f97316'};
      if(sdobVal > 1.4) return {issue:true, color:'#ef4444'};

      return {issue:false, color:'#38bdf8'};
    }

    function isSdobReviewIssue(rec){
      return getSdobReviewStatus(rec).issue;
    }

    function isSdobSummaryIssue(rec){
      const sdobVal = Number(rec && rec.sdob);
      const subDrillVal = Number(rec && rec.subDrill);

      if(Number.isFinite(subDrillVal) && subDrillVal <= 0 && Number.isFinite(sdobVal) && sdobVal > 1.4){
        return false;
      }

      return isSdobReviewIssue(rec);
    }

    function isSdobDarkRedIssue(rec){
      const weight = Number(rec && rec.explosiveWeight);
      const sdobVal = Number(rec && rec.sdob);
      const subDrillVal = Number(rec && rec.subDrill);
      const inclinationVal = Number(rec && rec.inclination);
      const inclinationMag = Number.isFinite(inclinationVal) ? Math.abs(inclinationVal) : NaN;
      if(!Number.isFinite(weight) || isIgnoredWeightKg(weight)) return false;
      if(Number.isFinite(inclinationMag) && inclinationMag > 2 && Number.isFinite(sdobVal) && sdobVal > 1.2) return false;
      return Number.isFinite(subDrillVal) && subDrillVal <= 0 && Number.isFinite(sdobVal) && sdobVal > 1.4;
    }

    function getHoleCountThreshold(){
      const el = document.getElementById('holeCountThreshold');
      const v = el ? Math.round(parseNumber(el.value)) : NaN;
      return Number.isFinite(v) && v > 0 ? v : 8000;
    }

    function getMaxDetonationTimeMs(){
      if(!Array.isArray(window.pts) || !window.pts.length) return NaN;
      let maxTiming = NaN;
      for(const p of window.pts){
        const t = currentTimeConflict(p);
        if(!Number.isFinite(t)) continue;
        if(!Number.isFinite(maxTiming) || t > maxTiming) maxTiming = t;
      }
      return maxTiming;
    }

    function getPatternSensitivityStatus(){
      const text = String(window.blstTextOriginal || '');
      if(!text){
        return {
          state: 'warn',
          text: 'Requires review, no BLST loaded',
          detail: 'no BLST loaded'
        };
      }

      const readFlag = (name)=>{
        const re = new RegExp(`set\\s+${name}\\s+([01])`, 'i');
        const m = text.match(re);
        if(!m) return null;
        return Number(m[1]);
      };

      const flags = [
        readFlag('IsVibrationSensitive'),
        readFlag('IsOverpressureSensitive'),
        readFlag('IsFlyrockSensitive'),
        readFlag('IsDustSensitive')
      ].filter(v => v === 0 || v === 1);

      if(!flags.length){
        return {
          state: 'warn',
          text: 'Requires review, sensitivity flags not found',
          detail: 'sensitivity flags not found'
        };
      }

      if(flags.some(v => v === 1)){
        return {
          state: 'passed',
          text: 'Pattern marked sensitive',
          detail: 'pattern marked sensitive'
        };
      }

      return {
        state: 'bad',
        text: 'Pattern is marked NOT sensitive',
        detail: 'pattern is marked NOT sensitive'
      };
    }

    function getOverpressureSdobSummaryStatus(){
      const excludedRe = /\b(?:ntbc|hrdc)\b/i;
      let considered = 0;
      let hasUnderOne = false;

      if(!Array.isArray(window.pts) || !window.pts.length){
        return {
          state: 'warn',
          text: 'Requires review, no mapped holes',
          detail: 'no mapped holes'
        };
      }

      for(const p of window.pts){
        if(!p) continue;
        const rec = getCsvRecordForPoint(p);
        if(!rec) continue;

        const weight = Number(rec.explosiveWeight);
        if(!Number.isFinite(weight) || weight <= 0 || isIgnoredWeightKg(weight)) continue;

        const chargeName = String(getHoleChargeName(p) || '').trim();
        if(excludedRe.test(chargeName)) continue;

        const sdobVal = Number(rec.sdob);
        if(!Number.isFinite(sdobVal)) continue;

        considered++;
        if(sdobVal < 1.0){
          hasUnderOne = true;
          break;
        }
      }

      if(!considered){
        return {
          state: 'warn',
          text: 'Requires review, no eligible SDoB holes',
          detail: 'no eligible SDoB holes'
        };
      }

      if(hasUnderOne){
        return {
          state: 'confirm',
          text: 'review if Over pressure sensitive',
          detail: 'one or more eligible holes below SDoB 1.0'
        };
      }

      return {
        state: 'passed',
        text: 'passed - SDoB all over 1.0',
        detail: 'all eligible holes are SDoB >= 1.0'
      };
    }

    function getCollarPositionSummaryStatus(){
      if(!window.blstData){
        return {
          state: 'confirm',
          text: 'BLST only check (load .blst)',
          detail: 'BLST not loaded'
        };
      }

      const stats = window.blstData.collarPositionStats;
      if(!stats || !stats.hasData || !Number.isFinite(stats.total) || stats.total <= 0){
        return {
          state: 'warn',
          text: 'Requires review, no collar position data',
          detail: 'no collar position data'
        };
      }

      const pct = Number(stats.matchingPct);
      const pctText = formatPercentCompact(pct);
      const countText = `${stats.matchingCount}/${stats.total}`;
      const sourceText = stats.source ? `, source: ${stats.source}` : '';
      const duplicateInstances = Array.isArray(stats.duplicateInstances) ? stats.duplicateInstances : [];
      const flaggedInstances = duplicateInstances.filter(instance => Number(instance && instance.pct) >= 10);

      const topFlagText = flaggedInstances
        .slice(0, 3)
        .map(instance => `${formatPositionValueCompact(instance.value)} (${formatPercentCompact(Number(instance.pct))}, ${instance.count}/${stats.total})`)
        .join('; ');

      if(flaggedInstances.length){
        return {
          state: 'warn',
          text: `Requires review: collar position instance(s) >=10% (${topFlagText}${sourceText})`,
          detail: `${flaggedInstances.length} collar position instance(s) are >=10%`
        };
      }

      return {
        state: 'passed',
        text: `passed (no single collar position instance >=10%; total matches ${pctText}, ${countText}${sourceText})`,
        detail: `no single collar position instance >=10%`
      };
    }

    function normalizeBranchValue(value){
      if(value == null) return '';
      return String(value).trim();
    }

    function normalizeChargeRuleValue(value){
      if(value == null) return '';
      return String(value).trim();
    }

    function formatBranchCountList(entries, maxItems = 6){
      if(!Array.isArray(entries) || !entries.length) return '';
      const clipped = entries.slice(0, maxItems).map(([branch, count]) => `${branch} (${count})`);
      const remaining = entries.length - clipped.length;
      if(remaining > 0) clipped.push(`+${remaining} more`);
      return clipped.join(', ');
    }

    function parseDetonationTimeValueCount(value){
      if(value == null) return 0;
      if(typeof value === 'number') return Number.isFinite(value) ? 1 : 0;
      const text = String(value).trim();
      if(!text) return 0;
      const parsed = Number(text.replace(/,/g, ''));
      return Number.isFinite(parsed) ? 1 : 0;
    }

    function upsertBranchMetric(map, branch, branchDelta, detonationDelta){
      if(!branch) return;
      if(!map.has(branch)){
        map.set(branch, {branchCount: 0, detonationCount: 0});
      }
      const metric = map.get(branch);
      metric.branchCount += Number.isFinite(branchDelta) ? branchDelta : 0;
      metric.detonationCount += Number.isFinite(detonationDelta) ? detonationDelta : 0;
    }

    function getBranchSummaryMetrics(){
      const metrics = new Map();
      const sourceData = getBranchReviewSourceData();

      if(sourceData.source === 'csv') sourceData.csvRecords.forEach(rec=>{
        const branch = normalizeBranchValue(rec && rec.branch);
        if(!branch) return;
        const timeCountRaw = Number(rec && rec.timeMsCount);
        const timeCount = Number.isFinite(timeCountRaw) && timeCountRaw > 0 ? Math.round(timeCountRaw) : 0;
        upsertBranchMetric(metrics, branch, 1, timeCount);
      });

      const branchKeys = ['Branch', 'branch', 'BRANCH'];
      if(sourceData.source === 'rows') sourceData.rows.forEach(row=>{
        if(!row || typeof row !== 'object') return;
        let branch = '';
        for(const key of branchKeys){
          if(Object.prototype.hasOwnProperty.call(row, key)){
            branch = normalizeBranchValue(row[key]);
            if(branch) break;
          }
        }
        if(!branch) return;

        // Strict rule: only count columns whose header is exactly Detonation Time (ms).
        let detonationCount = 0;
        if(Object.prototype.hasOwnProperty.call(row, 'Detonation Time (ms)')){
          detonationCount += parseDetonationTimeValueCount(row['Detonation Time (ms)']);
        }
        upsertBranchMetric(metrics, branch, 1, detonationCount);
      });

      if(sourceData.source === 'blst') sourceData.blstHoles.forEach(hole=>{
        const branch = normalizeBranchValue(hole && hole.branch);
        if(!branch) return;
        const detonation = Number(hole && hole.detonation_ms);
        upsertBranchMetric(metrics, branch, 1, Number.isFinite(detonation) ? 1 : 0);
      });

      return {source: sourceData.source, metrics};
    }

    function buildBranchCountSummary(){
      const result = getBranchSummaryMetrics();
      const entries = [];

      result.metrics.forEach((metric, branch)=>{
        const branchCount = Number.isFinite(metric.branchCount) ? metric.branchCount : 0;
        const detonationCount = Number.isFinite(metric.detonationCount) ? metric.detonationCount : 0;
        const usedCount = Math.max(branchCount, detonationCount);
        entries.push([branch, usedCount]);
      });

      entries.sort((a,b)=>(b[1]-a[1]) || a[0].localeCompare(b[0]));

      return {
        source: result.source,
        entries
      };
    }

    function setMapCallMultiplierDefaultFromBranches(){
      const multiplier = document.getElementById('mapCallMultiplier');
      if(!multiplier) return;
      multiplier.value = buildBranchCountSummary().entries.length ? '11' : '13';
    }

    function getBranchReviewSourceData(){
      const csvRecords = window.csvDet && Array.isArray(window.csvDet.csvHoles) && window.csvDet.csvHoles.length
        ? window.csvDet.csvHoles
        : (window.csvDet && Array.isArray(window.csvDet.csvHolesMerged) ? window.csvDet.csvHolesMerged : []);
      if(csvRecords.length){
        return { source: 'csv', csvRecords, rows: [], blstHoles: [] };
      }

      const rows = Array.isArray(window.rows) ? window.rows : [];
      if(rows.length){
        return { source: 'rows', csvRecords: [], rows, blstHoles: [] };
      }

      const blstHoles = (window.blstData && Array.isArray(window.blstData.holes)) ? window.blstData.holes : [];
      return { source: 'blst', csvRecords: [], rows: [], blstHoles };
    }

    function hasHrdcHoleWithBranch(){
      const isHrdc = value => /\bhrdc\b/i.test(String(value || ''));
      const hasBranch = value => normalizeBranchValue(value).length > 0;
      const { csvRecords, rows, blstHoles } = getBranchReviewSourceData();

      if(csvRecords.length){
        return csvRecords.some(hole => isHrdc(hole && (hole.chargeName || hole.chargeRule || hole.chargeRuleName)) && hasBranch(hole && hole.branch));
      }

      if(rows.length){
        return rows.some(row => row && isHrdc(row.ChargeRule || row['Charge Rule'] || row.ChargeRuleName || row['Charge Name']) && hasBranch(row.Branch || row.branch || row.BRANCH));
      }

      return blstHoles.some(hole => isHrdc(hole && hole.chargeRuleName) && hasBranch(hole && hole.branch));
    }

    function hasNonHrdcHoleWithoutBranch(){
      const isHrdc = value => /\bhrdc\b/i.test(String(value || ''));
      const hasBranch = value => normalizeBranchValue(value).length > 0;
      const { csvRecords, rows, blstHoles } = getBranchReviewSourceData();

      if(csvRecords.length){
        return csvRecords.some(hole => !isHrdc(hole && (hole.chargeName || hole.chargeRule || hole.chargeRuleName)) && !hasBranch(hole && hole.branch));
      }

      if(rows.length){
        return rows.some(row => row && !isHrdc(row.ChargeRule || row['Charge Rule'] || row.ChargeRuleName || row['Charge Name']) && !hasBranch(row.Branch || row.branch || row.BRANCH));
      }

      return blstHoles.some(hole => !isHrdc(hole && hole.chargeRuleName) && !hasBranch(hole && hole.branch));
    }

    function hasNtbcHoleWithoutCharge(){
      const isNtbc = value => /\bntbc\b/i.test(String(value || ''));
      const hasCharge = value => String(value == null ? '' : value).trim().length > 0;
      const { csvRecords, rows } = getBranchReviewSourceData();

      if(csvRecords.length){
        return csvRecords.some(hole => {
          const chargeName = hole && hole.chargeName;
          const explosiveWeight = Number(hole && hole.explosiveWeight);
          return isNtbc(chargeName) && (!Number.isFinite(explosiveWeight) || explosiveWeight <= 0);
        });
      }

      if(rows.length){
        return rows.some(row => {
          const chargeRule = row && (row.ChargeRule || row['Charge Rule'] || row.ChargeRuleName || row['Charge Name'] || row.chargeRuleName || row.chargeName || row.chargeRule);
          const chargeName = row && (row.chargeName || row.chargeRuleName || row['Charge Name']);
          const explosiveWeight = Number(row && (row.explosiveWeight || row['Explosive Weight'] || row['Charge kg'] || row['Charge Weight (kg)']));
          return isNtbc(chargeRule || chargeName) && (!Number.isFinite(explosiveWeight) || explosiveWeight <= 0);
        });
      }

      const points = Array.isArray(window.pts) ? window.pts : [];
      if(points.some(hole => {
        if(!hole || hole.hasPrimer !== false) return false;
        const chargeRule = hole.chargeRule || '';
        const csvRecord = hole._csvRec || {};
        const chargeName = csvRecord.chargeName || '';
        const explosiveWeight = Number(csvRecord.explosiveWeight);
        return !hasCharge(chargeRule) || isNtbc(chargeRule) && (!Number.isFinite(explosiveWeight) || explosiveWeight <= 0) || isNtbc(chargeName) && (!Number.isFinite(explosiveWeight) || explosiveWeight <= 0);
      })) return true;

      const blstHoles = (window.blstData && Array.isArray(window.blstData.holes)) ? window.blstData.holes : [];
      return blstHoles.some(hole => {
        const chargeRule = hole && (hole.chargeRuleName || hole.chargeRule || hole.chargeName);
        const explosiveWeight = Number(hole && hole.explosiveWeight);
        return isNtbc(chargeRule) && (!Number.isFinite(explosiveWeight) || explosiveWeight <= 0);
      });
    }

    function getBranchSummaryStatus(){
      const summary = buildBranchCountSummary();
      const entries = summary.entries;

      if(!entries.length){
        return {
          state: 'passed',
          text: 'Requires review, no Branch values found',
          detail: 'no Branch values found',
          reason: 'holes missing from branches, excluding HRDC'
        };
      }

      if(hasHrdcHoleWithBranch()){
        return {
          state: 'warn',
          text: 'Requires review',
          detail: 'HRDC holes have a branch',
          reason: 'HRDC holes have a branch'
        };
      }

      if(hasNtbcHoleWithoutCharge()){
        return {
          state: 'warn',
          text: 'Requires review',
          detail: 'NTBC holes have no charge',
          reason: 'NTBC holes have no charge'
        };
      }

      if(hasNonHrdcHoleWithoutBranch()){
        return {
          state: 'warn',
          text: 'Requires review',
          detail: 'holes missing from branches, excluding HRDC',
          reason: 'holes missing from branches, excluding HRDC'
        };
      }

      const reviewBranches = entries.filter(([,count]) => count > 400);
      if(reviewBranches.length){
        const detail = `over 400: ${formatBranchCountList(reviewBranches)}`;
        return {
          state: 'warn',
          text: `Requires review (${detail})`,
          detail,
          reason: 'If; branch count is over 400'
        };
      }

      const confirmBranches = entries.filter(([,count]) => count > 380 && count < 401);
      if(confirmBranches.length){
        const detail = `over 380 and under 401: ${formatBranchCountList(confirmBranches)}`;
        return {
          state: 'confirm',
          text: `Confirm ok (${detail})`,
          detail,
          reason: 'If; branches over 380 and under 401 require confirmation'
        };
      }

      const maxEntry = entries[0];
      const detail = maxEntry ? `max ${maxEntry[0]} (${maxEntry[1]})` : '';
      return {
        state: 'passed',
        text: detail ? `Passed (all branches under 380; ${detail})` : 'Passed (all branches under 380)',
        detail: detail || 'all branches under 380',
        reason: 'NO holes missing from branches, excluding HRDC'
      };
    }

    function getBranchComplianceReviewRows(){
      const candidateRows = [];
      const addRow = (hole, chargeRule, branch, chargeKg) => {
        if(!hole && !chargeRule && !branch && !Number.isFinite(chargeKg)) return;
        const holeText = String(hole != null ? hole : '').trim();
        const chargeRuleText = normalizeChargeRuleValue(chargeRule);
        const branchText = normalizeBranchValue(branch);
        const chargeKgValue = Number(chargeKg);
        const row = {
          hole: holeText,
          chargeRule: chargeRuleText,
          branch: branchText,
          chargeKg: Number.isFinite(chargeKgValue) ? chargeKgValue : NaN
        };
        if(row.hole || row.chargeRule || row.branch || Number.isFinite(row.chargeKg)){
          candidateRows.push(row);
        }
      };

      const sourceData = getBranchReviewSourceData();
      if(sourceData.source === 'csv'){
        sourceData.csvRecords.forEach(rec => {
          const hole = String((rec && (rec.hole || rec.Hole || rec['Hole #'] || rec.holeId || rec.name)) || '');
          const chargeRule = String((rec && (rec.chargeName || rec.chargeRule || rec.chargeRuleName || rec['Charge Name'] || rec['Charge Rule'])) || '');
          const branch = String((rec && (rec.branch || rec.BRANCH || rec['Branch'])) || '');
          const chargeKg = Number(rec && (rec.explosiveWeight || rec['Charge kg'] || rec['Charge Weight (kg)']));
          addRow(hole, chargeRule, branch, chargeKg);
        });
      } else if(sourceData.source === 'rows'){
        sourceData.rows.forEach(row => {
          if(!row || typeof row !== 'object') return;
          const hole = String((row && (row.hole || row.Hole || row['Hole #'] || row.holeId || row.name)) || '');
          const chargeRule = String((row && (row.ChargeRule || row['Charge Rule'] || row.ChargeRuleName || row['Charge Name'] || row.chargeRuleName || row.chargeName || row.chargeRule)) || '');
          const branch = String((row && (row.Branch || row.branch || row.BRANCH || row['Branch'])) || '');
          const chargeKg = Number(row && (row['Charge kg'] ?? row['Charge Weight (kg)'] ?? row.explosiveWeight ?? row.explosiveWeightKg));
          addRow(hole, chargeRule, branch, chargeKg);
        });
      } else {
        sourceData.blstHoles.forEach(hole => {
        const holeName = String((hole && (hole.name || hole.id || hole.nodeId || hole.hole)) || '');
        const chargeRule = String((hole && (hole.chargeRuleName || hole.chargeRule || hole.chargeName)) || '');
        const branch = String((hole && (hole.branch || hole.BRANCH)) || '');
        const chargeKg = Number(hole && (hole.explosiveWeight ?? hole.chargeKg ?? hole['Charge kg']));
        addRow(holeName, chargeRule, branch, chargeKg);
        });
      }

      const reviewBranchNames = new Set(
        buildBranchCountSummary().entries
          .filter(([, count]) => count > 400)
          .map(([branch]) => String(branch || '').trim())
          .filter(Boolean)
      );

      const rows = candidateRows.filter(rec => {
        const chargeRule = String(rec.chargeRule || '');
        const branch = String(rec.branch || '');
        const chargeKg = Number(rec.chargeKg);
        const hasBranch = !!branch;
        const isHrdc = /\bhrdc\b/i.test(chargeRule);
        const isNtbc = /\bntbc\b/i.test(chargeRule);
        const isHrdcOrNtbc = isHrdc || isNtbc;

        if(!isHrdcOrNtbc) return false;
        if(isHrdc && hasBranch) return true;
        if(isNtbc && (!chargeRule || !hasBranch || !Number.isFinite(chargeKg) || chargeKg <= 0)) return true;
        if(reviewBranchNames.has(branch) && hasBranch) return true;
        return false;
      });

      const seen = new Set();
      const deduped = rows.filter(rec => {
        const key = `${String(rec.hole || '').trim()}|${String(rec.chargeRule || '').trim()}|${String(rec.branch || '').trim()}|${Number.isFinite(rec.chargeKg) ? rec.chargeKg : ''}`;
        if(!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });

      deduped.sort((a,b) => {
        const holeA = String(a.hole || '').localeCompare(String(b.hole || ''), undefined, { numeric: true, sensitivity: 'base' });
        if(holeA !== 0) return holeA;
        return String(a.branch || '').localeCompare(String(b.branch || ''), undefined, { numeric: true, sensitivity: 'base' });
      });

      return deduped;
    }

    function renderBranchComplianceReviewTable(){
      const body = document.getElementById('branchComplianceListBody');
      if(!body) return;

      const rows = getBranchComplianceReviewRows();
      if(!rows.length){
        body.innerHTML = '<tr><td colspan="4" class="muted">No holes are currently causing the branch compliance review status.</td></tr>';
        return;
      }

      body.innerHTML = rows.map(row => `
        <tr>
          <td>${escapeHTML(String(row.hole || ''))}</td>
          <td>${escapeHTML(String(row.chargeRule || ''))}</td>
          <td>${escapeHTML(String(row.branch || ''))}</td>
          <td>${Number.isFinite(row.chargeKg) ? escapeHTML(Number(row.chargeKg).toFixed(3)) : ''}</td>
        </tr>
      `).join('');
    }

    function getTimingPositionSummaryStatus(){
      const sourceText = String(window.blstTextOriginal || '');
      if(!sourceText){
        return {
          state: 'confirm',
          text: 'Requires review, no set locations'
        };
      }

      const scenarios = parseTimingScenarioLocations(sourceText);
      const locationLabels = new Map([
        ['0 (Collar)', 'Collar'],
        ['1 (Centre)', 'Centre'],
        ['2 (Toe)', 'Toe']
      ]);
      const locations = [];
      scenarios.forEach(scenario => {
        const location = locationLabels.get(scenario.location);
        if(location && !locations.includes(location)) locations.push(location);
      });

      if(!locations.length){
