      missingInCsv: 0,
      ambiguous: 0,
      unresolvedAssignments: 0,
      csvUnmatchedInBlst: 0,
      examples: {missingInCsv: [], ambiguous: [], unresolved: [], csvUnmatchedInBlst: []},
      csvDuplicates: (window.csvDet && window.csvDet.duplicates) ? window.csvDet.duplicates : null
    };

    const blstHoles = (window.blstData && Array.isArray(window.blstData.holes)) ? window.blstData.holes : [];
    out.blstHoleCount = blstHoles.length;

    // Duplicate-name counts (raw name, not canonical)
    const nameCounts = new Map();
    blstHoles.forEach(h=>{
      const nm = String(h.name||'').trim();
      if(!nm) return;
      nameCounts.set(nm, (nameCounts.get(nm)||0)+1);
    });
    out.blstUniqueNameCount = nameCounts.size;
    out.blstDuplicateNames = Array.from(nameCounts.entries())
      .filter(([_,cnt])=>cnt>1)
      .map(([nm,cnt])=>({name:nm,count:cnt}))
      .sort((a,b)=>b.count-a.count || a.name.localeCompare(b.name));

    const csvRecs = (window.csvDet && Array.isArray(window.csvDet.csvHoles)) ? window.csvDet.csvHoles : [];
    out.csvRowCount = csvRecs.length;

    const csvNameCounts = new Map();
    csvRecs.forEach(r=>{
      const nm = String(r.hole||'').trim();
      if(!nm) return;
      csvNameCounts.set(nm, (csvNameCounts.get(nm)||0)+1);
    });
    out.csvUniqueNameCount = csvNameCounts.size;

    // Use nodeId assignment diag when available
    if(window.csvAssignmentDiag){
      out.unresolvedAssignments = window.csvAssignmentDiag.unresolved || 0;
      // Count "missing in CSV" at the hole-instance level
      out.missingInCsv = window.csvAssignmentDiag.unresolved || 0;
      out.ambiguous = window.csvAssignmentDiag.ambiguousGroups || 0;
      out.matched = (window.csvAssignmentDiag.assigned || 0);
      if(window.csvAssignmentDiag.examples && window.csvAssignmentDiag.examples.unresolved){
        out.examples.unresolved = window.csvAssignmentDiag.examples.unresolved.slice(0,50);
      }
      if(window.csvAssignmentDiag.examples && window.csvAssignmentDiag.examples.ambiguous){
