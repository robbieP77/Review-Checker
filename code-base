            ? '#f97316'
            : (row.status === 'confirm' ? '#3b82f6' : (row.status === 'bad' ? '#ef4444' : '#16a34a'));
          const wrapped = getWrappedLines(ctx, row.headingText, sectionTextMaxW);
          const rowHeight = wrapped.length * sectionTextLineH;
          const bulletY = sectionY + Math.max(6, Math.floor(rowHeight / 2));

          ctx.fillStyle = statusColor;
          ctx.beginPath();
          ctx.arc(sectionX + 14, bulletY, 3, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = statusColor;
          for(let i=0;i<wrapped.length;i++){
            ctx.fillText(wrapped[i], sectionX + 24, sectionY + (i * sectionTextLineH));
