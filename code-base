</style>
<script>
    // ---------- Generic helpers ----------

    function parseCSV(text){
      const rows=[];
      let i=0,field='',row=[],inQuotes=false;
      while(i<text.length){
        const c=text[i];
        if(inQuotes){
          if(c==='"'&&text[i+1]==='"'){field+='"';i+=2;continue;}
          if(c==='"'){inQuotes=false;i++;continue;}
          field+=c;i++;continue;
        }
        if(c==='"'){inQuotes=true;i++;continue;}
        if(c===','){row.push(field);field='';i++;continue;}
        if(c==='\n'){row.push(field);rows.push(row);field='';row=[];i++;continue;}
        if(c==='\r'){i++;continue;}
        field+=c;i++;
      }
      row.push(field);rows.push(row);
      while(rows.length && rows[rows.length-1].every(v=>String(v||'').trim()===''))
        rows.pop();
      return rows;
    }


    // ---------- CSV hole key normalization (for robust CSV↔BLST matching) ----------
    function stripQuotes(s){
      s = String(s != null ? s : '');
      s = s.trim();
      if((s.startsWith('"') && s.endsWith('"')) || (s.startsWith("'") && s.endsWith("'"))){
        s = s.slice(1,-1).trim();
      }
      return s;
    }
    function normHoleKey(s){
      s = stripQuotes(s);
      s = s.replace(/\s+/g,' ').trim();
      // Numeric-like keys: drop leading zeros and trailing ".0"
      const numLike = s.match(/^0*([0-9]+)(?:\.0+)?$/);
      if(numLike){
        const v = numLike[1].replace(/^0+/,'');
        return (v===''?'0':v);
      }
      return s;
    }

    function normalizePositionMatchValue(value){
      const n = Number(value);
      if(!Number.isFinite(n)) return null;
      // Normalize tiny floating-point noise while keeping real differences (e.g. 519.64 vs 519.65).
      return n.toFixed(6);
    }

    function buildMatchingPositionStats(values){
      const raw = Array.isArray(values) ? values : [];
      const normalized = raw
        .map(v => normalizePositionMatchValue(v))
        .filter(v => v != null);

      const total = normalized.length;
      if(!total){
        return {hasData:false, total:0, matchingCount:0, matchingPct:0, duplicatedValueCount:0, duplicateInstances:[]};
      }

      const counts = new Map();
      normalized.forEach(v => counts.set(v, (counts.get(v) || 0) + 1));

      let matchingCount = 0;
      let duplicatedValueCount = 0;
      const duplicateInstances = [];
      counts.forEach((c, value)=>{
        if(c > 1){
          matchingCount += c;
          duplicatedValueCount++;
          duplicateInstances.push({
            value,
            count: c,
            pct: (c / total) * 100
          });
        }
      });

      const matchingPct = (matchingCount / total) * 100;
      duplicateInstances.sort((a,b)=> b.pct - a.pct || b.count - a.count || String(a.value).localeCompare(String(b.value)));
      return {hasData:true, total, matchingCount, matchingPct, duplicatedValueCount, duplicateInstances};
    }

    function formatPercentCompact(value){
      if(!Number.isFinite(value)) return '0%';
      return `${value.toFixed(2).replace(/\.00$/,'').replace(/(\.\d*[1-9])0+$/,'$1')}%`;
    }

    function formatPositionValueCompact(value){
      if(value == null) return '';
      return String(value).replace(/\.0+$/,'').replace(/(\.\d*[1-9])0+$/,'$1');
    }

    function getThemeCssVar(name, fallback=''){
      const value = getComputedStyle(document.body).getPropertyValue(name).trim();
      return value || fallback;
    }
    function holeKeyVariants(s){
      const raw = String(s != null ? s : '').trim();
      const stripped = stripQuotes(raw);
      const base = normHoleKey(stripped);
      const variants = new Set();
      const add = (v)=>{
        v = String(v != null ? v : '').trim();
        if(!v) return;
        variants.add(v);
        variants.add(v.toLowerCase());
      };
      add(raw);
      add(stripped);
      add(base);

      const compact = stripped.replace(/[^a-z0-9]+/gi,'');
      add(compact);

      // trailing numeric token (e.g. "H01-003" -> "003" -> "3")
      const m = stripped.match(/([0-9]+)\s*$/);
      if(m){
        const tail = m[1];
        add(tail);
        add(tail.replace(/^0+/,'') || '0');
      }

      // Drop a single trailing letter suffix (e.g. "H01A" -> "H01")
      const suffixMatch = stripped.match(/^(.*?)([A-Za-z])$/);
      if(suffixMatch){
        add(suffixMatch[1]);
        add(suffixMatch[1].replace(/[^a-z0-9]+/gi,''));
      }

      return Array.from(variants);
    }

    // === BLST export helpers (ported from Review Checker 2.3) ===
    // Export adjusts per-hole DeckDelayTimes for the ActiveTiming scenarios using the adjusted
    // detonation times (from CSV + user edits). If ActiveTiming/HoleScenarios are not present,
    // BLST export is not possible.
    function indexSelectBlocks(text){
      const re = /^select\s+(\d+)\s*$/gm;
      const matches = [];
      let m;
      while((m = re.exec(text)) !== null){
        matches.push({ id: m[1], start: m.index });
      }
      const idx = new Map();
      for(let i=0;i<matches.length;i++){
        const start = matches[i].start;
        const end = (i+1 < matches.length) ? matches[i+1].start : text.length;
        idx.set(matches[i].id, { start, end });
      }
      return idx;
    }

    function getSelectBlockById(text, idx, id){
      const rec = idx && idx.get(String(id));
      if(!rec) return null;
      return text.slice(rec.start, rec.end);
    }

    function parseActiveTimingId(text){
      const m = /set\s+ActiveTiming\s+(\d+)/.exec(text);
      return m ? Number(m[1]) : null;
    }

    function parseTimingScenarioLocations(text){
      const selectIndex = indexSelectBlocks(text);
      const timingNodes = [];
      const seen = new Set();
      const nodeRe = /^node\s+(CompositeTimingScenario|RadialTimingScenario|TieInTimingScenario|DirectionalTimingScenario|FrontTimingScenario)\s+(\d+)\s*$/gm;
      let match;

      while((match = nodeRe.exec(text)) !== null){
        const type = match[1];
        const id = match[2];
        if(seen.has(id)) continue;
        seen.add(id);

        const block = getSelectBlockById(text, selectIndex, id);
        if(!block) continue;

        const nameMatch = /set\s+Name\s+([^\r\n]+)/.exec(block);
        const locationMatch = /set\s+Location\s+([^\r\n]+)/.exec(block);
        const rawLocation = locationMatch ? locationMatch[1].trim() : '';
        const locationLabels = { '0': 'Collar', '1': 'Centre', '2': 'Toe' };
        const location = rawLocation && locationLabels[rawLocation]
          ? `${rawLocation} (${locationLabels[rawLocation]})`
          : (rawLocation || 'N/A');

        const scenarioType = type === 'RadialTimingScenario'
          ? 'Radial timing'
          : (type === 'TieInTimingScenario'
            ? 'Fixed timing'
            : (type === 'DirectionalTimingScenario'
              ? 'Echelon timing'
              : (type === 'FrontTimingScenario' ? 'Contour timing' : 'Composite timing')));

        timingNodes.push({
          type: scenarioType,
          name: nameMatch ? nameMatch[1].trim() : `Scenario ${id}`,
          id,
          location
        });
      }

      return timingNodes;
    }

    function renderTimingScenarioLocations(text){
      const card = document.getElementById('scenarioLocationReference');
      const body = document.querySelector('#scenarioLocationReference tbody');
      if(!card || !body) return;

      const sourceText = String(text || '');
      const scenarios = parseTimingScenarioLocations(sourceText);
      card.style.display = sourceText && scenarios.length ? 'block' : 'none';
      if(!scenarios.length){
        body.innerHTML = '<tr><td colspan="4" class="muted">Load a BLST file to view timing scenarios.</td></tr>';
        return;
      }

      body.innerHTML = scenarios.map(scenario => `
        <tr>
          <td>${escapeHTML(scenario.type)}</td>
          <td>${escapeHTML(scenario.name)}</td>
          <td>${escapeHTML(scenario.id)}</td>
          <td>${escapeHTML(scenario.location)}</td>
        </tr>
      `).join('');
    }

    function parseHoleScenariosFromActive(text, idx, activeTimingId){
      const block = getSelectBlockById(text, idx, activeTimingId);
      if(!block) return null;
      const m = /set\s+HoleScenarios\s*\{([\s\S]*?)\n\s*\}/.exec(block);
      if(!m) return new Map();
      const lines = m[1].split(/\r?\n/).map(s=>s.trim()).filter(s=>s.length);
      const map = new Map();
      for(let i=0;i+1<lines.length;i+=2){
        const h = Number(lines[i]);
        const s = Number(lines[i+1]);
        if(Number.isFinite(h) && Number.isFinite(s)) map.set(h, s);
      }
      return map;
    }

    function parseNameFromSelect(block){
      const m = /set\s+Name\s+([^\n\r]+)/.exec(block);
      return m ? m[1].trim() : "";
    }

    function buildHoleIdsByName(text, idx, holeScenarioMap){
      const map = new Map(); // name -> [holeId...]
      for(const holeId of holeScenarioMap.keys()){
        const block = getSelectBlockById(text, idx, holeId);
        if(!block) continue;
        const name = parseNameFromSelect(block);
        if(!name) continue;
        if(!map.has(name)) map.set(name, []);
        map.get(name).push(holeId);
      }
      return map;
    }

    // Backwards-compatible helper: only returns a unique mapping when a name appears exactly once.
    function buildHoleIdByName(text, idx, holeScenarioMap){
      const idsByName = buildHoleIdsByName(text, idx, holeScenarioMap);
      const map = new Map();
      for(const [name, ids] of idsByName.entries()){
        if(ids && ids.length === 1) map.set(name, ids[0]);
      }
      return map;
    }

    function parseDeckDelayFromScenarioBlock(block){
      const m = /set\s+DeckDelayTimes\s*\{([\s\S]*?)\n\s*\}/.exec(block);
      if(!m) return { hasBlock:false, order:[], map:new Map() };
      const raw = m[1].split(/\r?\n/);
      const order = [];
      const map = new Map();
      let i=0;
      const clean = raw.map(l=>l.trim()).filter(l=>l.length);
      while(i+1 < clean.length){
        const holeLine = clean[i];
        const timeLine = clean[i+1];
        if(/^\d+$/.test(holeLine)){
          const holeId = Number(holeLine);
          const tm = /^0\s*,\s*([+-]?\d+(?:\.\d+)?)$/.exec(timeLine);
          if(tm){
            const val = Number(tm[1]);
            if(!map.has(holeId)) order.push(holeId);
            map.set(holeId, val);
            i += 2;
            continue;
          }
        }
        i += 1;
      }
      return { hasBlock:true, order, map };
    }

    function parseScenarioDeckData(text, idx, holeScenarioMap){
      const scenarioIds = Array.from(new Set(Array.from(holeScenarioMap.values())));
      const out = new Map();
      for(const sid of scenarioIds){
        const block = getSelectBlockById(text, idx, sid);
        if(!block){ out.set(sid, { hasBlock:false, order:[], map:new Map() }); continue; }
        out.set(sid, parseDeckDelayFromScenarioBlock(block));
      }
      return out;
    }

    function formatDelayValue(val){
      if(!Number.isFinite(val)) return "0";
      const rounded = Math.round(val);
      if(Math.abs(val - rounded) < 1e-9) return String(rounded);
      let s = (Math.round(val * 1e7) / 1e7).toFixed(7);
      s = s.replace(/0+$/,'').replace(/\.$/,'');
      if(s === "-0") s = "0";
      return s;
    }

    function buildDeckDelayBlockLines(deck){
      const lines = [" set DeckDelayTimes {"];
      for(const holeId of deck.order){
        if(!deck.map.has(holeId)) continue;
        lines.push(`  ${holeId}`);
        lines.push(`  0,${formatDelayValue(deck.map.get(holeId))}`);
      }
      lines.push("  }");
      return lines;
    }

    function upsertDeckDelayInScenarioBlock(block, deck){
      const newLines = buildDeckDelayBlockLines(deck).join("\n");
      if(/set\s+DeckDelayTimes\s*\{/.test(block)){
        return block.replace(/^\s*set\s+DeckDelayTimes\s*\{[\s\S]*?\n\s*\}\s*$/m, newLines);
      }
      const lines = block.split(/\r?\n/);
      const idxName = lines.findIndex(l => l.trim().startsWith("set Name"));
      if(idxName >= 0){
        lines.splice(idxName+1, 0, ...newLines.split("\n"));
        return lines.join("\n");
      }
      return block + "\n" + newLines + "\n";
    }

    function preserveSensitivityFlagsInExportedText(originalText, updatedText){
      const flagNames = ['IsSensitive', 'IsVibrationSensitive', 'IsOverpressureSensitive', 'IsFlyrockSensitive', 'IsDustSensitive'];
      const preservedLines = [];
      for(const flagName of flagNames){
        const re = new RegExp(`^\\s*set\\s+${flagName}\\s+(0|1)\\s*$`, 'im');
        const m = re.exec(originalText);
        if(m){
          preservedLines.push(`set ${flagName} ${m[1]}`);
        }
      }
      if(!preservedLines.length) return updatedText;

      const missingLines = preservedLines.filter(line => !updatedText.includes(line));
      if(!missingLines.length) return updatedText;

      const lines = updatedText.split(/\r?\n/);
      const idxName = lines.findIndex(l => /^\s*set\s+Name\b/i.test(l));
      if(idxName >= 0){
        lines.splice(idxName, 0, ...missingLines);
      } else {
        lines.push(...missingLines);
      }
      return lines.join("\n");
    }

    function prepareBlstExportInfo(blstText){
      const idx = indexSelectBlocks(blstText);
      const activeTimingId = parseActiveTimingId(blstText);
      if(activeTimingId == null) return { ok:false, reason:'ActiveTiming not found', idx };
      const holeScenario = parseHoleScenariosFromActive(blstText, idx, activeTimingId);
      if(!holeScenario || !holeScenario.size) return { ok:false, reason:'HoleScenarios not found in ActiveTiming', idx, activeTimingId };
      const holeIdsByName = buildHoleIdsByName(blstText, idx, holeScenario);
      const holeIdByName = buildHoleIdByName(blstText, idx, holeScenario); // unique-only
      const scenarioDeck = parseScenarioDeckData(blstText, idx, holeScenario);
      return { ok:true, idx, activeTimingId, holeScenario, holeIdByName, holeIdsByName, scenarioDeck };
    }


    function escapeHTML(s){
      return String(s).replace(/[&<>"']/g,c=>(
        {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]
      ));
    }

    function escapeRegExp(s){
      return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function getHighlightTokens(text){
      return (String(text || '').match(/[A-Za-z0-9]+(?:\.[A-Za-z0-9]+)?(?:m)?/g) || [])
        .map(t => t.trim())
        .filter(t => t.length > 1);
    }

    function getLengthTokenInfo(text){
      const match = String(text || '').match(/\b(\d+(?:\.\d+)?)\s*m\b/i);
      if(!match) return null;
      return { raw: match[0].replace(/\s+/g, ''), value: parseFloat(match[1]) };
    }

    function getWeightTokenInfo(text){
      const match = String(text || '').match(/\b(\d+(?:\.\d+)?)\s*kg\b/i);
      if(!match) return null;
      return { raw: match[0].replace(/\s+/g, ''), value: parseFloat(match[1]) };
    }

    function highlightExactPhrases(text, phraseClassMap){
      const source = String(text == null ? '' : text);
      const entries = Object.entries(phraseClassMap || {}).filter(([phrase, cls]) => phrase && cls);
      if(!entries.length) return escapeHTML(source);

      const unique = new Map();
      entries.forEach(([phrase, cls]) => {
        unique.set(String(phrase).toLowerCase(), { phrase: String(phrase), cls });
      });

      const phrases = Array.from(unique.values())
        .map(item => item.phrase)
        .sort((a, b) => b.length - a.length);

      if(!phrases.length) return escapeHTML(source);

      const re = new RegExp(phrases.map(escapeRegExp).join('|'), 'gi');
      let out = '';
      let lastIndex = 0;
      for(const match of source.matchAll(re)){
        const index = match.index || 0;
        if(index > lastIndex) out += escapeHTML(source.slice(lastIndex, index));
        const token = match[0];
        const cls = unique.get(token.toLowerCase())?.cls || 'good';
        out += `<span class="${cls}">${escapeHTML(token)}</span>`;
        lastIndex = index + token.length;
      }
      if(lastIndex < source.length) out += escapeHTML(source.slice(lastIndex));
      return out;
    }

    function getSharedHighlightMap(leftText, rightText, cls){
      const map = {};
      const leftTokens = new Set(getHighlightTokens(leftText).map(t => t.toLowerCase()));
      getHighlightTokens(rightText).forEach(token => {
        if(leftTokens.has(token.toLowerCase())) map[token] = cls;
      });
      return map;
    }

    // Acceptable shorthand naming conventions for explosive products.
    // Maps a normalized explosive name (lowercase, alphanumeric only) to the
    // set Name / ChargeRule tokens accepted as a green match for it, e.g.
    //   A10 = APEX 5020 (1.0)   A11G = APEX 5070 (1.1)   Inh A12 = APEX 2335 (1.2)
    const EXPLOSIVE_NAME_ALIASES = (() => {
      const entries = [
        ['APEX 5020 (1.0)', ['A10']],
        ['APEX 5030 (1.1)', ['A11']],
        ['APEX 5035 (1.2)', ['A12']],
        ['APEX 5070 (1.1)', ['A11G']],
        ['APEX 5070 (1.2)', ['A12G']],
        ['APEX 2320 (1.0)', ['A10', 'Inh']],
        ['APEX 2330 (1.1)', ['A11', 'Inh']],
        ['APEX 2335 (1.2)', ['A12', 'Inh']],
        ['APEX 2370 (1.1)', ['A11G', 'Inh']],
        ['APEX 2370 (1.2)', ['A12G', 'Inh']]
      ];
      const map = {};
      entries.forEach(([name, aliases]) => {
        map[String(name).toLowerCase().replace(/[^a-z0-9]+/g, '')] = aliases;
      });
      return map;
    })();

    function getExplosiveNameAliasTokens(explosiveName){
      const key = String(explosiveName || '').toLowerCase().replace(/[^a-z0-9]+/g, '');
      return EXPLOSIVE_NAME_ALIASES[key] || [];
    }

    // Highlight tokens in a ChargeRule/set Name that are accepted aliases for the explosive
    // (e.g. "A10" in a heading using APEX 5020 (1.0)), the same way shared tokens like
    // "S11" in "Spinifex S11" are highlighted green.
    function getExplosiveAliasHighlightMap(nameText, explosiveName, cls){
      const map = {};
      const aliasTokens = new Set(getExplosiveNameAliasTokens(explosiveName).map(t => String(t).toLowerCase()));
      if(!aliasTokens.size) return map;
      getHighlightTokens(nameText).forEach(token => {
        if(aliasTokens.has(token.toLowerCase())) map[token] = cls;
      });
      return map;
    }

    function isHeaderRow(row){
      let textCount=0,numCount=0;
      for(const cell of row){
        if(cell==null||String(cell).trim()==='') continue;
        const val=String(cell).trim();
        const n=Number(val.replace(/[\s,]/g,''));
        if(isFinite(n)&&val!=='') numCount++;
        else textCount++;
      }
      return textCount>numCount;
    }

    function colLetterToIdx(s){
      s = String(s||'').trim().toUpperCase();
      if(!s) return null;
      if(/^[A-Z]+$/.test(s)){
        let n=0;
        for(let i=0;i<s.length;i++){
          n=n*26+(s.charCodeAt(i)-64);
        }
        return n-1;
      }
      return null;
    }

    function parseNumber(v){
      if(v==null) return NaN;
      if(typeof v==='number') return v;
      const s = String(v).replace(/[\s,]/g,'');
      const n = Number(s);
      return isFinite(n)?n:NaN;
    }


// Round milliseconds consistently across CSV parsing, BLST parsing, conflict checking, exports and PPV.
function roundMs(v){
  const n = parseNumber(v);
  return Number.isFinite(n) ? Math.round(n) : NaN;
}

    function distance(a,b){
