      }
      if(window.csvAssignmentDiag.examples && window.csvAssignmentDiag.examples.csvOnly){
        out.csvUnmatchedInBlst = window.csvAssignmentDiag.examples.csvOnly.length;
        out.examples.csvUnmatchedInBlst = window.csvAssignmentDiag.examples.csvOnly.slice(0,50);
      }
      return out;
    }

    // Fallback: name-based diagnostics (legacy)
    const lookup = lookupByName;
    const blstNames = blstHoles.map(h=>String(h.name||'').trim()).filter(Boolean);
    const blstUnique = Array.from(new Set(blstNames));

    // Index BLST variants for reverse checks (CSV -> BLST)
    const blstVarIndex = {};
    blstUnique.forEach(nm=>{
      holeKeyVariants(nm).forEach(v=>{
        if(!blstVarIndex[v]) blstVarIndex[v] = [];
        if(!blstVarIndex[v].includes(nm)) blstVarIndex[v].push(nm);
