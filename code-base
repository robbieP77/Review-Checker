    // ---------- Map / view ----------

    let mapCanvas, mapCtx, animCanvas, animCtx, explosiveWeightCanvas, explosiveWeightCtx, columnLengthCanvas, columnLengthCtx, firingSequenceCanvas, firingSequenceCtx, mapCallReviewCanvas, mapCallReviewCtx, shortHoleCanvas, shortHoleCtx;

    function computeBounds(){
  // Use both CSV points and BLST holes if available so all maps share a consistent viewport.
  const sourcePoints = [];

  if (Array.isArray(pts) && pts.length) {
    for (const p of pts) {
      if (p && Number.isFinite(p.x) && Number.isFinite(p.y)) {
        sourcePoints.push({ x: p.x, y: p.y });
      }
    }
  }

  if (window.blstData && Array.isArray(window.blstData.holes) && window.blstData.holes.length) {
    for (const h of window.blstData.holes) {
      if (h && Number.isFinite(h.x) && Number.isFinite(h.y)) {
        sourcePoints.push({ x: h.x, y: h.y });
      }
    }
  }

  if (!sourcePoints.length) {
    bounds = null;
    return;
  }

  const xs = [];
  const ys = [];
  for (const p of sourcePoints) {
    if (!isFinite(p.x) || !isFinite(p.y)) continue;
    xs.push(p.x);
    ys.push(p.y);
  }

  if (!xs.length) {
    bounds = null;
    return;
  }

  function quantile(arr, q){
    const a = arr.slice().sort((a, b) => a - b);
    const pos = (a.length - 1) * q;
    const base = Math.floor(pos);
    const rest = pos - base;
    if (a[base + 1] === undefined) return a[base];
    return a[base] + rest * (a[base + 1] - a[base]);
  }

  const q1x = quantile(xs, 0.25), q3x = quantile(xs, 0.75);
  const q1y = quantile(ys, 0.25), q3y = quantile(ys, 0.75);
  const iqrX = (q3x - q1x) || 1;
  const iqrY = (q3y - q1y) || 1;

  const xLo = q1x - 5 * iqrX, xHi = q3x + 5 * iqrX;
  const yLo = q1y - 5 * iqrY, yHi = q3y + 5 * iqrY;

  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  let kept = 0;

  for (const p of sourcePoints) {
    if (!isFinite(p.x) || !isFinite(p.y)) continue;
    if (p.x < xLo || p.x > xHi || p.y < yLo || p.y > yHi) continue;
    kept++;
    if (p.x < minX) minX = p.x;
    if (p.x > maxX) maxX = p.x;
    if (p.y < minY) minY = p.y;
    if (p.y > maxY) maxY = p.y;
  }

  if (kept < Math.max(10, Math.floor(xs.length * 0.7))) {
    minX = Infinity; maxX = -Infinity; minY = Infinity; maxY = -Infinity;
    for (const p of sourcePoints) {
      if (!isFinite(p.x) || !isFinite(p.y)) continue;
      if (p.x < minX) minX = p.x;
      if (p.x > maxX) maxX = p.x;
      if (p.y < minY) minY = p.y;
      if (p.y > maxY) maxY = p.y;
    }
  }

  if (!isFinite(minX)) {
    bounds = null;
    return;
  }

  const marginX = (maxX - minX) || 1;
  const marginY = (maxY - minY) || 1;
  minX -= marginX * 0.08;
  maxX += marginX * 0.08;
  minY -= marginY * 0.08;
  maxY += marginY * 0.08;

  bounds = { minX, maxX, minY, maxY };
}

    function fitView(){
      if(!bounds){ view=null; return; }
      view={...bounds};
      resizeCanvases();
    }

    function fitMyMap() {
      computeBounds();   // reuse existing
      fitView();         // reuse existing
      drawMyMap();       // your new draw function
    }

    function resizeCanvasTo(containerId, canvas, aspect){
      const dpr = Math.max(1, window.devicePixelRatio || 1);
      const wrap = document.getElementById(containerId);
      let cssW = Math.max(600, wrap.clientWidth || 1100);

      const cssH = Math.max(260, Math.round(cssW / aspect));
      canvas.style.width = cssW + 'px';
      canvas.style.height = cssH + 'px';
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      const ctx = canvas.getContext('2d');
      ctx.setTransform(dpr,0,0,dpr,0,0);
    }

    function resizeCanvases(){
      const aspect = (((view && view.maxX != null) ? view.maxX : 1) - ((view && view.minX != null) ? view.minX : 0)) / ((((view && view.maxY != null) ? view.maxY : 1) - ((view && view.minY != null) ? view.minY : 0)) || 1);
      // Ensure the long-hole map canvas is resized as well
      resizeCanvasTo('myNewMapWrap', myMapCanvas, aspect || 2.5);
      resizeCanvasTo('shortHoleMapWrap', shortHoleCanvas, aspect || 2.5);
      resizeCanvasTo('mapWrap', mapCanvas, aspect || 2.5);
      resizeCanvasTo('mapCallReviewMapWrap', mapCallReviewCanvas, aspect || 2.5);
      resizeCanvasTo('animWrap', animCanvas, aspect || 2.5);
      resizeCanvasTo('explosiveWeightMapWrap', explosiveWeightCanvas, aspect || 2.5);
      resizeCanvasTo('columnLengthMapWrap', columnLengthCanvas, aspect || 2.5);
      resizeCanvasTo('sdobMapWrap', sdobCanvas, aspect || 2.5);
      resizeCanvasTo('firingSequenceMapWrap', firingSequenceCanvas, aspect || 2.5);

    }

    function worldToScreen(x,y,canvas){
      if(!view) return [0,0];
      const {minX,maxX,minY,maxY}=view;
      const w = canvas.width / (window.devicePixelRatio||1);
      const h = canvas.height / (window.devicePixelRatio||1);
      const sx = (x-minX)/(maxX-minX||1)*w;
      const sy = h - (y-minY)/(maxY-minY||1)*h;
      return [sx,sy];
    }

    function screenToWorld(sx,sy,canvas){
      if(!view) return [0,0];
      const {minX,maxX,minY,maxY}=view;
      const w = canvas.width / (window.devicePixelRatio||1);
      const h = canvas.height / (window.devicePixelRatio||1);
      const x = minX + (sx/w)*(maxX-minX);
      const y = minY + ((h-sy)/h)*(maxY-minY);
      return [x,y];
    }

    function drawGrid(ctx,canvas){
      if(!view) return;
      const {minX,maxX,minY,maxY}=view;
      const w = canvas.width / (window.devicePixelRatio||1);
      const h = canvas.height / (window.devicePixelRatio||1);
      ctx.save();
      ctx.clearRect(0,0,w,h);
      ctx.beginPath();
      const step = Math.pow(10, Math.floor(Math.log10((maxX-minX)/8 || 1)));
      for(let gx=Math.ceil(minX/step)*step; gx<=maxX; gx+=step){
        const [sx1,sy1] = worldToScreen(gx,minY,canvas);
        const [sx2,sy2] = worldToScreen(gx,maxY,canvas);
        ctx.moveTo(sx1,sy1); ctx.lineTo(sx2,sy2);
      }
      for(let gy=Math.ceil(minY/step)*step; gy<=maxY; gy+=step){
        const [sx1,sy1] = worldToScreen(minX,gy,canvas);
        const [sx2,sy2] = worldToScreen(maxX,gy,canvas);
        ctx.moveTo(sx1,sy1); ctx.lineTo(sx2,sy2);
      }
      ctx.strokeStyle='rgba(148,163,184,0.15)';
      ctx.lineWidth=1;
      ctx.stroke();
      ctx.restore();
    }

    function drawMap(){
      if(!view || !pts.length){
        mapCtx.clearRect(0,0,mapCanvas.width,mapCanvas.height);
        return;
      }
      const w = mapCanvas.width / (window.devicePixelRatio||1);
      const h = mapCanvas.height / (window.devicePixelRatio||1);
      mapCtx.clearRect(0,0,w,h);
      drawGrid(mapCtx,mapCanvas);

      if(showLinks){
        mapCtx.lineWidth=2;
        mapCtx.strokeStyle='rgba(239,68,68,0.8)';
        for(const c of conflicts){
          const a=pts[c.i], b=pts[c.j]; if(!a||!b) continue;
          const [x1,y1]=worldToScreen(a.x,a.y,mapCanvas);
          const [x2,y2]=worldToScreen(b.x,b.y,mapCanvas);
          mapCtx.beginPath();
          mapCtx.moveTo(x1,y1);
          mapCtx.lineTo(x2,y2);
          mapCtx.stroke();
        }
      }

      mapCtx.font = '12px ui-monospace, Menlo, Consolas, monospace';
      mapCtx.textAlign='center';
      mapCtx.textBaseline='bottom';

      // NTBC holes
      for(let i=0;i<pts.length;i++){
        const p=pts[i];
        if(p.hasPrimer) continue;
        const [sx,sy] = worldToScreen(p.x,p.y,mapCanvas);
        mapCtx.beginPath();
        mapCtx.arc(sx,sy,4,0,Math.PI*2);
        mapCtx.fillStyle='rgba(148,163,184,0.4)';
        mapCtx.fill();
      }

      // timed holes
      for(let i=0;i<pts.length;i++){
        const p=pts[i];
        if(!p.hasPrimer) continue;
        const [sx,sy] = worldToScreen(p.x,p.y,mapCanvas);
        const inConflict = conflictNodes.has(i);
        mapCtx.beginPath();
        mapCtx.arc(sx,sy,4,0,Math.PI*2);
        mapCtx.fillStyle = inConflict ? '#ef4444' : '#38bdf8';
        mapCtx.fill();
        if(inConflict && showHoleLabels){
          mapCtx.fillStyle=getThemeCssVar('--map-label-text', '#cbd5e1');
          mapCtx.fillText(p.hole,sx,sy-6);
        }
      }
      drawMapCallReviewMap();
    }

