  // 2) POIs from LineGeometryNode polygons (commonly used for sensitive sites).
  // We treat any LineGeometryNode with Polys as a POI candidate if it has a name.
  Object.keys(polysById).forEach(k=>{
    const id = parseInt(k,10);
    const typ = typeById[id] || "";
    if(typ !== "LineGeometryNode") return;

    const nm = nameById[id];
    if(!nm) return;

    // Representative location = mean of referenced poly centroids (if available).
    const polyIds = polysById[id] || [];
    const centroids = polyIds.map(pid=>polyCentroid[pid]).filter(Boolean);
    if(!centroids.length) return;

    let sx=0, sz=0;
    centroids.forEach(c=>{sx+=c.x; sz+=c.z;});
    const cx = sx/centroids.length;
    const cz = sz/centroids.length;

    // Apply world translation of the LineGeometryNode chain as well (usually zero, but safe).
    const tw = resolveTranslationWorld(id);
    const xy = applyBlastOriginShift(cx + tw.x, cz + tw.z);

    // Enabled: keep visible/green rules; itemType==3 often indicates "sensitive site".
    const col = colourById[id] || null;
    const vis = (id in visibleById) ? visibleById[id] : null;
    const itemType = (id in itemTypeById) ? itemTypeById[id] : null;

    let enabled = false;
    if(vis === true) enabled = true;
    if(col && col[1] >= 200 && col[1] >= col[0] && col[1] >= col[2]) enabled = true;
    if(itemType === 3) enabled = true;

    points.push({
      id,
      kind: "POI",
      name: nm,
      x: xy.X,
      y: xy.Y,
      elevation: ((trById[id] && trById[id].y != null) ? trById[id].y : 0) + ((trById[parentById[id]] && trById[parentById[id]].y != null) ? trById[parentById[id]].y : 0),
      colour: col,
      visible: vis,
      enabled,
      ppvMax_mps: null,
      notes: notesById[id] || ""
    });
  });

  // stable ordering: enabled first, then name, then kind
  points.sort((a,b)=>{
    const ea = a.enabled ? 0 : 1;
    const eb = b.enabled ? 0 : 1;
    if(ea !== eb) return ea - eb;
    const nk = a.name.localeCompare(b.name);
    if(nk !== 0) return nk;
    return String(a.kind).localeCompare(String(b.kind));
  });

  return points;
}

    function parseBLSTFull(text){
      const aoa = parseBLST(text);

      // BlastOrigin for local coordinate conversion
      const boMatch = text.match(/set\s+BlastOrigin\s*\(\s*([-\d.]+)\s*,\s*([-\d.]+)\s*,\s*([-\d.]+)\s*\)/);
      const blastOrigin = boMatch ? {
