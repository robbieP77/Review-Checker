    // This is an approximation for convenience; it is not derived from Paradigm.
    let _autoSuggestRunning = false;
    function autoSuggestAdjustedTimes(tol){
      if(!Array.isArray(window.pts) || !window.pts.length) return;
      if(!window.adjustments) window.adjustments = new Map();
      const step = Math.max(1, Math.round(tol) + 1);

      const timedIdx = window.pts
        .map((p,idx)=>({p,idx}))
        .filter(o=>Number.isFinite(currentTimeConflict(o.p)));

      if(!timedIdx.length) return;

      // Precompute spatial neighbors within the effective distance limit.
      const neigh = new Map(); // idx -> array of neighbor idx
      for(let a=0;a<timedIdx.length;a++){
        const i = timedIdx[a].idx;
        const pi = timedIdx[a].p;
        for(let b=a+1;b<timedIdx.length;b++){
          const j = timedIdx[b].idx;
          const pj = timedIdx[b].p;
          const dist = distance(pi, pj);
          const within =
            (Number.isFinite(pi.glimit) && dist <= pi.glimit) ||
            (Number.isFinite(pj.glimit) && dist <= pj.glimit);
          if (!within) continue;
          if(!neigh.has(i)) neigh.set(i, []);
          if(!neigh.has(j)) neigh.set(j, []);
          neigh.get(i).push(j);
          neigh.get(j).push(i);
        }
      }

      // Sort by base (CSV) time.
      timedIdx.sort((a,b)=>{
        const ta = currentTimeConflict(a.p);
        const tb = currentTimeConflict(b.p);
        if(ta !== tb) return ta - tb;
        return a.idx - b.idx;
      });

      const assigned = new Map(); // idx -> adjusted time
      for(const o of timedIdx){
        const p = o.p;
        const i = o.idx;

        // Do not overwrite a user-entered adjustment.
        if(p.adjSource === 'user'){
          assigned.set(i, Math.round(p.adj));
          continue;
        }

        let t = currentTimeConflict(p);
        if(!Number.isFinite(t)) continue;
        t = Math.round(t);

        // Shift forward until no conflicts with already assigned neighbors.
        const nb = neigh.get(i) || [];
        let guard = 0;
        while(guard++ < 10000){
          let bad = false;
          for(const j of nb){
            if(!assigned.has(j)) continue;
            const tj = assigned.get(j);
            if(Math.abs(t - tj) <= tol){
              bad = true;
              break;
            }
          }
          if(!bad) break;
          t += step;
        }

        p.adj = t;
        p.adjSource = 'auto';
        window.adjustments.set(p.hole, t);
        assigned.set(i, t);
      }
    }

