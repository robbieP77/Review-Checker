    : `BLST unique names: ${diag.blstUniqueNameCount}; CSV unique names: ${diag.csvUniqueNameCount}; matched: ${diag.matched}; ambiguous: ${diag.ambiguous}; missing in CSV: ${diag.missingInCsv}; CSV not found in BLST: ${diag.csvUnmatchedInBlst}.`;

